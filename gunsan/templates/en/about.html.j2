  <h2 id="h-sos" class="rail-label">{{ S.h }}</h2>
  <div class="rail-body prose">
    <p>{{ S.lead }}</p>
    <ul class="sos">
      {% for x in em.lines %}<li><a class="sos-tel tn" href="tel:{{ x.tel }}" data-track="tel_click">{{ x.tel }}</a><span class="sos-what">{{ S[x.what] }}{% if x.abroad %} · {{ S.abroad }} <a href="tel:{{ x.abroad }}" data-track="tel_click">{{ x.abroad }}</a>{% endif %}</span></li>{% endfor %}
    </ul>
    {% for s in em.steps %}<p>{{ S[s.id] }}</p>{% endfor %}
    {% set sos_links %}{% for k, s in em.sources.items() %}<a href="{{ s.url }}" rel="noopener"{% if loc.html != 'en' %} hreflang="en"{% endif %} data-track="official_click">{{ S[k] }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endset %}
