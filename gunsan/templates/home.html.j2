{% extends "base.html.j2" %}
{% import "_p2.html.j2" as p2 %}
{% import "_media.html.j2" as md %}
{% import "_art.html.j2" as artm %}
{% import "_ask.html.j2" as askm %}
{% import "_pic.html.j2" as pk %}
{% import "_abroad.html.j2" as ab %}
{% import "_blog.html.j2" as blm %}
{% import "_side.html.j2" as sdm %}
{% import "_mz.html.j2" as mz %}
{% import "_related_sites.html.j2" as relm %}
{% import "_share.html.j2" as shm %}
{#- The home page. UI4 (owner 2026-10-14, after the AIO2O proposal demo for KT Skylife — its design language only;
    docs/handover/specs/ui4_mapping.md, skyref_study.md, home_redesign.md): a LIGHT opening — a soft sea-blue gradient,
    at the left the eyebrow pill (h.opening.kicker), the H1, one plain lede, the two pill buttons (내 일정 만들기 ·
    <city> 추천 코스) and the three situational entries (h.starts), the slide controls (pause · ‹ n/N › · progress,
    '소식 전체'), at the right one big rounded card per news item (present.home_news: its real TourAPI photo,
    credited under it — KOGL-3 whole on a tinted frame, never cropped — or the outlet's own preview image, or its
    illustration; its chip, title and date), one at a time: a native scroll-snap row that works without JS, site.js
    [data-hcar] advances it every 6 s (never with reduced motion; it stops for hover, focus, a hidden tab, a swipe and
    the pause button). Then the white card overlapping the opening's
    bottom edge: the AI assistant (_ask.html.j2 box, owner 2026-10-14 '페이지 상단에는 검색, 중앙 부분에는 AI챗봇': its
    head, one question box with one button '물어보기', without JS the form searches; the site search itself is in the
    header), the recommended questions (ask.json) as '#' tags, and the 3D icon menu (present.home_services, pictures
    by ID through _pic.html.j2). The conversation opens right under the card (askm.panel, chat.js dock mode). Below: 목적별 가이드 → 대표 장소 → 다가오는 행사
    → 다섯 여행 권역 → 군산 이야기 (light now) → 섬 갤러리 → 공식 코스 → 영상 → 공식 안내, restyled with the
    reference's parts (css/46-home-open.css). Every figure comes from present.home_vm (h) or the list counts; a section
    whose data is missing is left out. Nothing on the first screen starts hidden.
    Phones (< 768px; operator 2026-10-15, after an outside mobile UX review — css/46-home-open.css 5.): the first screen
    (360x800, 390x844) holds the header, the kicker, the H1, the lede, the two buttons (.ho-cta, one row under the
    lede) and the three entries (.ho-go, one row), ONE compact news card — an 88px frame at the left (KOGL-1 fills it;
    KOGL-3 and the outlet's preview image whole on its tint, never cropped; the square illustration whole), the
    chip/status, the title (two lines), the date · venue (one line), the photo credit under both — with its controls
    (44px), and the whole question box with its '#' tags. The row does not turn by itself there (site.js: stopped on the first card until the reader acts; the
    play button starts it); from 768px it turns every 6 s as before. The floating launcher steps aside below 1024px
    while the question box is on screen (body.has-ask, css/49-chat.css, site.js html.ask-out). The icon menu leads
    with the core four (present.home_services core: 가볼만한 곳 · 맛집 · 숙소 · 가는 법) — one row of four tiles on
    phones, the other five as chips that wrap under them; one row of all nine from 1024px. -#}
{#- the news card's picture: the big card from 768px; below it the compact card's 88px thumbnail (css/46-home-open.css)
    — so the first slide is preloaded only where it is big (SLIDE_MEDIA): on a phone it is a small eager image and the
    opening's cover photo keeps the bandwidth -#}
{% set SLIDE_SIZES = '(min-width: 1200px) calc(50vw - 160px), (min-width: 1024px) 640px, (min-width: 768px) calc(100vw - 32px), 88px' %}
{% set SLIDE_MEDIA = '(min-width: 768px)' %}
{#- reel_preview(reel, sizes, eager, cls): 군산각's own reel as a still — its cover cut to the fireworks frame (local AVIF/WebP,
    events.json home_reel.cover) under a play button. A link to the reel (new tab) that, with JS, opens the dialog below
    with the service's official embed instead (site.js [data-reel-open]); nothing loads from Instagram before. -#}
{% macro reel_preview(reel, sizes, eager=false, cls='') -%}
<a class="{{ cls }} rp" href="{{ reel.url }}" target="_blank" rel="noopener" data-reel-open data-track="fest_reel_click" aria-label="{{ reel.label }} 불꽃축제 영상 재생 (새 창)"><picture><source type="image/avif" srcset="{% for w in reel.cover.widths %}{{ reel.cover.src }}-{{ w }}.avif {{ w }}w{{ ', ' if not loop.last }}{% endfor %}" sizes="{{ sizes }}"><img class="rp-img" src="{{ reel.cover.src }}-720.webp" srcset="{% for w in reel.cover.widths %}{{ reel.cover.src }}-{{ w }}.webp {{ w }}w{{ ', ' if not loop.last }}{% endfor %}" sizes="{{ sizes }}" width="{{ reel.cover.w }}" height="{{ reel.cover.h }}" alt="{{ reel.cover.alt }}" loading="{{ 'eager' if eager else 'lazy' }}" decoding="async"{% if eager %} fetchpriority="high"{% endif %}></picture><span class="rp-btn" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span><span class="rp-tag" aria-hidden="true">{{ ab.svc('instagram') }}릴스 재생</span></a>
{%- endmacro %}
{% block bodyclass %}pg-home pg-ko-home pg-h4{% if ask_starters is defined and ask_starters is not none %} has-ask{% endif %}{% endblock %}
{% block main_class %}{% endblock %}
{#- 시안 A with the opening photo (operator 2026-11-05 '흰색 배경 말고, 고군산군도 고화질 사진을 배경으로'): the card's
    KOGL-1 photo is the first screen's LCP candidate, a local AVIF derivative, preloaded -#}
{% block head %}{% if h.cover and h.cover.type == 1 and h.cover.avif %}{{ md.preload(h.cover, '(min-width: 1200px) calc(100vw - 360px), 100vw') }}{% endif %}{% endblock %}
{% block content %}
{% set T = namespace(i=0) %}
{% set N = h.news|length %}
{% set ASK = ask_starters is defined and ask_starters is not none %}
{#- IG: the guide whose #h-insta chapter the Instagram cards open in ('' when this build does not publish it: then no
    Instagram tab, list or section — they would only link to a page that is not there) -#}
{% set IG = insta_guide|default('') %}
{#- the board (from 1680px, css/48-abroad.css): a YouTube panel and an Instagram panel behind two tabs — each panel
    whole in its own <div> whatever data is there (2026-11-10: the first panel was opened by one condition and closed
    by another, so a build without curated videos or without the Instagram guide left the markup unbalanced). It
    carries the ranks on a wide window (operator 2026-11-10 '순위별로 큐레이션해서 굉장히 잘 보이는 곳에'): each
    panel opens with its ranked list — the videos by views with the rank on the picture, the posts by likes — then
    the channels; the rank block in the column (.hrk, below) shows the list of the tab that is not open, and both
    lists where there is no board. -#}
{% set RS_YT = has_videos and (popular_videos or yt_channels) %}
{% set RS_IG = IG and (insta_channels or home_insta) %}
{% if RS_YT or RS_IG %}
<aside class="h-rside" aria-label="{{ site.region }} 인기 유튜브·인스타그램 큐레이션" data-lenis-prevent{% if RS_YT and RS_IG %} data-tabs{% endif %}>
  <div class="hrs-head">
    <h2 class="hrs-title">지금 많이 보는 {{ site.region }}</h2>
    {% if RS_YT and RS_IG %}<div class="hrs-tabs" role="tablist" aria-label="유튜브·인스타그램 전환">
      <button type="button" class="hrs-tab is-yt" role="tab" id="hrs-tab-yt" aria-controls="hrs-panel-yt" aria-selected="true">{{ ab.svc('youtube') }}<span>유튜브</span></button>
      <button type="button" class="hrs-tab is-ig" role="tab" id="hrs-tab-ig" aria-controls="hrs-panel-ig" aria-selected="false" tabindex="-1">{{ ab.svc('instagram') }}<span>인스타그램</span></button>
    </div>{% endif %}
  </div>
  {% if RS_YT %}
  <div class="hrs-panel"{% if RS_IG %} role="tabpanel" aria-labelledby="hrs-tab-yt"{% endif %} id="hrs-panel-yt">
  {% if popular_videos %}
  <div class="hrs-sec" id="hrs-yt">
    <div class="hrs-sh"><h3>화제의 {{ site.region }} 유튜브 <em class="hrs-by">조회수 순</em></h3><a href="/videos/#yt-popular">전체 보기<span class="arr" aria-hidden="true">→</span></a></div>
    <ul class="hrs-vlist">
      {% for v in popular_videos[:5] %}
      {% set t = v.thumbnail or {} %}
      <li class="hrs-v">
        <a class="hrs-va" href="{{ v.url }}" target="_blank" rel="noopener" data-track="video_click">
          <span class="hrs-vth">{% if t.url %}<img src="{{ t.url }}" width="116" height="65" alt="" loading="lazy" decoding="async">{% endif %}<span class="hrs-rk tn">{{ loop.index }}<span class="vh">위 </span></span><span class="hrs-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="11" height="11"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span></span><span class="hrs-vtxt"><span class="hrs-vtop"><b class="hrs-vch">{{ v.channel }}</b>{% if v.short_view_text or v.view_text %}<span class="hrs-vviews tn">{{ (v.short_view_text or v.view_text)|replace('조회수 ', '') }}</span>{% endif %}</span><span class="hrs-vt">{{ v.title }}</span></span>





        </a>
        {% if v._places %}<p class="hrs-vp">{% for x in v._places[:3] %}<a href="{{ x._path }}">{{ x.name }}</a>{% endfor %}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
    <p class="hrs-note">고른 영상 {{ n_popular|default(popular_videos|length) }}편 안의 조회수 순 · 추천 순서가 아님 · 숫자는 실은 때의 값</p>
  </div>
  {% endif %}
  {% if yt_channels %}
  <div class="hrs-sec">
    <div class="hrs-sh"><h3>인기 유튜브 채널 <span class="tn">{{ yt_channels|length }}</span></h3><a href="/videos/#yt-channels">모두 보기<span class="arr" aria-hidden="true">→</span></a></div>
    <ul class="hrs-clist">
      {% for ch in yt_channels %}
      <li class="hrs-c">
        <a class="hrs-ctop" href="{{ ch.url }}" target="_blank" rel="noopener" data-track="video_click"><span class="hrs-num tn">{{ '%02d'|format(loop.index) }}</span><span class="hrs-cn"><span class="hrs-crow"><strong class="hrs-cname">{{ ch.name }}<span class="hrs-ext" aria-hidden="true">↗</span></strong>{% if ch.badge %}<em class="hrs-badge">{{ ch.badge }}</em>{% endif %}</span><span class="hrs-csub">{{ ch.handle }}</span></span></a>
        {% if ch.links %}<p class="hrs-clinks">{% for l in ch.links[:3] %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  </div>
  {% endif %}
  {% if RS_IG %}
  <div class="hrs-panel"{% if RS_YT %} role="tabpanel" aria-labelledby="hrs-tab-ig" data-tab-off{% endif %} id="hrs-panel-ig">
  {% if home_insta %}
  <div class="hrs-sec">
    <div class="hrs-sh"><h3>화제의 인스타 대형·감성 카페 <em class="hrs-by">좋아요 순</em></h3><a href="{{ IG }}#h-insta">전체 {{ n_insta }}편<span class="arr" aria-hidden="true">→</span></a></div>
    <ul class="hrs-clist">
      {% for a in home_insta[:5] %}
      <li class="hrs-c">
        <a class="hrs-ctop" href="{{ IG }}#{{ a.id }}" data-track="abroad_click"><span class="hrs-num tn">{{ '%02d'|format(loop.index) }}</span><span class="hrs-cn"><span class="hrs-crow"><strong class="hrs-cname">{{ a.author or 'Instagram' }}<span class="hrs-ext" aria-hidden="true">›</span></strong>{% if a.likes %}<span class="hrs-vviews tn">좋아요 {{ '{:,}'.format(a.likes|int) }}</span>{% endif %}</span><span class="hrs-ig-note">{{ a.note }}</span></span></a>
        {% if a.place_slugs %}<p class="hrs-clinks">{% for s in a.place_slugs[:3] %}{% if s in places %}<a href="{{ places[s]._path }}">{{ places[s].name }}</a>{% endif %}{% endfor %}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
    <p class="hrs-note">고른 카페 게시물 {{ n_insta }}편 안의 좋아요 순 · 추천 순서가 아님 · 숫자는 실은 때의 값</p>
  </div>
  {% endif %}
  {% if insta_channels %}
  <div class="hrs-sec" id="hrs-ig">
    <div class="hrs-sh"><h3>인기 인스타 채널 <span class="tn">{{ insta_channels|length }}</span></h3><a href="{{ IG }}#h-insta">카페 가이드<span class="arr" aria-hidden="true">→</span></a></div>
    <ul class="hrs-clist">
      {% for ch in insta_channels %}
      <li class="hrs-c">
        <a class="hrs-ctop" href="{{ ch.url }}" target="_blank" rel="noopener" data-track="abroad_click"><span class="hrs-num tn">{{ '%02d'|format(loop.index) }}</span><span class="hrs-cn"><span class="hrs-crow"><strong class="hrs-cname">{{ ch.name }}<span class="hrs-ext" aria-hidden="true">↗</span></strong>{% if ch.badge %}<em class="hrs-badge">{{ ch.badge }}</em>{% endif %}</span><span class="hrs-csub">{{ ch.handle }}</span></span></a>
        {% if ch.links %}<p class="hrs-clinks">{% for l in ch.links[:3] %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  </div>
  {% endif %}
</aside>
{% endif %}
<div class="hk"{% if ASK %} data-chat-dock{% endif %}>
{#- 시안 A (operator 2026-11-05 'A로 가되 … 첫 화면 군산 여행의 모든 것은 가운데 정렬'; css/87-design-a.css): a white
    card in the middle — the H1 with '모든 것' in the sea blue, the lede, the site search (the header's on phones, the
    side panel's from 1024px, here big), the four core lists with their pictures (no counts, operator 2026-11-05), 숙박 예약하기 and 내 일정
    만들기. Under it the pinned fireworks edition as a wide banner (its reel's still, the D-day recounted in the browser,
    day · time · place, the reel in the dialog below) and the series' guides as three cards; the news row, the
    assistant and the rest follow. Nothing starts hidden; the H1 is the first screen's largest text. -#}
{% set TILES = [('/places/', '관광지', 'a'), ('/food/', '음식점', 'f'), ('/stays/', '숙소', 's'), ('/courses/', '코스', 'c')] %}
{% set cv = h.cover if h.cover and h.cover.type == 1 and h.cover.avif else none %}
<section class="ha" aria-labelledby="h-home">
  <div class="wrap"><div class="ha-card{{ ' ha-ph' if cv }}">
    {% if cv %}<div class="ha-bg" aria-hidden="true">{{ md.picture(cv, '(min-width: 1200px) calc(100vw - 360px), 100vw', true, 'ha-bg-img', false, true) }}</div>{% endif %}
    <h1 id="h-home" class="op-h1 ha-h1">{{ site.region }} 여행의 <span class="ha-em">모든 것</span></h1>
    <p class="ha-lede">관광지·음식점·숙소의 여는 시간과 요금, 가는 길을 한곳에 모았습니다.</p>
    <form class="ha-search" action="/search/" method="get" role="search">
      <label class="vh" for="ha-q">장소·음식·지역 검색</label>
      {{ ui.icon('search', 'icon ha-s-ic') }}
      <input id="ha-q" name="q" type="search" placeholder="짬뽕, 이성당처럼 찾아보세요" autocomplete="off" enterkeyhint="search">
      <button type="submit">검색</button>
    </form>
    {% set svc = {} %}{% for s in h.services %}{% set _ = svc.update({s.href: s}) %}{% endfor %}
    <ul class="ha-tiles">{% for href, lab, k in TILES %}{% set s = svc.get(href) %}{% if s %}<li><a class="ha-tile ha-{{ k }}" href="{{ href }}"{% if s.track %} data-track="{{ s.track }}"{% endif %}>{{ pk.pic(s.pic, s.icon, 52) }}<span class="ha-tl">{{ lab }}</span></a></li>{% endif %}{% endfor %}</ul>
    <p class="ha-cta">{% if stay_book_n %}<a class="ha-btn ha-stay" href="/stays/booking/" data-track="stay_booking_cta">{{ pk.pic('icon-stay', 'bed', 28) }}<span>숙박 예약하기</span></a>{% endif %}{% if has_plan %}<a class="ha-btn ha-plan" href="/plan/" data-track="plan_cta">AI 코스 만들기</a>{% elif courses %}<a class="ha-btn ha-plan" href="/courses/" data-track="course_click">{{ site.locality or site.region }} 추천 코스</a>{% endif %}</p>
    {% if cv %}<p class="ha-cap">사진 <a href="{{ cv.path }}">{{ cv.place }}</a> · {{ md.credit(cv) }}</p>{% endif %}
  </div></div>
</section>
{% if h.fest %}{% set F = h.fest %}
<section class="ha-fest" aria-labelledby="h-fw">
  <div class="wrap">
    <div class="haf">
      {% if F.reel.cover %}<picture class="haf-bg" aria-hidden="true"><source type="image/avif" srcset="{% for w in F.reel.cover.widths %}{{ F.reel.cover.src }}-{{ w }}.avif {{ w }}w{{ ', ' if not loop.last }}{% endfor %}" sizes="(min-width: 1024px) 70vw, 100vw"><img src="{{ F.reel.cover.src }}-720.webp" srcset="{% for w in F.reel.cover.widths %}{{ F.reel.cover.src }}-{{ w }}.webp {{ w }}w{{ ', ' if not loop.last }}{% endfor %}" sizes="(min-width: 1024px) 70vw, 100vw" width="{{ F.reel.cover.w }}" height="{{ F.reel.cover.h }}" alt="" loading="lazy" decoding="async"></picture>{% endif %}
      <div class="haf-t">
        <p class="haf-dd"><b class="tn" data-dday="{{ F.r.start }}" data-dday-end="{{ F.r.last }}">{% if F.r.days > 0 %}D-{{ F.r.days }}{% elif F.r.days == 0 %}D-DAY{% else %}진행 중{% endif %}</b></p>
        <h2 id="h-fw" class="haf-h">{{ F.h }}</h2>
        <p class="haf-m"><time datetime="{{ F.start_dt }}">{{ F.when }}{% if F.time %} {{ F.time }}{% endif %}</time>{% if F.r.place %}<br>{{ F.r.place }}{% endif %}</p>
        <p class="haf-cta">{% if F.r.path %}<a class="haf-btn" href="{{ F.r.path }}" data-track="fest_click">행사 정보 보기</a>{% endif %}{% if F.reel.cover %}<a class="haf-btn haf-play" href="{{ F.reel.url }}" target="_blank" rel="noopener" data-reel-open data-track="fest_reel_click" aria-label="{{ F.reel.label }} 불꽃축제 영상 재생 (새 창)"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor"/></svg>릴스 보기</a>{% endif %}</p>
        <p class="haf-cr">영상: {{ F.reel.label }} @{{ F.reel.account }} · 불꽃 장면은 자료화면{% if F.src %} · 출처: {{ F.src }}{% endif %}</p>
      </div>
    </div>
    {% if F.series %}<ul class="ha-guides">{% for x in F.series %}<li><a href="{{ x.path }}" data-track="guide_click"><span class="hag-k{{ ' hag-new' if x.new }}">{{ '새 가이드' if x.new else '불꽃축제 시리즈' }}</span><b class="hag-t">{{ x.label }}</b><span class="hag-q">{{ x.q }}</span></a></li>{% endfor %}</ul>{% endif %}
  </div>
</section>
{% endif %}
{#- 유튜브·인스타그램 인기 순위 (operator 2026-11-10 '유튜브, 인스타도 순위별로 큐레이션해서 굉장히 잘 보이는 곳에'): right
    under the opening — after the festival card while there is one — the curated videos by their view counts and the
    curated Instagram posts by their likes, five each with the rank (three while one column), then the doors to the whole
    lists and the channels (css/47-rank.css). The order is a stated rule, not a recommendation (CLAUDE.md 3.10):
    the note says so and that the counts are those of the day the lists were made (the day itself stays in the
    data — operator 2026-10-09, validate.visible_check_dates). A video's row goes to YouTube; a post's row to its card in
    the cafe guide, where the official embed is. An Instagram row's small picture is a licensed photo of a place the
    post shows (KOGL-1 cut to the box, KOGL-3 whole), never the post's own; without one the row shows the service's
    mark. The home's own YouTube row and Instagram section are this block now. From 1680px the board beside the
    column shows one of the two lists all the time, behind its tabs: there the block shows the other one — the
    Instagram ranks while the board is on YouTube, and the reverse — five cards across (css/47-rank.css; the
    .hrk-w-yt / .hrk-w-ig parts are what steps out). So both lists are on the screen and neither twice (operator
    2026-11-10: on a wide window 'the way you find reasonable'). Without the tabs (no script) the board shows both
    lists and the block steps out. -#}
{% set RK_YT = popular_videos[:5] if has_videos else [] %}
{% set RK_IG = home_insta[:5] if IG else [] %}
{% if RK_YT or RK_IG %}
{% set rk_types = [] %}{% for a in RK_IG if a.photo and not a.related and a.photo.type not in rk_types %}{% set _ = rk_types.append(a.photo.type) %}{% endfor %}
<section class="hrk" aria-labelledby="h-rank">
  <div class="wrap"><div class="hrk-card">
    <div class="hrk-head"><h2 id="h-rank" class="hrk-h">{% if RK_YT %}<span class="hrk-w-yt">유튜브</span>{% endif %}{% if RK_YT and RK_IG %}<span class="hrk-w-dot">·</span>{% endif %}{% if RK_IG %}<span class="hrk-w-ig">인스타그램</span>{% endif %} 인기 순위</h2><p class="hrk-sub">{{ site.site_name|josa('이/가') }} 고른 {% if RK_YT %}<span class="hrk-w-yt">영상 <span class="tn">{{ n_popular|default(popular_videos|length) }}</span>편</span>{% endif %}{% if RK_YT and RK_IG %}<span class="hrk-w-dot">·</span>{% endif %}{% if RK_IG %}<span class="hrk-w-ig">카페 게시물 <span class="tn">{{ n_insta }}</span>편</span>{% endif %} 가운데</p></div>
    <div class="hrk-cols{{ ' hrk-one' if not (RK_YT and RK_IG) }}">
      {% if RK_YT %}
      <div class="hrk-col hrk-w-yt">
        <div class="hrk-sh"><h3>{{ ab.svc('youtube', 'ab-svc hrk-svc') }}<span>유튜브</span><em>조회수 순</em></h3><a href="/videos/#yt-popular">{{ n_popular|default(popular_videos|length) }}편 모두<span class="arr" aria-hidden="true">›</span></a></div>
        <ol class="hrk-list" role="list">
          {% for v in RK_YT %}{% set t = v.thumbnail or {} %}
          <li class="hrk-i{{ ' hrk-x' if loop.index > 3 }}">
            <a class="hrk-a" href="{{ v.url }}" target="_blank" rel="noopener" data-track="video_click">
              <span class="hrk-n tn">{{ loop.index }}<span class="vh">위</span></span>
              <span class="hrk-th">{% if t.url %}<img src="{{ t.url }}"{% if t.width and t.height %} width="{{ t.width }}" height="{{ t.height }}"{% endif %} alt="" loading="lazy" decoding="async">{% endif %}<span class="hrk-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="11" height="11"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span></span>
              <span class="hrk-tx"><span class="hrk-top"><b class="hrk-who">{{ v.channel }}</b>{% if v.short_view_text or v.view_text %}<span class="hrk-cnt tn">{{ v.short_view_text or v.view_text }}</span>{% endif %}</span><span class="hrk-t">{{ v.title }}</span><span class="vh"> (YouTube, 새 창)</span></span>
            </a>
            {% if v._places %}<p class="hrk-pl">{% for x in v._places[:3] %}<a href="{{ x._path }}">{{ x.name }}</a>{% endfor %}</p>{% endif %}
          </li>
          {% endfor %}
        </ol>
        <p class="hrk-doors">{% if yt_channels %}<a href="/videos/#yt-channels"><span>인기 채널 <span class="tn">{{ yt_channels|length }}</span>곳</span><span class="arr" aria-hidden="true">›</span></a>{% endif %}<a href="/videos/"><span>주제별 영상 <span class="tn">{{ h.n_videos }}</span>편</span><span class="arr" aria-hidden="true">›</span></a></p>
      </div>
      {% endif %}
      {% if RK_IG %}
      {% set own_ch = insta_channels|selectattr('id', 'equalto', 'ig-ch-gunsangak')|first if insta_channels else none %}
      <div class="hrk-col hrk-w-ig">
        <div class="hrk-sh"><h3>{{ ab.svc('instagram', 'ab-svc hrk-svc') }}<span>인스타그램</span><em>좋아요 순</em></h3><a href="{{ IG }}#h-insta">{{ n_insta }}편 모두<span class="arr" aria-hidden="true">›</span></a></div>
        <ol class="hrk-list" role="list">
          {% for a in RK_IG %}{% set ph = a.photo if a.photo and not a.related else none %}
          <li class="hrk-i{{ ' hrk-x' if loop.index > 3 }}">
            <a class="hrk-a" href="{{ IG }}#{{ a.id }}" data-track="abroad_click">
              <span class="hrk-n tn">{{ loop.index }}<span class="vh">위</span></span>
              <span class="hrk-th hrk-ig{% if ph %} t{{ ph.type }}{% endif %}">{% if ph %}{{ ui.img(ph, '(min-width: 1680px) 220px, 112px', false, 'hrk-img') }}{% else %}{{ ab.svc('instagram', 'ab-svc hrk-glyph') }}{% endif %}</span>
              <span class="hrk-tx"><span class="hrk-top"><b class="hrk-who">{{ a.author or 'Instagram' }}</b>{% if a.likes %}<span class="hrk-cnt tn">좋아요 {{ '{:,}'.format(a.likes|int) }}</span>{% endif %}</span><span class="hrk-t">{{ a.note }}</span></span>
            </a>
            {% set pls = [] %}{% for sl in a.place_slugs or [] if sl in places %}{% set _ = pls.append(places[sl]) %}{% endfor %}
            {% if pls %}<p class="hrk-pl">{% for x in pls[:3] %}<a href="{{ x._path }}">{{ x.name }}</a>{% endfor %}</p>{% endif %}
          </li>
          {% endfor %}
        </ol>
        <p class="hrk-doors">{% if insta_channels %}<a href="{{ IG }}#h-insta-channels"><span>인기 채널 <span class="tn">{{ insta_channels|length }}</span>곳</span><span class="arr" aria-hidden="true">›</span></a>{% endif %}{% if own_ch %}<a href="{{ own_ch.url }}" target="_blank" rel="noopener" data-track="abroad_click"><span>{{ own_ch.name }}<span class="vh"> (새 창)</span></span><span class="arr" aria-hidden="true">↗</span></a>{% endif %}</p>
      </div>
      {% endif %}
    </div>
    <p class="hrk-note">{{ site.site_name|josa('이/가') }} 고른 목록 안에서 {% if RK_YT %}유튜브는 조회수{% endif %}{% if RK_YT and RK_IG %}, {% endif %}{% if RK_IG %}인스타그램은 좋아요 수{% endif %}가 많은 순서이고, 추천 순서가 아닙니다. 숫자는 목록에 실은 때의 값이라 지금과 다를 수 있습니다.{% if rk_types %} 인스타그램 줄의 사진은 게시물에 나온 장소의 사진입니다(출처: 한국관광공사 · 공공누리 제{{ rk_types|sort|join('·') }}유형).{% endif %}</p>
  </div></div>
</section>
{% endif %}
{#- the white card: the AI assistant (_ask.html.j2 box: its head, one question box with one button '물어보기', the '#'
    tags — the site search is the header's, owner 2026-10-14), then the 3D icon menu of the service links. The menu has
    no '물어보기' item any more: the card right above it IS the assistant and the launcher is on screen too, so a third
    door to the same chat would only bring back the doubt the owner pointed at. Without the assistant (no ask.json)
    the card keeps the menu only: the search is in the header. -#}
{% if h.food_row and h.food_row.recs %}{% set FR = h.food_row %}
<section class="ha-food" aria-labelledby="h-hfood">
  <div class="wrap"><div class="hfo">
    <div class="hfo-head"><h2 id="h-hfood" class="hfo-h">{{ FR.group }} 음식점</h2><a class="hfo-all" href="/food/" data-track="food_click">전체 <span class="tn">{{ FR.total }}</span>곳 보기</a></div>
    <ul class="hfo-row">{% for r in FR.recs %}<li><a href="{{ r.path }}" data-track="food_click" data-place="{{ r.e.id }}">
      <span class="hfo-ph{% if r.photo %} t{{ r.photo.type }}{% else %} hfo-ic{% endif %}">{% if r.photo %}<img class="t{{ r.photo.type }}" src="{{ r.photo.url }}"{% if r.photo.w and r.photo.h %} width="{{ r.photo.w }}" height="{{ r.photo.h }}"{% endif %} alt="" loading="lazy" decoding="async" data-kogl="{{ r.photo.type }}">{% else %}{{ ui.type_icon(r.e, 64) }}{% endif %}</span>
      <span class="hfo-nm"><b>{{ r.name }}</b>{% if r.dz %}{% set t = 'good' if '착한' in r.dz.short else ('star' if '맛집' in r.dz.short else ('model' if '모범' in r.dz.short else ('safe' if '안심' in r.dz.short else ''))) %}<span class="dz-chip{% if t %} dz-{{ t }}{% endif %}">{{ r.dz.short }}</span>{% endif %}</span>
      <span class="hfo-l">{% if r.menu %}<b>{{ r.menu }}</b>{% endif %}{% if r.hours %}{% if r.menu %} · {% endif %}<span class="tn">{{ r.hours }}</span>{% endif %}{% if r.closed %} · <span class="{{ 'hfo-cl' if r.is_closed else '' }}">{{ r.closed }}</span>{% endif %}</span>
    </a></li>{% endfor %}</ul>
    <p class="hfo-note">사진이 있는 곳부터 · 추천 순서가 아닙니다{% if FR.lics %} · 사진: 한국관광공사 · 공공누리 제{{ FR.lics|join('·') }}유형{% endif %}</p>
  </div></div>
</section>
{% endif %}
{% if ASK or h.services %}
<section class="hq"{% if ASK %} aria-labelledby="h-ask"{% endif %}>
  <div class="wrap"><div class="hq-card{{ ' hq-menu-only' if not ASK }}">
    {% if ASK %}{{ askm.box(ask_starters, site.region) }}{% endif %}
    {% if h.services %}
    <nav class="hq-menu" aria-label="{{ site.region }} 여행 바로가기">
      {#- phones: the other tiles fill rows of three; when one would be left alone, the last four go two by two -#}
      {% set n_more = h.services|rejectattr('core')|list|length %}
      <ul class="hq-row{{ ' hq-m1' if n_more % 3 == 1 and n_more > 1 }}" style="--core:{{ h.services|selectattr('core')|list|length or 4 }}">
        {% for s in h.services %}<li class="{{ 'hq-core' if s.core else 'hq-more' }}"><a class="hq-i" href="{{ s.href }}"{% if s.track %} data-track="{{ s.track }}"{% endif %}>{{ pk.pic(s.pic, s.icon, 56) }}<span class="hq-l">{{ s.label }}</span>{% if s.n %}<span class="hq-n tn">{{ s.n }}{{ s.unit }}</span>{% endif %}</a></li>{% endfor %}
      </ul>
    </nav>
    {% endif %}
  </div></div>
</section>
{% endif %}
{% if ASK %}{{ askm.panel() }}{% endif %}
{% if N %}
<section class="hn" aria-labelledby="h-news">
  <div class="wrap">
    <h2 id="h-news" class="hn-h">지금 {{ site.region }} 소식</h2>
    <div class="hn-in" data-hcar aria-roledescription="carousel" aria-label="지금 {{ site.region }} 소식">
    {% if N %}
    <div class="ho-news">
      <div class="hv-view" data-hcar-view>
        <div class="hv-track" id="hv-track">
          {% for c in h.news %}
          <article class="nc nc-{{ c.kind }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ N }}" data-hcar-item>
            <div class="nc-frame{% if c.reel %} nc-reelf{% elif c.photo %} t{{ c.photo.type }}{% elif c.og %} nc-ogf{% elif c.art %} nc-artf{% else %} nc-icof{% endif %}">
              {%- if c.reel %}{{ reel_preview(c.reel, SLIDE_SIZES, false, 'nc-play') }}
              {%- elif c.photo %}{{ ui.img(c.photo, SLIDE_SIZES, false, 'nc-img', false, false) }}
              {%- elif c.og %}<img class="nc-og" src="{{ c.og }}" alt="" width="600" height="315" loading="lazy" decoding="async" referrerpolicy="no-referrer">
              {%- elif c.art %}{{ artm.figure(c.art, 'ko', SLIDE_SIZES, false, 'nc-art', false, false) }}
              {%- else %}{{ pk.pic({'event': 'icon-events', 'festival': 'icon-events', 'video': 'icon-video', 'abroad': 'icon-abroad', 'guide': 'guide'}.get(c.kind, 'icon-events'), c.icon, 120) }}{% endif %}</div>
            <div class="nc-body">
              <p class="nc-chips"><span class="nc-chip">{{ c.chip }}</span>{% if c.status %}<span class="nc-st">{{ c.status }}</span>{% endif %}</p>
              <h3 class="nc-t"><a href="{{ c.href }}"{% if c.ext %} rel="noopener"{% endif %}{% if c.lang %} lang="{{ c.lang }}"{% endif %}{% if c.track %} data-track="{{ c.track }}"{% endif %}>{{ c.title }}{% if c.ext %}<span class="nc-x" aria-hidden="true">↗</span>{% endif %}</a></h3>
              {% if c.when or c.sub %}<p class="nc-meta">{% if c.when %}<time datetime="{{ c.when_iso }}" class="tn">{{ c.when }}</time>{% endif %}{% if c.when and c.sub %}<span aria-hidden="true"> · </span>{% endif %}{% if c.sub %}<span>{{ c.sub }}</span>{% endif %}</p>{% endif %}
              {% if c.reel %}<p class="nc-cr">영상: {{ c.reel.label }} @{{ c.reel.account }} · 불꽃 장면은 자료화면</p>{% elif c.photo %}<p class="nc-cr">사진 {{ c.photo.place }} · {{ md.credit(c.photo) }}</p>{% elif c.og %}<p class="nc-cr">사진: {{ c.outlet }} 미리보기 이미지</p>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
      {% if N > 1 %}<div class="ho-ctl">
        <div class="hv-ctl">
          <button type="button" class="hv-c hv-pause" data-hcar-pause aria-label="소식 자동 넘김 멈추기" data-label-play="소식 자동 넘김 시작" data-label-pause="소식 자동 넘김 멈추기">{{ ui.icon('pause', 'icon i-pause') }}{{ ui.icon('resume', 'icon i-play') }}</button>
          <button type="button" class="hv-c" data-hcar-dir="-1" aria-controls="hv-track" aria-label="이전 소식">{{ ui.icon('prev') }}</button>
          <p class="hv-count tn" data-hcar-count aria-live="off"><span class="vh">소식 </span><span data-hcar-cur>1</span> / {{ N }}</p>
          <button type="button" class="hv-c" data-hcar-dir="1" aria-controls="hv-track" aria-label="다음 소식">{{ ui.icon('next') }}</button>
          <span class="hv-prog" aria-hidden="true"><i data-hcar-prog></i></span>
        </div>
        <a class="ho-all" href="/events/">소식 전체<span class="arr" aria-hidden="true">→</span></a>
      </div>{% endif %}
    </div>
  </div>
</section>
{% endif %}
</div>
{#- the reel's dialog (site.js [data-reel-open] opens it; the official embed loads when it shows — [data-embed]) -#}
{% set RL = (h.news[0].reel if h.news and h.news[0].reel else none) or (h.fest.reel if h.fest and h.fest.reel and h.fest.reel.cover else none) %}
{% if RL %}<dialog class="reel-dlg" data-reel-dlg aria-labelledby="h-reel-dlg">
  <div class="reel-dlg-in" data-embed="instagram" data-url="{{ RL.url }}">
    <p class="reel-dlg-h" id="h-reel-dlg">{{ ab.svc('instagram') }}<span><b>{{ RL.label }}</b> @{{ RL.account }}</span><button type="button" class="reel-x" data-reel-close aria-label="닫기">×</button></p>
    <div class="ab-embed" data-embed-slot data-js-only><div class="ab-ph" data-embed-ph>{{ ab.svc('instagram', 'ab-ph-mark') }}<span class="ab-ph-msg">Instagram 릴스 불러오는 중</span><button type="button" class="ab-load" data-embed-load data-title="Instagram 릴스">릴스 불러오기</button></div></div>
    <p class="reel-dlg-go"><a href="{{ RL.url }}" target="_blank" rel="noopener" data-track="fest_reel_click">인스타그램에서 보기<span class="arr" aria-hidden="true">↗</span><span class="vh"> (새 탭)</span></a></p>
  </div>
</dialog>{% endif %}
{#- 날씨각's own card (operator 2026-10-31 '날씨각 실제 디자인으로'), under the first screen, at 날씨각's size (the panel's
    is the same card small; templates/_side.html.j2 weather; its values come in the browser after load — none in this
    HTML) -#}
{% if side and side.wx %}<div class="wrap hwx">{{ sdm.weather(side.wx, 'home') }}</div>{% endif %}

{# 목적별 가이드 (operator 2026-11-02, _mz.html.j2 tile): card-news tiles — the answers (figures checked against each
   guide's own text) on a place's KOGL-1 photo or a colour — and every guide in its group behind one tab per group #}
{% if h.answers %}
{% set T.i = T.i + 1 %}
<section class="sec sec-ans sec-mz{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-ans">
  <div class="wrap">{{ ui.sec_head('목적별 가이드', '취향대로 고르는 ' ~ site.region ~ ' 총정리', 'h-ans', '/guides/' if h.guides else '', '가이드 ' ~ h.guides|length ~ '편 모두' if h.guides else '') }}</div>
  <div class="car car-mzt" data-gallery>
    <div class="car-view" data-gal-view><ol class="mzts car-track">{% for a in h.answers %}{{ mz.tile(a) }}{% endfor %}</ol></div>
    <div class="wrap car-foot">{{ ui.carnav('가이드') }}</div>
  </div>
  {#- every guide, in groups read off the guides (present.guide_groups): one tab per group (its name and count), its
      guides as #chips; without JS every group shows with its heading (site.js [data-tabs]) -#}
  {% if h.guide_groups %}<div class="wrap"><div class="gtab" data-tabs>
    <p class="gtab-l">주제로 찾기</p>
    <div class="gtab-bar" role="tablist" aria-label="가이드 묶음">{% for grp in h.guide_groups %}<button type="button" role="tab" id="gtab-{{ loop.index }}" aria-controls="gtab-p{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ grp.name }}<span class="tn">{{ grp.guides|length }}편</span></button>{% endfor %}</div>
    {% for grp in h.guide_groups %}<div class="gtab-p" role="tabpanel" id="gtab-p{{ loop.index }}" aria-labelledby="gtab-{{ loop.index }}"{% if not loop.first %} data-tab-off{% endif %}><h3 class="gtab-h">{{ grp.name }} <span class="tn">{{ grp.guides|length }}편</span></h3><ul class="gtab-list">{% for g in grp.guides %}<li><a href="{{ g._path }}" data-track="guide_click"><span aria-hidden="true">#</span>{{ g.label or g.title }}</a></li>{% endfor %}</ul></div>{% endfor %}
  </div></div>{% endif %}
</section>
{% endif %}

{# 대표 장소: a stated rule (the attractions on most official courses); without such places, the first attractions with
   photos and visit information; without any place, the honest empty state #}
{% set T.i = T.i + 1 %}
{% if h.featured %}
<section class="sec sec-feat sec-mz{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap">{{ ui.sec_head('공식 코스에 가장 많이 든 곳', '공식 코스 단골 ' ~ h.featured|length ~ '곳', 'h-feat', '', '', site.source.name ~ ' 공식 코스 ' ~ n_courses ~ '개 가운데 ' ~ h.featured_min ~ '개 이상에 들어 있는 관광지') }}</div>
  <div class="car car-fp" data-gallery>
    <div class="car-view" data-gal-view><ol class="fps car-track">{% for c in h.featured %}<li>{{ mz.feed(c) }}</li>{% endfor %}</ol></div>
    <div class="wrap car-foot">{{ ui.carnav('장소') }}</div>
  </div>
</section>
{% elif featured %}
<section class="sec sec-feat{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap">{{ ui.sec_head('먼저 볼 곳', '대표 장소', 'h-feat', '/places/', '관광지 ' ~ counts.attraction ~ '곳 모두') }}</div>
  <div class="car car-feat" data-gallery>
    <div class="car-view" data-gal-view><ol class="cards cards-4 car-track">{% for e in featured[:4] %}<li>{{ ui.card(card_vm(e)) }}</li>{% endfor %}</ol></div>
    <div class="wrap car-foot">{{ ui.carnav('장소') }}</div>
  </div>
</section>
{% else %}
<section class="sec sec-feat p2-empty{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap">
    {{ ui.sec_head('먼저 볼 곳', '여행지 안내를 준비하고 있습니다', 'h-feat') }}
    <p class="p2-empty-t">방문 정보를 확인한 장소부터 안내합니다. 지금은 출처 사이트에서 확인하세요.</p>
    <p><a class="btn btn-ol" href="{{ site.source.url }}" rel="noopener" data-track="official_click">{{ site.source.name }}에서 확인</a></p>
  </div>
</section>
{% endif %}

{# 다가오는 행사: dated tiles ranked today → tomorrow → this week → running (present.ranked_events) #}
{% if has_events %}
{% set T.i = T.i + 1 %}
<section class="sec evband sec-mz{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-ev">
  <div class="wrap">
    {{ ui.sec_head('행사·축제', '캘린더에 찜해 둘 행사', 'h-ev', '/events/', ('행사 ' ~ h.n_upcoming ~ '건 모두') if h.n_upcoming else '행사 일정 모두') }}
    {% if h.events_ranked %}<ol class="tkts">{% for r in h.events_ranked %}{{ mz.ticket(r, loop.index0) }}{% endfor %}</ol>
    {% else %}<p class="p2-none">진행 중이거나 일정이 발표된 행사가 없습니다. <a href="/events/">해마다 열리는 행사와 지난 회차</a></p>{% endif %}
  </div>
</section>
{% endif %}

{# 영상으로 보는 군산: only a build without curated popular videos (another city, the sample) keeps this per-topic block —
   with them the videos are the rank block under the opening (operator 2026-11-10) #}
{% if h.vfeat and not popular_videos %}
{% set T.i = T.i + 1 %}
<section class="sec sec-vid{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-vid">
  <div class="wrap">
    {{ ui.sec_head('YouTube', '영상으로 보는 ' ~ site.region, 'h-vid', '/videos/', '영상 ' ~ h.n_videos ~ '편 모두') }}
    <div class="vgrid">
      <div class="v-feat">{{ ui.video(h.vfeat) }}</div>
      {% if h.vrows %}<ol class="v-rows">{% for r in h.vrows %}{{ p2.vtopic(r) }}{% endfor %}</ol>{% endif %}
    </div>
    <nav class="v-chips" aria-label="영상 주제">{% for c in h.vchips %}<a href="{{ c.path or ('/videos/#' ~ c.id) }}">{{ '그 밖의 영상' if c.title == '기타' else c.title }} <span class="tn">{{ c.n }}</span></a>{% endfor %}</nav>
  </div>
</section>
{% endif %}

{# 다섯 여행 권역: counts by 권역, the rule that drew them, and the anchors on a small map #}
{% if h.regions2 %}
{% set T.i = T.i + 1 %}
<section class="sec sec-reg{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-reg">
  <div class="wrap">
    {{ ui.sec_head('어디에 묵고 어디를 볼까', '권역별로 보는 ' ~ site.region, 'h-reg', '/map/', '권역·읍·면·동 지도') }}
    <div class="reg-grid">
      <div class="reg-main">
        <ol class="regs">
          {% for r in h.regions2 %}
          <li><a href="/map/#{{ r.id }}"><span class="rg-name">{{ r.name }}</span><span class="rg-n"><b class="num tn">{{ r.n }}</b><small>곳</small></span><span class="rg-k tn">관광지 {{ r.k.attraction or 0 }} · 숙소 {{ r.k.stay or 0 }} · 음식점 {{ r.k.food or 0 }}</span>{% if r.dongs %}<span class="rg-d">{{ r.dongs|join('·') }}</span>{% endif %}<span class="arr" aria-hidden="true">›</span></a></li>
          {% endfor %}
        </ol>
        <p class="rule-note">권역은 기준점 {{ h.regions2|length }}곳({% for r in h.regions2 %}{{ r.anchor.place }}{% if not loop.last %}·{% endif %}{% endfor %}) 가운데 직선거리로 가장 가까운 곳으로 묶었습니다.</p>
      </div>
      {{ ui.mapfig(h.region_map, site.region ~ ' 여행 권역 기준점 지도', 'reg-map', '권역 기준점 ' ~ h.regions2|length ~ '곳') }}
    </div>
  </div>
</section>
{% endif %}

{# 군산 이야기 — the page's one black section, also the accent black band (owner 2026-10-09): the oversized word over a
   hairline and the eyebrow as a lime pill. Desktop with motion: a CSS sticky stage (motion.js story); phones, reduced
   motion and no JS: dark tiles in DOM order. Every sentence is a place summary sentence (present.home_story). #}
{% if h.chapters %}
{% set y0 = h.chapters[0].big %}
<section class="story" data-story aria-labelledby="h-story">
  <div class="st-stage" data-stage>
    <div class="st-grid">
      <header class="st-head wrap">
        <p class="eyebrow pill-l"><span>{{ site.region }} 이야기</span></p>
        <h2 id="h-story" class="h2" data-split>{% if y0 is string and y0.isdigit() %}{{ y0 }}년부터 오늘까지{% else %}오늘의 {{ site.region }}{% endif %}</h2>
      </header>
      <p class="st-big" aria-hidden="true"><span class="num" data-roll>{{ y0 }}</span></p>
      <ol class="st-chs" data-n="{{ h.chapters|length }}">
        {% for c in h.chapters %}
        <li class="st-ch{% if loop.first %} is-on{% endif %}" id="{{ c.id }}" data-ch>
          {% if c.photo %}
          <figure class="st-ph t{{ c.photo.type }}" data-reveal-ph>
            <div class="st-frame">{{ ui.img(c.photo, '(min-width: 1024px) 940px, 300px', false, 'st-img') }}</div>
            <figcaption class="st-cap">{{ c.photo.place or c.photo.name }} · {{ md.credit(c.photo) }}</figcaption>
          </figure>
          {% endif %}
          <div class="st-text">
            <p class="st-year"><span class="num tn">{{ c.big }}</span>{% if c.kicker != c.big %}<span class="st-k">{{ c.kicker }}</span>{% endif %}</p>
            <h3 class="st-title">{{ c.title }}</h3>
            {% for t in c.text %}<p class="st-p">{{ t }}</p>{% endfor %}
            {% if c.steps %}<ol class="st-steps">{% for it in c.steps %}<li><span class="num tn">{{ it.y }}</span><div><a href="{{ it.path }}">{{ it.name }}</a><p>{{ it.text }}</p></div></li>{% endfor %}</ol>{% endif %}
            {% if c.figs %}<dl class="st-figs">{% for f in c.figs %}<div><dt>{{ f.label }}</dt><dd><span class="num tn" data-roll-fig>{{ f.n }}</span><small>{{ f.unit }}</small></dd></div>{% endfor %}</dl>{% endif %}
            {% if c.src %}<p class="ch-cite">근거: {% for name, path in c.src %}<a href="{{ path }}">{{ name }}</a>{% if not loop.last %} · {% endif %}{% endfor %} 장소 정보{% if c.figs %} · {% if c.geo_src %}{{ c.geo_src }} {% endif %}좌표 사이 직선{% endif %}</p>{% elif c.figs %}<p class="ch-cite">근거: {% if c.geo_src %}{{ c.geo_src }} {% endif %}좌표 사이 직선</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
      <ol class="st-rail" aria-label="이야기 순서" data-rail>{% for c in h.chapters %}<li><button type="button" data-go="{{ loop.index0 }}"{% if loop.first %} aria-current="step"{% endif %}><span class="num tn">{{ c.big }}</span>{% if c.kicker != c.big %} {{ c.kicker }}{% endif %}</button></li>{% endfor %}</ol>
    </div>
  </div>
</section>
{% endif %}

{# 섬 갤러리: an Apple carousel of island cards — KOGL-1 covers drift inside their frames, KOGL-3 stays whole #}
{% if h.gallery %}
{% set T.i = T.i + 1 %}
<section class="gallery{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-isl" data-gallery>
  <div class="wrap gal-head">
    {{ ui.sec_head('고군산군도', '다리로 이어진 섬들', 'h-isl', '', '', '', true) }}
    <p class="gal-fact">{% if h.gogun_km %}구 군산세관 본관에서 선유도까지 직선 <b class="tn">{{ h.gogun_km }}km</b> · {% endif %}고군산 권역 관광지 <b class="tn">{{ h.n_gogun }}곳</b></p>
  </div>
  <div class="car-view" data-gal-view>
    <ol class="gal-track car-track">
      {% for c in h.gallery %}<li>{{ ui.card(c, '', '(min-width: 1024px) 360px, 300px') }}</li>{% endfor %}
      <li class="gal-all"><a href="/places/?region=고군산">고군산 권역 관광지 <span class="tn">{{ h.n_gogun }}</span>곳 모두<span class="arr" aria-hidden="true">›</span></a></li>
    </ol>
  </div>
  <div class="wrap car-foot">{{ ui.carnav('장소') }}</div>
</section>
{% endif %}

{# 공식 코스: the 당일 lines (or the first lines) by their stops, and one of them on the map (present.course_map; map.js
   fetches the Kakao Maps SDK near the screen, after load) #}
{% if courses %}
{% set T.i = T.i + 1 %}
{% set lines = h.day_lines or h.lines[:3] %}
<section class="sec sec-co{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-co">
  <div class="wrap">
    {{ p2.sec_head(site.source.name ~ ' 공식', ('순서대로 따라가는 당일 코스' if h.day_lines else '순서대로 따라가는 공식 코스'), 'h-co', '/courses/', '코스 ' ~ n_courses ~ '개 모두', '', false, 'course_click') }}
    {% set tm = h.teaser.map if h.teaser else none %}
    <div class="co-grid2{% if not tm %} p2-co-one{% endif %}">
      <ol class="lines lines-home">
        {% for c in lines %}
        <li class="line-row">
          <span class="line-dur">{{ c.code or c.duration or c.group }}</span>
          <a class="line-name" href="{{ c.path }}" data-track="course_click">{{ c.title or c.display }}</a>
          {{ ui.stoprow(c.stops, (c.title or c.display) ~ ' 경유지 순서') }}
          {{ ui.linemeta(c) }}
        </li>
        {% endfor %}
      </ol>
      {% if tm %}{% set cv = h.teaser.cv %}
      <div class="co-teaser">
        <p class="cm-title"><span class="cm-k">지도</span><a href="{{ cv.path }}" data-track="course_click">{{ cv.display }}</a></p>
        {{ ui.coursemap(tm, cv.display ~ ' 경유지 지도') }}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}


{% if h.columns %}
{% set T.i = T.i + 1 %}
<section class="sec sec-cols{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-cols">
  <div class="wrap">
    {{ ui.sec_head('에디토리얼', '깊이 읽는 ' ~ site.region ~ ' 칼럼', 'h-cols', '/columns/', '칼럼 ' ~ h.n_columns ~ '편 모두') }}
    <div class="col-grid">
      {% for c in h.columns %}
      <article class="col-card">
        <div class="col-card-body">
          <p class="col-meta-top"><span class="col-badge">{{ c.category }}</span>{% if c.label %}<span>{{ c.label }}</span>{% endif %}</p>
          <h3 class="col-card-title"><a href="{{ c.path }}">{{ c.title }}</a></h3>
          <p class="col-card-dek">{{ c.dek }}</p>
          {% if c.pull_quote %}<p class="col-card-pull">“{{ c.pull_quote }}”</p>{% endif %}
          <footer class="col-card-foot">
            <span class="tn">약 {{ c.reading_minutes }}분 읽기 · 장소 {{ c.n_items }}곳</span>
            <span class="col-card-places">{{ c.place_names|join(' · ') }}</span>
          </footer>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{#- 2026-11-10 (the calm pass, confirmed by the operator the same day — 'MAIN에 합쳐 배포해'): the blog and the posts
    from abroad come after the site's own visit information (권역 · 이야기 · 섬 · 코스 · 칼럼) — the reading (칼럼 →
    블로그) together, the SNS after it. YouTube and Instagram are the rank block under the opening (the operator's
    word after that: '순위별로 큐레이션해서 굉장히 잘 보이는 곳에'). -#}
{# 군산각 블로그 (operator 2026-10-30: '홈에도 블로그 카드 몇 개'): build.blog_home — the newest post of each category
   first — as the /blog/ cards (a licensed photo of a place the post is about, the title to the blog, the date and the
   places); 1 column of row cards on phones, 2 from 720px, 3 from 1100px (css/48-blog.css). The photos' credit line
   closes the section, as on /blog/. #}
{% if home_blog %}
{% set T.i = T.i + 1 %}
<section class="sec sec-blog sec-mz{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-blog">
  <div class="wrap">
    {{ ui.sec_head(blog.name, '따끈한 ' ~ site.region ~ ' 여행기', 'h-blog', '/blog/', '블로그 글 ' ~ blog.posts|length ~ '편 모두') }}
    {#- the blog's own line (operator 2026-11-02): the site's symbol as its avatar (drawn, not a picture: the
        section stands even with no place data, CLAUDE.md 4), its name, address and post count, its categories (each to its group on
        /blog/), then the newest posts — the one with a KOGL-1 photo as the lead (its title on the photo), the rest as
        rows (_blog.html.j2 lead · row) -#}
    <div class="blz-prof">{% if site.brand_symbol %}<span class="blz-av" aria-hidden="true">{% include "assets/brand/" ~ site.brand_symbol %}</span>{% endif %}<p class="blz-who"><b>{{ blog.name }}</b><span>{{ blog.url|replace('https://', '') }} · 글 <span class="tn">{{ blog.posts|length }}</span>편</span></p>
      {% if blog.categories %}<ul class="blz-cats">{% for k, name in blog.categories.items() %}<li><a href="/blog/#bl-{{ k }}">{{ name }}</a></li>{% endfor %}</ul>{% endif %}
      <a class="blz-go" href="{{ blog.url }}" rel="noopener" data-track="blog_click">블로그 가기<span class="arr" aria-hidden="true">↗</span></a></div>
    {% set lead = home_blog|selectattr('photo')|selectattr('photo.type', 'equalto', 1)|first %}
    <div class="blz{{ ' blz-nolead' if not lead }}">{% if lead %}{{ blm.lead(lead) }}{% endif %}<ul class="blz-list">{% for r in home_blog if not (lead and r is sameas lead) %}{{ blm.row(r) }}{% endfor %}</ul></div>
    {% set types = home_blog|selectattr('photo')|map(attribute='photo.type')|unique|sort|list %}
    {% if types %}<p class="note bl-home-cr">사진 출처: 한국관광공사 · 공공누리 {% for t in types %}제{{ t }}유형{% if t == 3 %}(변경금지){% endif %}{% if not loop.last %}·{% endif %}{% endfor %}</p>{% endif %}
  </div>
</section>
{% endif %}

{# SNS에서 본 군산 (owner 2026-10-14: 'SNS 게시물이 좀 더 잘 보이면 좋겠는데 지금은 너무 구석에'): the newest posts as our
   own cards — the service's mark, the service · account, our one-line note, the date — each to its card on /abroad/
   (the official embed is there); nothing loads from the services on the home. A row that scrolls sideways on phones,
   2 columns from 700px, 4 from 1024px (css/48-abroad.css .hsns). #}
{% if home_posts %}
{% set T.i = T.i + 1 %}
<section class="sec sec-sns sec-mz{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-sns">
  <div class="wrap">
    {{ ui.sec_head('해외에서 본 ' ~ site.region, '해외 피드에 뜬 ' ~ site.region, 'h-sns', '/abroad/#ab-sns', 'SNS 게시물 ' ~ n_posts ~ '개 모두') }}
    <ul class="hsns">{% for a in home_posts %}{{ mz.sns(a, loop.index0) }}{% endfor %}</ul>
    <p class="note hsns-note">원문 문장과 게시물 사진은 옮기지 않습니다. 카드 위 그림은 게시물에 나온 장소의 사진이나, 나온 장소가 없으면 '관련 사진'이라고 적은 관련 장소의 사진(한국관광공사)이고, 게시물은 각 서비스의 공식 임베드로 엽니다.</p>
  </div>
</section>
{% endif %}

{# 공식 안내: the official sites this one is built from (links only) #}
{% if site.official_links %}
{% set T.i = T.i + 1 %}
<section class="sec p2-official{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-official">
  <div class="wrap">
    {{ ui.sec_head('공식 안내', site.region ~ ' 공식 관광 안내', 'h-official') }}
    <ul class="p2-links">{% for l in site.official_links %}<li><a href="{{ l.url }}" rel="noopener" data-track="official_click"><span class="p2-l-n">{{ l.name }}</span>{% if l.note %}<span class="p2-l-v">{{ l.note }}</span>{% endif %}{{ ui.icon('external', 'icon-sm') }}</a></li>{% endfor %}</ul>
  </div>
</section>
{% endif %}

{# 군산각 알리기 (operator 2026-11-11, pipeline/share.py): the site's own 보내기 box — the panel's and the phone menu's
