{% extends "base.html.j2" %}
{#- Place page (Apple direction). Everything printed comes from the view model `p` (pipeline/present.place_vm, built on
    build.entity_ctx); the round-2 keys (e, kind, facts, links, …) are still in the context.
    First screen (CLAUDE.md 7): kicker with the city → name → the whole summary as the answer (first sentence, the rest
    in a lighter run of the same paragraph: JSON-LD's description is the summary and must read as one run) → official
    designations as chips when the place is on a city / national list (each links to its list; the '지정' row of the
    facts card names the list) → the kind's key facts as spec tiles + 출처 → the route row (카카오맵 길찾기 · 네이버 지도 ·
    카카오맵, '다른 지도') → 예약하기 when the data has an official booking page (ui.book, pipeline/booking.py: a row of
    its own, one short note). The lead photo follows as a product shot (KOGL-1: preloaded, a rounded 3:2 crop; KOGL-3:
    desktop only, whole, never above its own size — phones get the provider's small renditions as a thumbnail row).
    Then a grey band: the facts card (every stored value whole, per-field sources as footnotes, both values of a
    conflict + '방문 전 전화 확인' — all data-block="facts", the rows pipeline.validate reads), photos, 이용 안내 /
    이용 편의 (also facts), the map; then chapters: 주변·함께 가기, 자세히, 영상, 자주 묻는 질문, 출처.
    No 확인일·원문 수집일·검수일 on the page (operator decision 2026-10-09): those dates stay in the data, JSON-LD
    (dateModified, lastReviewed) and sitemap lastmod. -#}
{% import "_p1.html.j2" as p1 %}
{% import "_media.html.j2" as md %}
{% import "_abroad.html.j2" as ab %}
{% import "_near.html.j2" as nb %}
{% import "_blog.html.j2" as blm %}
{% import "_today.html.j2" as tdy %}
{% set fn = p.notes|length > 1 %}
{#- the media block (영상 · 소식 · 해외 기사 · SNS · 블로그 글): its parts name the heading and the page-nav link -#}
{% set abroad = p.e._abroad or [] %}{% set ab_art = abroad|selectattr('kind', 'equalto', 'article')|list %}{% set ab_post = abroad|selectattr('kind', 'equalto', 'post')|list %}{% set media_parts = (['영상'] if p.videos else []) + (['소식'] if (media or {}).news else []) + (['해외 기사'] if ab_art else []) + (['SNS'] if ab_post else []) + (['블로그 글'] if p.e._blog else []) %}
{% set nm = p.name %}
{% set lead = p.hero_k1 or p.hero_k3 %}
{% set kind_word = {'attraction': '볼거리', 'stay': '숙소', 'food': '음식점'}[p.kind] %}
{% set show_same = p.dong and p.area_same and (p.compact or not (p.near_sights or p.near_biz)) %}
{% set has_near = p.parts or p.segs or p.near_sights or p.near_biz or p.went_next or p.guide_cards or p.event_cards or p.twin_rows or p.rel_rows or show_same %}
{% block main_class %}{% endblock %}
{% block bodyclass %}pg-place kind-{{ p.kind }}{% if lead %} has-photo{% else %} no-photo{% endif %}{% endblock %}
{% block head %}{% if p.hero_k1 %}{{ md.preload(p.hero_k1, '100vw') }}{% endif %}{% endblock %}
{% block lnav %}
{% set links = [('정보', '#h-facts')] %}
{% if p.photos|length > 1 or p.hero_k3 %}{% set _ = links.append(('사진', '#h-photos')) %}{% endif %}
{% if p.shops %}{% set _ = links.append(('가게', '#h-shops')) %}{% endif %}
{% set _ = links.append(('지도', '#h-map' if p.points else '#h-dir')) %}
{% if has_near %}{% set _ = links.append(('주변', '#h-near')) %}{% endif %}
{% if p.details %}{% set _ = links.append(('자세히', '#h-details')) %}{% endif %}
{% if media_parts %}{% set _ = links.append((media_parts[0], '#h-media')) %}{% endif %}
{% if p.faqs %}{% set _ = links.append(('질문', '#h-faq')) %}{% endif %}
{% set _ = links.append(('출처', '#h-src')) %}
{% if p.primary %}{% set cta = {'url': p.primary.url, 'label': '길찾기' if p.primary.role == 'route' else '지도', 'ext': true, 'track': 'route_click' if p.primary.role == 'route' else 'map_click', 'provider': p.primary.key, 'place': p.e.id} %}{% else %}{% set cta = {'url': '#h-dir', 'label': '길찾기'} %}{% endif %}
{{ ui.lnav(nm, links, cta, nm ~ ' 바로가기', {'id': p.e.id, 'lang': 'ko'}) }}
{% endblock %}
{% block content %}
<article class="place" data-entity-id="{{ p.e.id }}" data-tier="{{ p.e.tier or 'basic' }}"{% if mode != 'production' %} data-status="{{ p.e.status }}" data-index="{{ index_note }}"{% endif %}>
  <header class="pl-hero{% if p.hero_k1 %} hk1{% elif p.hero_k3 %} hk3{% else %} hnone{% endif %}">
    {#- the light opening (ui4, 2026-10-14, after the owner's reference): name → one-line answer → key facts (each tile
        with its small picture, ui.kf) → routes on the left; the lead photo big and rounded on the right from 1024px
        and under the routes on phones (≤ 45% of the screen height). Text never sits on the photo. KOGL-1 may fill
        its rounded frame (crop); KOGL-3 sits whole inside a padded tinted frame, never cropped or enlarged
        (CLAUDE.md 3.4) and only from 1024px: the provider's original is large and may not be re-encoded, so phones
        get the small renditions as a thumbnail row under the key facts. A place without a photo gets a small kind
        picture above the name (no large empty cover). -#}
    <div class="wrap pl-hero-in pl-x{% if lead %} has-lead{% endif %}">
      <div class="pl-head">
        {% if not lead %}<p class="pl-kpic">{{ ui.kpic(ui.KIND_PIC.get((p.e._visual or ('', 'pin'))[1], 'kind-attraction'), (p.e._visual or ('', 'pin'))[1], 72, '일러스트: ' ~ p.kind_label) }}</p>{% endif %}
        <p class="kicker">{% for lab, href in p.kicker %}<a href="{{ href }}">{{ lab }}</a>{% endfor %}<span>{{ site.locality }}{% if p.dong %} {{ p.dong }}{% endif %}</span></p>
        <h1 class="d1 vt-title">{{ nm }}</h1>
        {% if p.alt_names %}<p class="alt-n pl-alt">다른 이름: {{ p.alt_names|join(' · ') }}</p>{% endif %}
        {{ nb.relation(p.relation, ' · ') }}
        <div class="summary" data-block="summary">
          {% if p.lede %}<p class="lede">{{ p.lede }}{% if p.story %} <span class="lede-2">{{ p.story|join(' ') }}</span>{% endif %}</p>
          {% else %}<p class="lede">{{ nm|josa('은/는') }} {{ site.locality }}{% if p.dong %} {{ p.dong }}{% endif %}에 있는 {{ p.kind_label }}입니다.</p>{% endif %}
        </div>
        {{ p1.dzchips(p.designations, p.e.id) }}
        {{ ui.kf(p.kf, 'kf-hero', '#h-facts', p.e.id) }}
        <div class="kf-notes">{{ p1.notices(p.e._notices or [], p.e.id) }}{{ p1.kfnote(p.kf, p.e.id) }}</div>
        {{ ui.route(p.primary, p.front, p.rest, p.e.id, 'h-dir', nm) }}
        {{ ui.book(p.booking, p.bw, p.e.id) }}
      </div>
      {% if lead %}
      <figure class="pv pv{{ lead.type }}">
        {% if p.hero_k1 %}<div class="pv-ph">{{ ui.img(p.hero_k1, '(min-width: 1024px) 560px, 100vw', true, 'pv-img vt-photo', false, true) }}</div>
        {% else %}<div class="pv-k3"{% if lead.w and lead.h %} style="--nw:{{ lead.w }}px;--ar:{{ lead.w }}/{{ lead.h }}"{% endif %}><img class="t3 vt-photo" src="{{ lead.url }}"{% if lead.w and lead.h %} width="{{ lead.w }}" height="{{ lead.h }}"{% endif %} alt="{{ lead.alt }}" loading="lazy" decoding="async" data-kogl="3"></div>{% endif %}
        <figcaption class="pv-cap"><span class="pv-cr">{{ md.credit(lead) }}{% if p.photos|length > 1 or p.hero_k3 %} · {% endif %}</span>{% if p.photos|length > 1 or p.hero_k3 %}<a href="#h-photos">사진 {{ p.photos|length }}장</a>{% endif %}</figcaption>
      </figure>
      {% endif %}
      {% if p.hero_k3 %}
      {% if p.thumbs %}
      <div class="pl-thumbs only-narrow">
        <ul>{% for t in p.thumbs %}<li><a href="#h-photos"><img class="t{{ t.type }}" src="{{ t.url }}" width="{{ t.w }}" height="{{ t.h }}" style="height:{{ [t.h, 100]|min }}px" alt="{{ t.alt }}" loading="lazy" decoding="async" data-kogl="{{ t.type }}"></a></li>{% endfor %}</ul>
        <p class="pl-thumbs-c"><a href="#h-photos">사진 {{ p.photos|length }}장 ↓</a> · 출처: 한국관광공사 · {{ p.photos|map(attribute='lic')|unique|join(', ') }}</p>
      </div>
      {% endif %}
      {% endif %}
    </div>
  </header>

  <div class="pl-band tone-2">
  <div class="wrap pl-grid{% if not lead %} lift{% endif %}">
    {#- 오늘의 상태 · 오늘의 바다 (present.today_vm, templates/_today.html.j2; operator 2026-10-31): a grid item of its own
        — phones and tablets right after the opening, before 방문 전 확인 (css/74-today.css order); from 1024px at the top
        of the left column, the photos and the rest under it (.pl-main moves to the second row) -#}
    {% if p.today %}{{ tdy.card(p.today, nm) }}{% endif %}
    <section class="pl-side" aria-labelledby="h-facts" data-block="facts" data-sticky>
      <h2 id="h-facts" class="h-side"><span class="nm">{{ nm }}</span> 방문 전 확인</h2>
      {% if p.practical or p.designations %}<dl class="facts">{% for r in p.practical %}{{ p1.factrow(r, fn, p.e.id) }}{% endfor %}{{ p1.dzrow(p.designations, p.e.id) }}</dl>{% endif %}
      {#- 영업 확인 (present.license_vm; licenses.json, 2026-10-31): the licence records say it operates; a 식품안심업소
          designation while valid — no grade, no licence date or phone -#}
      {% if p.biz %}<div class="biz" data-block="license"><p class="biz-l"><b>{{ p.biz.open }}</b> — {{ p.biz.by }}{% if p.biz.licensed_name %} · 인허가상 상호 {{ p.biz.licensed_name }}{% endif %}</p>{% if p.biz.safe %}<p class="biz-l">{{ p.biz.safe_html }}</p>{% endif %}{% if p.biz.sources %}<p class="biz-src">출처: {% for s in p.biz.sources %}{% if not loop.first %} · {% endif %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% endfor %}</p>{% endif %}</div>{% endif %}
      {% if p.missing %}<p class="need"><b>확인 필요</b> {{ p.missing|join('·') }}</p>{% endif %}
      {% if p.ask %}<p class="need"><b>숙소에 문의</b> {{ p.ask|join('·') }}</p>{% endif %}
      {% for key, note in (p.e.fact_conflicts or {}).items() %}<p class="need withheld">{{ {'usetime': '이용시간', 'restdate': '쉬는 날', 'usefee': '요금'}.get(key, key) }}: 같은 출처 안에서 값이 달라 싣지 않았습니다 — {{ note }}.</p>{% endfor %}
      {{ p1.notes(p.notes, p.e.id) }}
    </section>

    <div class="pl-main">
      {% if p.photos|length > 1 or p.hero_k3 %}
      {% set strip = p.photos[1:7] %}{# the lead photo is the opening (KOGL-1 every width, KOGL-3 from 1024px) #}
      <section class="media" aria-labelledby="h-photos">
        <h2 id="h-photos" class="h-sec"><span class="nm">{{ nm }}</span> 사진 <span class="tn">{{ p.photos|length }}</span></h2>
        {% if p.hero_k3 %}{{ ui.figure(p.photos[0], nm, 1, p.photos|length, 'ph-lead only-narrow', false, '100vw') }}{% endif %}
        {% if strip %}
        <div class="car car-ph" data-gallery>
          <div class="car-view" data-gal-view><ul class="strip car-track">{% for ph in strip %}<li>{{ ui.figure(ph, nm, loop.index + 1, p.photos|length, '', false, '(min-width: 1024px) 460px, 340px', false, false) }}</li>{% endfor %}</ul></div>
          <div class="car-foot car-foot-s"><p class="strip-credit">출처: 한국관광공사 · {{ strip|map(attribute='lic')|unique|join(', ') }}</p>{% if strip|length > 1 %}{{ ui.carnav('사진') }}{% endif %}</div>
        </div>
        {% endif %}
      </section>
      {% endif %}

      {% if p.more %}
      <section class="block" aria-labelledby="h-more" data-block="facts">
        <h2 id="h-more" class="h-sec"><span class="nm">{{ nm }}</span> 이용 안내</h2>
        <dl class="facts facts-more">{% for r in p.more %}{{ p1.factrow(r, fn, p.e.id) }}{% endfor %}</dl>
      </section>
      {% endif %}
      {% if p.fit %}
      <section class="block" aria-labelledby="h-fit" data-block="facts">
        <h2 id="h-fit" class="h-sec"><span class="nm">{{ nm }}</span> 이용 편의</h2>
        <dl class="facts facts-more">{% for r in p.fit %}{{ p1.factrow(r, fn, p.e.id) }}{% endfor %}</dl>
      </section>
      {% endif %}

      {% if p.visitors %}{% set V = p.visitors %}
      {#- 월별 관광객 (present.visitors_vm, 2026-10-31): the latest full year's twelve months as bars on the place's own
          scale — the busiest month darker and labelled, every value in the bar's title and in a table for screen
          readers — the year's total, the quietest month, the next year's months so far, and the source -#}
      <section class="block vis" aria-labelledby="h-vis" data-block="visitors">
        <h2 id="h-vis" class="h-sec"><span class="nm">{{ nm }}</span> 월별 관광객</h2>
        <p class="vis-sum">{{ V.year }}년 <b class="tn">{{ '{:,}'.format(V.total) }}명</b> · 가장 많은 달 <b>{{ V.peak.m }}월</b> <span class="tn">({{ '{:,}'.format(V.peak.n) }}명)</span> · 가장 적은 달 {{ V.low.m }}월{% if V.recent %} · {{ V.recent.year }}년 1~{{ V.recent.through }}월 <span class="tn">{{ '{:,}'.format(V.recent.total) }}명</span>{% endif %}</p>
        <ol class="vis-bars" aria-hidden="true">{% for b in V.bars %}<li{% if b.peak %} class="is-peak"{% endif %} title="{{ b.m }}월 {{ '{:,}'.format(b.n) }}명">{% if b.peak %}<span class="vis-v tn">{{ '{:,}'.format(b.n) }}</span>{% endif %}<i style="--h:{{ b.pct }}%"></i><span class="vis-m">{{ b.m }}</span></li>{% endfor %}</ol>
        <table class="vh"><caption>{{ nm }} {{ V.year }}년 월별 관광객</caption><tbody>{% for b in V.bars %}<tr><th scope="row">{{ b.m }}월</th><td>{{ '{:,}'.format(b.n) }}명</td></tr>{% endfor %}</tbody></table>
        <p class="vis-src">군산시가 집계한 관광지점 관광객 수입니다. 출처: <a href="{{ V.source.url }}" rel="noopener">{{ V.source.name }}</a></p>
      </section>
      {% endif %}

      {% if p.shops %}
      {#- a market's shops by item group (present.market_shops), as cards (2026-10-30 '카드로, 사진도'): a jump row of the
          groups; per group a head with a 공공누리 photo of that kind of stall when one of the market's photos shows it
          (tools/market_data_gunsan.SHOP_PHOTOS — never a photo of a listed shop) and the count, then one card per shop —
          name, the 온누리 list's 취급품목 as written, the address (상가정보 match or the licence row), the lists it is on
          (badges) and a 카카오맵 link at that point; the first 12 cards, the rest behind '더 보기'. The list has no hours,
          and a shop that takes no 온누리상품권 is not on it — the note says so -#}
      {#- a shop card (2026-10-30 '투박하다'): name, the list's items, address and phone lines, the lists it is on as badges,
          then 전화 · 지도 as two 44px buttons along the bottom -#}
      {% macro shop_card(c) -%}
      <li class="shop-card"><p class="sc-name">{{ c.name }}</p>{% if c['items'] %}<p class="sc-items">{{ c['items'] }}</p>{% endif %}{% if c.addr or c.tel %}<ul class="sc-meta">{% if c.addr %}<li class="sc-addr">{{ ui.icon('pin', 'icon sc-ico') }}<span>{{ c.addr }}</span></li>{% endif %}{% if c.tel %}<li class="sc-telno tn">{{ ui.icon('phone', 'icon sc-ico') }}<span>{{ c.tel[0] }}</span></li>{% endif %}</ul>{% endif %}<p class="sc-badges">{% for b in c.badges %}<span class="sc-badge{{ ' is-lic' if b != '온누리 가맹' }}">{{ b }}</span>{% endfor %}</p>{% if c.tel or c.map %}<p class="sc-act">{% if c.tel %}<a class="sc-btn sc-tel" href="tel:{{ c.tel[1] }}" data-track="tel_click" aria-label="{{ c.name }} 전화 {{ c.tel[0] }}">{{ ui.icon('phone') }}전화</a>{% endif %}{% if c.map %}<a class="sc-btn sc-map" href="{{ c.map }}" target="_blank" rel="noopener" data-track="map_click" data-provider="kakao" aria-label="{{ c.name }} 카카오맵에서 보기">{{ ui.icon('map') }}지도</a>{% endif %}</p>{% endif %}</li>
      {%- endmacro %}
      <section class="block shops" aria-labelledby="h-shops" data-block="shops">
        <h2 id="h-shops" class="h-sec"><span class="nm">{{ nm }}</span> 품목별 가게 <span class="tn">{{ p.shops.n }}곳</span></h2>
        <p class="shops-note">온누리상품권 가맹점 명부에 소속 시장이 이곳으로 적힌 가게를 취급품목으로 묶었습니다. 카드의 품목은 명부에 적힌 그대로이고{% if p.shops.with_addr %}, 주소는 상가(상권)정보에서 이름이 같은 점포가 시장에서 {{ p.shops.match_m }}m 안에 한 곳뿐일 때만 붙였습니다{% endif %}. 영업시간은 두 자료 모두에 없습니다{% if p.shops.groups|selectattr('licensed')|list %}. 인허가 정보와 상가정보에서 더한 가게는 한 시장에만 실었습니다(명부에 같은 이름이 있으면 명부의 시장, 없으면 가장 가까운 시장). 전화번호는 인허가 정보에 적힌 그대로입니다{% endif %}{% if p.shops.stalls %}. 노점 {{ p.shops.stalls }}곳은 이름 없이 수만 셉니다{% endif %}.</p>
        <nav class="shops-nav" aria-label="품목 바로가기">{% for g in p.shops.groups %}<a href="#shops-{{ g.key }}">{{ g.label }} <span class="tn">{{ g.n_cards }}</span></a>{% endfor %}</nav>
        {% for g in p.shops.groups %}
        <div class="shops-g" id="shops-{{ g.key }}" data-group="{{ g.key }}">
          <div class="shops-head{{ ' has-ph' if g.photo }}">
            {% if g.photo %}<figure class="shops-ph"><img src="{{ g.photo.url }}" alt="{{ g.photo.alt }}" loading="lazy" decoding="async"><figcaption>사진: {{ g.photo.credit }} · {{ g.photo.license|license_label }}</figcaption></figure>{% endif %}
            <h3 class="shops-gh">{{ g.label }} <span class="shops-gn tn">{{ g.n_cards }}곳</span></h3>
            {% if g.licensed %}<div class="shops-lics">{{ ui.icon('info', 'icon') }}<div>{% for lc in g.licensed %}<p class="shops-lic">{{ lc.note }}</p>{% endfor %}</div></div>{% endif %}
          </div>
          <ul class="shop-cards">{% for c in g.cards %}{{ shop_card(c) }}{% endfor %}</ul>
          {% if g.more %}<details class="shops-more"><summary>{{ g.more|length }}곳 더 보기</summary><ul class="shop-cards">{% for c in g.more %}{{ shop_card(c) }}{% endfor %}</ul></details>{% endif %}
        </div>
        {% endfor %}
        <p class="shops-src">출처: {% if p.shops.source.url %}<a href="{{ p.shops.source.url }}" rel="noopener">{{ p.shops.source.name }}</a>{% else %}{{ p.shops.source.name }}{% endif %}{% if p.shops.addr_source %} · 주소: <a href="{{ p.shops.addr_source.url }}" rel="noopener">{{ p.shops.addr_source.name }}</a>{% endif %}{% set lic_src = [] %}{% for g in p.shops.groups %}{% for lc in g.licensed %}{% if lc.mode != 'store' and lc.source.url not in lic_src %}{% set _ = lic_src.append(lc.source.url) %} · 인허가: <a href="{{ lc.source.url }}" rel="noopener">{{ lc.source.name }}</a>{% endif %}{% endfor %}{% endfor %}</p>
      </section>
      {% endif %}

      {% if p.points %}
      <section class="block" aria-labelledby="h-map">
        <h2 id="h-map" class="h-sec"><span class="nm">{{ nm }}</span> 지도</h2>
        {{ p1.placemap(p.points, nm ~ ' 위치 지도', 'place-map', '거리는 좌표 사이 직선' ~ (' · 위치: ' ~ p.geo_src if p.geo_src else '')) }}
        {% if p.anchors %}<ul class="anchors">{% for a in p.anchors %}<li><a href="{{ a.path }}">{{ a.name }}</a><span class="tn">직선 {{ a.m|pdist }}</span></li>{% endfor %}</ul>{% endif %}
      </section>
      {% endif %}
      {% if p.access %}{{ p1.access(p.access, nm, p.e.id) }}{% endif %}
    </div>
  </div>
  </div>

  {% if has_near %}
  {#- 주변·함께 가기 (templates/_near.html.j2): the official courses through the place as segments (prev ── here ── next,
      straight-line legs, one chip per course), the nearby places on one straight-line scale (both groups), the
      same 읍·면·동 when there is no nearby list, guides and events as cards, then the same building's other names and
      places with similar names (no distance). A parent place (pipeline/relations.py 'inside') lists its parts first;
      the nearby and similar-name rows never hold the page's own family (present.place_vm, relations.keep_rows) -#}
  {% set w = p.nw %}
  <section class="wrap chapter ch-rail" aria-labelledby="h-near" data-block="nearby">
    <h2 id="h-near" class="rail-label"><span class="nm">{{ nm }}</span> 주변·함께 가기</h2>
    <div class="rail-body nb">
      {% if p.parts %}{{ nb.parts(p.parts, w.parts.format(name=nm), p.e.id, w) }}{% endif %}
      {% if p.segs %}<div class="nb-part">{{ nb.segs(p.segs, p.e.id, w, '이곳을 지나는 군산시 공식 코스 ' ~ p.boards|length ~ '개', nm) }}</div>{% endif %}
      {% if p.near_sights or p.near_biz %}
      <div class="nb-part" data-block="near-rows">
        {{ nb.groups([('주변 볼거리', p.near_sights, 'icon-sights'), ('주변 숙소·음식점', p.near_biz, 'icon-stay')], p.e.id, w, p.points) }}
        <p class="note nb-note">{{ w.scale.format(d=p.near_scale|pdist) }}{% if p.nearby_source.provider %} · 반경 {{ p.nearby_source.radius_m|pdist }} 안 · 직선거리 순 · {{ p.nearby_source.provider }}{% endif %}</p>
        {% if p.photo_lics %}<p class="note nb-credit">{{ w.credit.format(lic=p.photo_lics|join(', ')) }}</p>{% endif %}
      </div>
      {% endif %}
      {% if p.went_next %}
      {#- 이어서 많이 간 곳 (present.related_vm; related.json, 한국관광공사 관광지별 연관 관광지 정보): the built places cars
          went to next after this one, in rank order — TMAP movement data, never called a recommendation -#}
      <div class="nb-part" data-block="went-next"><h3 class="h-sub">{{ p.went_next.title }}</h3>{{ nb.rows(p.went_next.rows, p.e.id, w) }}
        <p class="note nb-note">{{ p.went_next.note }}</p></div>
      {% endif %}
      {% if show_same %}
      <div class="nb-part">
      <h3 class="h-sub h-same">{{ p.dong }}의 다른 {{ kind_word }} <span class="tn">{{ p.area_same|length }}</span>곳</h3>
      <ol class="same">{% for x in p.area_same %}<li><a href="{{ x._path }}" data-track="{{ {'stay': 'stay_click', 'food': 'food_click'}.get(x.kind, 'nearby_click') }}" data-place="{{ p.e.id }}">{{ x.name }}</a>{% if x._type %}<span class="same-t">{{ x._type }}</span>{% endif %}</li>{% endfor %}</ol>
      </div>
      {% endif %}
      {% if p.guide_cards %}<div class="nb-part"><h3 class="h-sub nb-h">{{ ui.kpic('guide', '', 40) }}<span>이곳이 포함된 가이드</span></h3>
        {{ nb.cards(p.guide_cards, p.e.id, w, 'guide_click', w.more_guides) }}</div>{% endif %}
      {% if p.event_cards %}<div class="nb-part"><h3 class="h-sub nb-h">{{ ui.kpic('icon-events', '', 40) }}<span>이곳에서 열리는 행사</span></h3>
        {{ nb.cards(p.event_cards, p.e.id, w, '', w.more_events) }}</div>{% endif %}
      {% for title, xs, blk in [('같은 건물의 다른 이름', p.twin_rows, 'twins'), ('이름이 비슷한 곳', p.rel_rows, 'similar')] if xs %}
      <div class="nb-part" data-block="{{ blk }}"><h3 class="h-sub">{{ title }}</h3>{{ nb.rows(xs, p.e.id, w) }}</div>
      {% endfor %}
      {% if p.photo_lics and not (p.near_sights or p.near_biz) %}<p class="note nb-credit">{{ w.credit.format(lic=p.photo_lics|join(', ')) }}</p>{% endif %}
    </div>
  </section>
  {% endif %}

  {% if p.details %}
  <section class="wrap chapter ch-rail" aria-labelledby="h-details" data-block="details">
    <h2 id="h-details" class="rail-label"><span class="nm">{{ nm }}</span> 자세히</h2>
    <div class="rail-body prose details">
      {% for d in p.details %}<h3>{{ d.heading }}</h3><p>{{ d.text|decaution|tel(p.e.id) }}{% if p.detail_notes|length > 1 %}{{ d.n|csup }}{% endif %}</p>{% endfor %}
      {{ p1.chnotes(p.detail_notes, p.e.id) }}
    </div>
  </section>
  {% endif %}

  {% set news = (media or {}).news or [] %}
  {% if media_parts %}
  <section class="wrap chapter ch-rail" aria-labelledby="h-media" data-block="media">
    <h2 id="h-media" class="rail-label"><span class="nm">{{ nm }}</span> {{ media_parts|join('·') }}</h2>
    <div class="rail-body">
      {% if p.videos %}<ul class="vids">{% for v in p.videos %}{{ ui.video(v, p.e.id, [], false, 'li') }}{% endfor %}</ul>
      {% if has_videos %}<p class="note"><a href="/videos/">영상 모아 보기</a></p>{% endif %}{% endif %}
      {% if news %}<ul class="xlinks">{% for n in news %}<li><a href="{{ n.url }}" rel="noopener" data-track="news_click" data-place="{{ p.e.id }}">{{ n.title }}</a><span class="same-t">{{ n.publisher }}{% if n.date %} · <span class="tn">{{ n.date }}</span>{% endif %}</span></li>{% endfor %}</ul>{% endif %}
      {% if abroad %}<h3 class="ab-sub">해외에서 본 {{ nm }}</h3>
      <ul class="ab-list ab-in">{% for a in ab_art %}{{ ab.article(a, false, false) }}{% endfor %}{% for a in ab_post %}{{ ab.post(a, false) }}{% endfor %}</ul>
      <p class="note"><a href="/abroad/">해외에서 본 {{ site.region }} 모아 보기</a></p>{% endif %}
      {% if p.e._blog %}<h3 class="ab-sub">{{ blog.name }}</h3>{{ blm.rows(p.e._blog, p.e.id) }}
      <p class="note"><a href="/blog/">{{ blog.name }} 글 모아 보기</a></p>{% endif %}
    </div>
  </section>
  {% endif %}

  {% if p.faqs %}
  <section class="wrap chapter ch-rail" aria-labelledby="h-faq" data-block="faq">
    <h2 id="h-faq" class="rail-label"><span class="nm">{{ nm }}</span> 자주 묻는 질문</h2>
    <div class="rail-body">{{ p1.faq(p.faqs, p.faq_notes, p.e.id) }}</div>
  </section>
  {% endif %}

  <section class="wrap chapter ch-rail pl-src" aria-labelledby="h-src" data-block="sources">
    <h2 id="h-src" class="rail-label"><span class="nm">{{ nm }}</span> 출처</h2>
    <div class="rail-body">
      <dl class="src-dl">
        {#- owner 2026-10-31: no '원문이 없어 …' line — a place without an original page names the source its values came
            from instead (자료: the 한국관광공사 page when there is one), so the original block stays (validate) #}
        {% set has_orig = show_original or p.orig_url %}
        {% if not has_orig %}<div data-block="original"><dt>자료</dt><dd>{% if p.visitkorea %}<a href="{{ p.visitkorea }}" rel="noopener" data-track="official_click" data-place="{{ p.e.id }}">한국관광공사 안내에서 보기</a>{% else %}{{ facts_source.provider or '한국관광공사 TourAPI' }}{% endif %}</dd></div>{% endif %}
        {% if has_orig %}<div data-block="original"><dt>원문</dt><dd>
          {% if show_original %}<blockquote class="orig" cite="{{ orig.source_url }}">{{ orig.text|nl2br }}</blockquote>
          <p class="note">출처: <a href="{{ orig.source_url }}" rel="noopener" data-track="official_click" data-place="{{ p.e.id }}">{{ orig.source_name }}</a> · {{ orig.license|license_label }} · 수정 없이 옮겼습니다.</p>
          {% elif p.orig_url %}<a href="{{ p.orig_url }}" rel="noopener" data-track="official_click" data-place="{{ p.e.id }}">{{ p.orig.source_name or site.source.name }}에서 원문 보기</a>
          {% endif %}
        </dd></div>{% endif %}
        {% if p.visitkorea and has_orig %}<div><dt>대한민국 구석구석</dt><dd><a href="{{ p.visitkorea }}" rel="noopener" data-track="official_click" data-place="{{ p.e.id }}">한국관광공사 안내에서 보기</a></dd></div>{% endif %}
        {% for s in sources if s.label == '공식 홈페이지' %}<div><dt>공식 홈페이지</dt><dd><a href="{{ s.url }}" rel="noopener" data-track="official_click" data-place="{{ p.e.id }}">{{ s.url|replace('https://', '')|replace('http://', '') }}</a></dd></div>{% endfor %}
        {% if p.photos %}<div><dt>사진</dt><dd>한국관광공사 · {{ p.photos|map(attribute='lic')|unique|join(', ') }}</dd></div>{% endif %}
      </dl>
      <p class="note">{{ site.site_name }}({{ site.region }} 여행 정보 사이트) 정리 · <a href="/about/#correction">틀린 정보 알리기</a></p>
    </div>
  </section>
</article>
{% endblock %}
