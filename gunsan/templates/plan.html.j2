{% extends "base.html.j2" %}
{% import "_pic.html.j2" as pk %}
{% import "_mascot.html.j2" as mm %}
{% import "_art.html.j2" as artm %}
{#- /plan/: the AI course planner (operator 2026-10-17 — its own page, very visible, many cute 3D pictures). The reader
    picks conditions on cards (real radio and check boxes under the pictures: keyboard and screen readers use them as
    such); assets/plan.js (attached by site.js for [data-plan]) asks /api/plan/ (chatbot/planner.js), shows the steps
    while it works, then draws the plan from the site's own place data (/plan/places.json, present.plan_places): times,
    each place's photo (TourAPI, credited) or its kind's 3D picture, the day's state the code checked, the first-screen
    facts, the legs (straight-line distance, shared bus routes, a Kakao Map directions link — the map app gives the
    time), a numbered map per day (map.js course map), the fee total, what still needs checking, and an edit box.
    Choices: present.PLAN_CHOICES; pictures: present.PLAN_RESULT_PICS (cloned from <template>); mascots: present.plan_vm
    (the planner's own poses once they exist). A utility page: noindex, not in the sitemap, Korean only.
    Operator 2026-10-19: the course the site builds from its data comes first (SSE 'early') and the AI's replaces it;
    a plan passes on as a link (/plan/#p=…, chatbot/plan_share.js — the plan in the address, nothing stored), opened
    here by plan.js (docs/handover/plan_share.md). -#}
{% set C = choices %}
{#- before the first paint: an address that carries the form's keys (the assistant's hand-over, plan.js fromAddress)
    marks <html> 'trp-handing', so the line over the form has its room from the start (plan.css); one with no date the
    form can take (none said, or one gone by: the assistant never guesses a day — '월요일' is no date) also
    'trp-undated', which picks the line's words that ask for a date (review 2026-10-22: the line said every value came
    from the conversation while the date, the people and the ages were the form's defaults) -#}
{#- a share link (#p=…, plan.js): the plan leaves the address before anything else reads it — first in <head>
    (base.html.j2 head_first), ahead of the tag manager's snippet and of every stylesheet: an inline script after a
    stylesheet waits for it, while the tag manager's script, once it has come (from the cache: at once), runs without
    waiting, and the tags record the page's address — a plan (its people, ages, needs) is not theirs to keep (round-6
    verifier). plan.js takes it from window.__trpLink. The same on popstate and hashchange — a link pasted into a tab
    already on /plan/ changes only the fragment: these listeners come before any tag's own, so a history-change page
    view never sees the plan either (round-6 final verifier: a later popstate listener read the link) -#}
{% block head_first %}<script>(function(){function t(){if(location.hash.indexOf('#p=')===0){window.__trpLink=location.hash;try{history.replaceState(history.state,'',location.pathname+location.search)}catch(e){}}}t();addEventListener('popstate',t);addEventListener('hashchange',t)})()</script>{% endblock %}
{#- before the first paint, too: a plan the page will draw as soon as its script runs — a share link, or the plan this
    tab kept (a reload; the address carries no form keys) — marks <html> 'trp-holding', so the result's room (a screen)
    is laid out from the start and nothing under it moves when the course comes (round-6 verifier: the crumbs and the
    footer were pushed out, CLS 0.74–0.91). The same reading of the tab's plan as plan.js: a date from today on, or a
    shared plan -#}
{% block head %}<link rel="stylesheet" href="/assets/plan.css">
<script>(function(d,h){var t=new Date(),z=function(n){return(n<10?'0':'')+n},y=function(x){return x.getFullYear()+'-'+z(x.getMonth()+1)+'-'+z(x.getDate())},iso=y(t),s=location.search;if(/[?&](date|days|start|end|from|to|move|with|adults|seniors|kids|prefs|needs|note)=/.test(s)){h.add('trp-handing');var m=/[?&]date=(\d{4}-\d{2}-\d{2})(?:&|$)/.exec(s);if(!m||m[1]<iso||m[1]>y(new Date(t.getTime()+180*86400000)))h.add('trp-undated');return}if(window.__trpLink){h.add('trp-holding');return}try{var k=JSON.parse(sessionStorage.getItem('gs-plan')||'null');if(k&&k.plan&&k.plan.days&&k.conditions&&(k.conditions.date>=iso||k.shared))h.add('trp-holding')}catch(e){}})(document,document.documentElement.classList);</script>{% endblock %}
{% block main_class %}{% endblock %}
{% block bodyclass %}pg-plan{% endblock %}
{% block content %}
<div class="trp" data-plan data-api="/api/plan/" data-places="/plan/places.json"{% if kakao_sdk %} data-kakao-sdk="{{ kakao_sdk }}"{% endif %}>
{% set hero_art = (art_slots or {}).get('plan.head') %}
<section class="trp-hero{{ ' has-art' if hero_art }}" aria-labelledby="h-plan">
  <div class="wrap trp-hero-in">
    <div class="trp-hero-t">
      <p class="trp-eyebrow">{{ pk.pic('icon-plan', 'spark', 28, '', false) }}<span>AI 코스 만들기 · 시험판</span></p>
      <h1 id="h-plan">조건만 고르면<br>{{ region }} 여행 코스를 짜 드려요</h1>
      <p class="trp-lede">이 사이트에 실린 장소 <b class="tn">{{ n_places }}</b>곳의 운영시간·쉬는 날·요금으로 일정을 만들고, 그날 쉬는 곳과 문 닫은 뒤의 시각, 이동할 틈이 없는 구간은 코드가 한 번 더 확인합니다.</p>
      <ul class="trp-promise">
        <li>{{ pk.pic('fact-closed', 'calendar', 32, '', false) }}<span>그날 휴무·운영시간 확인</span></li>
        <li>{{ pk.pic('plan-budget', 'wallet', 32, '', false) }}<span>입장료 합계 자동 계산</span></li>
        <li>{{ pk.pic('plan-swap', 'swap', 32, '', false) }}<span>말로 고쳐 달라고 하기</span></li>
      </ul>
      <a class="btn trp-start" href="#trp-form">조건 고르기</a>
    </div>
    {% if not hero_art %}
    <div class="trp-hero-art" aria-hidden="true">
      <div class="trp-blob"></div>
      <span class="trp-float f1">{{ pk.pic('theme-islands-sea', 'wave', 96, '', false) }}</span>
      <span class="trp-float f2">{{ pk.pic('icon-food', 'bowl', 84, '', false) }}</span>
      <span class="trp-float f3">{{ pk.pic('theme-modern-history', 'building', 92, '', false) }}</span>
      <span class="trp-float f4">{{ pk.pic('icon-course', 'route', 80, '', false) }}</span>
      <span class="trp-float f5">{{ pk.pic('sit-night', 'moon', 72, '', false) }}</span>
      <span class="trp-hero-mascot">{{ mm.pic(mascots.done.name, mascots.done.kind, 200) }}</span>
    </div>
    {% endif %}
  </div>
  {% if hero_art %}<div class="trp-hero-bg">{{ artm.figure(hero_art, 'ko', '(min-width: 900px) 100vw, 170vw', eager=true, cls='trp-hero-fig', high=true) }}</div>{% endif %}
</section>
<noscript><p class="wrap trp-nojs">코스 만들기는 자바스크립트가 켜져 있어야 동작합니다. <a href="/courses/">공식 코스 {{ n_courses }}개</a>와 <a href="/guides/">가이드 {{ n_guides }}편</a>에서도 일정을 찾을 수 있습니다.</p></noscript>

{#- the line over the form when the assistant hands a reader over: plan.js puts its words in (a status region: they
    come after it is in the page, so they are read out). Its room is laid out from the first paint under html.trp-handing
    (review 2026-10-18, fourth round: added after the paint it pushed the form down, CLS 0.11–0.13 on 360–390px phones);
    the hidden copy of the words gives the box their height at every width. A plain visit has no box. Two sets of words
    (review 2026-10-22): a date carried, or none (html.trp-undated, the head script: the date is left empty and the
    line asks for one); both say that what the assistant could not read is the form's default — 'not read', not 'not
    said': it never reads the number of people, and a child's age only in digits (k4b review: '대화에 없던 조건' left
    '어른 3명' said and not carried under a line implying it was) -#}
<div class="wrap trp-handed-w"><div class="trp-handed-box"><span class="trp-handed-ghost" aria-hidden="true"><span data-dated>대화에서 읽은 조건만 채웠어요. 읽지 못한 조건(인원·아이 나이·예산 등)은 기본값이니 확인하고 코스 만들기를 누르세요.</span><span data-undated>대화에서 읽은 조건만 채웠어요. 날짜는 읽지 못해 비워 뒀으니 골라 주세요. 그 밖에 읽지 못한 조건(인원·아이 나이·예산 등)은 기본값이에요.</span></span><p class="trp-handed" role="status" data-plan-handed></p></div></div>
<form class="wrap trp-form" id="trp-form" data-plan-form novalidate>
  <fieldset class="trp-step">
    <legend><span class="trp-n">1</span>언제 가세요?</legend>
    <div class="trp-when">
      <label class="trp-field"><span>출발하는 날</span><input type="date" name="date" required data-plan-date></label>
      {#- every half hour (outside tester 2026-10-23: a 10:30 train could not be entered): a start 07:00–14:00, an end
          15:00–22:00, by the minute of the day; the server takes any HH:MM 06:00–23:00 three hours apart -#}
      <label class="trp-field"><span>하루 시작</span><select name="start">{% for m in range(7 * 60, 14 * 60 + 1, 30) %}<option value="{{ '%02d:%02d' % (m // 60, m % 60) }}"{% if m == 10 * 60 %} selected{% endif %}>{{ m // 60 }}:{{ '%02d' % (m % 60) }}</option>{% endfor %}</select></label>
      <label class="trp-field"><span>하루 끝</span><select name="end">{% for m in range(15 * 60, 22 * 60 + 1, 30) %}<option value="{{ '%02d:%02d' % (m // 60, m % 60) }}"{% if m == 18 * 60 %} selected{% endif %}>{{ m // 60 }}:{{ '%02d' % (m % 60) }}</option>{% endfor %}</select></label>
    </div>
    {#- where the trip starts and ends (review 2026-10-17: '군산역 10시 출발' asked in words, the first museum at 10:00):
        a station or a terminal by name — the plan leaves a margin after the start and before the end -#}
    <div class="trp-when trp-hubs">
      <label class="trp-field"><span>어디서 출발하세요?</span><select name="from"><option value="">정하지 않음(숙소·집 등)</option>{% for v, label in C.hubs %}<option value="{{ v }}">{{ label }}</option>{% endfor %}</select></label>
      <label class="trp-field"><span>마지막 날 어디로 가세요?</span><select name="to"><option value="">정하지 않음</option>{% for v, label in C.hubs %}<option value="{{ v }}">{{ label }}</option>{% endfor %}</select></label>
    </div>
    {#- what the two times mean (operator 2026-10-24: they hold every day for the places to visit and the cafés only — a
        day before a night has its dinner and the night's stay after the end, the dinner when the end is 17:30 or later:
        plan_state.afterEnd, nightDinner; 2026-10-24 I07 had held the dinner too, and a day to 18:00 lost it) -#}
    <p class="trp-hint">여러 날이면 둘러볼 곳과 카페는 날마다 하루 시작부터 하루 끝 안에 넣습니다. 밤을 묵는 날은 저녁 식사와 숙소를 하루 끝 뒤에도 둡니다(하루 끝이 17:30 이후면 저녁 시간에 그날 여는 음식점을 넣어요). 마지막 날은 모든 일정을 하루 끝까지 마칩니다. 역·터미널을 고르면 첫날 출발 시각은 하루 시작, 마지막 날 도착 시각은 하루 끝으로 보고 그 사이 이동 여유를 둡니다(이동 시간은 사이트에 없음).</p>
    <div class="trp-cards trp-cards-3" role="radiogroup" aria-label="기간">
      {% for v, label, pic, g in C.days %}<label class="trp-card"><input type="radio" name="days" value="{{ v }}"{% if loop.first %} checked{% endif %}><span class="trp-card-in">{{ pk.pic(pic, g, 72) }}<b>{{ label }}</b></span></label>{% endfor %}
    </div>
  </fieldset>

  <fieldset class="trp-step">
    <legend><span class="trp-n">2</span>어떻게 다니세요?</legend>
    <div class="trp-cards trp-cards-2" role="radiogroup" aria-label="이동 수단">
      {% for v, label, pic, g in C.move %}<label class="trp-card"><input type="radio" name="move" value="{{ v }}"{% if v == 'transit' %} checked{% endif %}><span class="trp-card-in">{{ pk.pic(pic, g, 72) }}<b>{{ label }}</b>{% if v == 'transit' %}<small>근처 정류장과 노선이 있는 곳 위주</small>{% else %}<small>주차 정보가 있는 곳 위주</small>{% endif %}</span></label>{% endfor %}
    </div>
  </fieldset>

  <fieldset class="trp-step">
    <legend><span class="trp-n">3</span>누구와 가세요?</legend>
    <div class="trp-cards trp-cards-4" role="radiogroup" aria-label="함께 가는 사람">
      {% for v, label, pic, g in C.with %}<label class="trp-card"><input type="radio" name="with" value="{{ v }}"{% if v == 'couple' %} checked{% endif %}><span class="trp-card-in">{{ pk.pic(pic, g, 72) }}<b>{{ label }}</b></span></label>{% endfor %}
    </div>
    <div class="trp-people">
      <div class="trp-count" data-count="adults"><span id="trp-ad-l">어른</span><button type="button" data-step="-1" aria-label="어른 한 명 빼기">−</button><output class="tn" aria-labelledby="trp-ad-l" data-count-value>2</output><button type="button" data-step="1" aria-label="어른 한 명 더하기">+</button></div>
      <div class="trp-count" data-count="kids"><span id="trp-kd-l">어린이·유아</span><button type="button" data-step="-1" aria-label="아이 한 명 빼기">−</button><output class="tn" aria-labelledby="trp-kd-l" data-count-value>0</output><button type="button" data-step="1" aria-label="아이 한 명 더하기">+</button></div>
      <div class="trp-count" data-count="seniors"><span id="trp-sn-l">그중 65세 이상</span><button type="button" data-step="-1" aria-label="65세 이상 한 명 빼기">−</button><output class="tn" aria-labelledby="trp-sn-l" data-count-value>0</output><button type="button" data-step="1" aria-label="65세 이상 한 명 더하기">+</button></div>
      <div class="trp-ages" data-ages></div>
      <p class="trp-hint">아이 나이와 65세 이상 인원은 입장료 계산에 씁니다. 요금표에 나이 기준이나 경로 요금이 없으면 '확인 필요'로 남깁니다.</p>
    </div>
  </fieldset>

  <fieldset class="trp-step">
    <legend><span class="trp-n">4</span>무엇을 좋아하세요? <small>선택 · 최대 4개</small></legend>
    <div class="trp-cards trp-cards-chips" data-max="4">
      {% for v, label, pic, g in C.prefs %}<label class="trp-card trp-chip"><input type="checkbox" name="prefs" value="{{ v }}"><span class="trp-card-in">{{ pk.pic(pic, g, 56) }}<b>{{ label }}</b></span></label>{% endfor %}
    </div>
  </fieldset>

  <fieldset class="trp-step">
    <legend><span class="trp-n">5</span>꼭 필요한 게 있나요? <small>선택</small></legend>
    <div class="trp-cards trp-cards-chips">
      {% for v, label, pic, g in C.needs %}<label class="trp-card trp-chip"><input type="checkbox" name="needs" value="{{ v }}"{% if need_notes and need_notes[v] %} data-need-note="{{ need_notes[v].replace('{n}', (need_n or {}).get(v, 0)|string) }}"{% if v in (need_n or {}) %} data-need-n="{{ need_n[v] }}"{% endif %}{% endif %}><span class="trp-card-in">{{ pk.pic(pic, g, 56) }}<b>{{ label }}</b></span></label>{% endfor %}
    </div>
    {#- UI-A01 (2026-10-24): the moment a need is picked, how many places to visit the site's data says fit it — a place it
        says nothing of is not one the need does not fit (plan.js needNotes; no script: nothing shown) -#}
    <div class="trp-hint trp-need-note" data-need-notes data-tail="{{ need_tail }}" aria-live="polite" hidden></div>
  </fieldset>

  <fieldset class="trp-step">
    <legend><span class="trp-n">6</span>입장료 예산과 하고 싶은 말 <small>선택</small></legend>
    <div class="trp-budget">
      {{ pk.pic('plan-budget', 'wallet', 56) }}
      <label class="trp-field"><span>일행 전체 입장료 예산(원)</span><input type="number" name="budget" inputmode="numeric" min="0" max="1000000" step="1000" placeholder="예: 10000"></label>
      <div class="trp-quick" role="group" aria-label="예산 빠르게 고르기">{% for v in (0, 10000, 30000, 50000) %}<button type="button" data-budget="{{ v if v else '' }}">{{ '정하지 않음' if not v else (v // 10000) ~ '만 원' }}</button>{% endfor %}</div>
      <p class="trp-hint">입장료만 계산합니다. 식비·교통비·숙박비는 사이트에 확인된 값이 없어 넣지 않습니다.</p>
    </div>
    <label class="trp-field trp-note"><span>하고 싶은 말</span><textarea name="note" maxlength="200" rows="2" placeholder="예: 짬뽕은 꼭 먹고 싶어요. 오후엔 바다를 보고 싶어요."></textarea></label>
  </fieldset>

  {#- the button's box. On phones (plan.css, below 900px) only the button's bar stays at the screen's foot — the summary
      and the short notice sit in the page just above it — so the fixed areas stay within 15% of the screen (CLAUDE.md
      7; review 2026-10-22: the whole box was 159px at 390×844, with the header 25%); from 900px one box as before -#}
  <div class="trp-go">
    <p class="trp-sum" data-plan-sum aria-live="polite"></p>
    <p class="trp-fine-s">먼저 짠 코스는 바로 · Anthropic Claude가 다듬는 데 20초~1분 · 서버에 저장하지 않음(<a href="/about/#plan">자세히</a>)</p>
    <div class="trp-go-bar">
      <button type="submit" class="btn trp-submit">{{ pk.pic('icon-plan', 'spark', 40, '', false) }}<span>AI로 코스 만들기</span></button>
      <p class="trp-err" data-plan-formerr role="alert" hidden></p>
    </div>
    <p class="trp-fine">사이트 자료로 짠 코스가 먼저 바로 나오고, AI가 조건에 맞게 다듬은 코스는 하루 코스 보통 20~40초, 2박 3일은 1분 넘게 걸릴 수 있습니다. 고른 조건은 코스를 만드는 데만 쓰고 서버에 저장하지 않으며, 이 탭에서만 임시로 보관합니다. 일정은 Anthropic의 Claude가 이 사이트 자료로 만들고, 휴무·운영시간·입장료·조건은 사이트의 코드가 검사합니다(<a href="/about/#plan">자세히</a>).</p>
  </div>
</form>

<section class="wrap trp-work" data-plan-work hidden aria-labelledby="h-work">
  <div class="trp-work-in">
    <span class="trp-work-art">{{ mm.pic(mascots.work.name, mascots.work.kind, 200) }}</span>
    <div>
      <h2 id="h-work" tabindex="-1">코스를 짜고 있어요</h2>
      <ol class="trp-steps" data-plan-steps>
        <li data-step="search">장소 찾기</li>
        <li data-step="read">장소 정보 읽기</li>
        <li data-step="check">휴무·운영시간 확인</li>
        <li data-step="submit">일정 정리</li>
        <li data-step="fix">맞지 않는 곳 고치기</li>
      </ol>
      <p class="trp-live" data-plan-live aria-live="polite"></p>
      <button type="button" class="btn btn-ol" data-plan-cancel>멈추기</button>
    </div>
  </div>
</section>

<section class="trp-result" data-plan-result hidden aria-labelledby="h-result"></section>

<template id="trp-pics">{% for id in result_pics %}<span data-id="{{ id }}">{{ pk.pic(id, icon_glyph(id), 40) }}</span>{% endfor %}</template>
<template id="trp-mascots"><span data-id="done">{{ mm.pic(mascots.done.name, mascots.done.kind, 96) }}</span><span data-id="rain">{{ mm.pic(mascots.rain.name, mascots.rain.kind, 96) }}</span><span data-id="sorry">{{ mm.pic(mascots.sorry.name, mascots.sorry.kind, 96) }}</span></template>
<template id="trp-quick">{% for ask, label, pic in quick_edits %}<button type="button" class="trp-qe" data-ask="{{ ask }}">{{ pk.pic(pic, icon_glyph(pic), 32) }}<span>{{ label }}</span></button>{% endfor %}</template>
</div>
{% endblock %}
