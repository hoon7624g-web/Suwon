  "site.site_name": {
    "ko": "수원각",
    "en": "Suwongak"
  },
  "site.description": {
    "ko": "수원각은 수원의 관광지·맛집(음식점)·숙소·여행 코스·축제·영상을 한곳에 모은 여행 정보 사이트입니다. 장소마다 이용시간·쉬는 날·요금·주차·길찾기와 값별 출처를 적었습니다.",
    "en": "Suwongak brings together Suwon's attractions, restaurants, stays, courses, festivals, and videos in one place, with hours, closed days, fees, parking, directions, and per-value sources."
  },
  "site.disclaimer": {
    "ko": "수원시 공식 홈페이지와 별도로 운영되는 독립 사이트입니다. 원문·사진의 권리는 각 출처에 있으며 표시된 이용조건을 따릅니다.",
    "en": "An independent site operated separately from the official Suwon City website. Rights to original texts and photos belong to each source under the stated terms."
  },
  "site.operator.name": {
    "ko": "에이아이오투오",
