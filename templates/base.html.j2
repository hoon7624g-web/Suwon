{% import "_ui.html.j2" as ui %}{% import "en/_chrome.html.j2" as enc %}{% import "_lang.html.j2" as lg %}{% import "_side.html.j2" as sdm %}<!doctype html>
{#- base.html.j2 — every page (Apple direction). Head logic (title, description, canonical, robots/noindex,
    search-engine tokens in production only, og/twitter, geo, JSON-LD, GA4 + track.js in production with a GA4 id) is
    unchanged by the redesign. Blocks for page templates:
      content     the page (inside <main id="main-content">)
      main_class  class of <main>: "wrap" by default — every page sets it to "" and lays out its own bands
                  (.pg-hero / .pl-hero / .op … each with its own .wrap)
      bodyclass   extra classes on <body> (e.g. "pg-place kind-food has-photo"; pg-home enables the home's
                  content-visibility rules in css/60-motion.css)
      lnav        the local bar (ui.lnav: title, section links, one blue pill). When a page fills it, the global bar
                  scrolls away and only the local bar stays stuck (body.has-lnav) — place, course, event, guide
      head        extra <head> tags (e.g. md.preload(ph), a preconnect); page.preload {type, srcset, sizes, media}
                  or {href, media} is printed here already
      head_first  a script that must run before anything else in <head>, the tag manager included (plan.html.j2: a
                  share link's #p= fragment leaves the address before any tag can read it)
      crumbs      the breadcrumb line above the footer (default: page.crumbs)
    Context used here: site, page, page_kind, noindex, banner, mode, nav [(label, href)], nav_current, ctxbtn
    (label, href) | None, has_search, has_videos, tourapi_used, wordmark (pipeline/present.common_vm, page_chrome),
    side (the tab panel: present.side_vm, en_site Pages.side — templates/_side.html.j2, operator 2026-10-31).
    Language: lang ('ko' when unset; 'en', 'ja', 'zh-Hans' … on the other versions, pipeline/en_site.py with the
    locale table pipeline/locales.py) sets <html lang>, og:locale (og_locale) and the body chrome (the other versions'
    header, crumbs and footer are in en/_chrome.html.j2, with their words t and locale loc). The head logic — title,
    robots/noindex, canonical, verification tokens, og, JSON-LD, GA4 — is the same for every language.
    page.alternates [{hreflang, href}] prints the hreflang links (ko · en · ja · zh-Hans · zh-Hant · de · fr · es · ru ·
    x-default: the versions this page has) of a page that has a twin; langs [{code, hreflang, label, href, current, note}]
    is the language menu (_lang.html.j2: each version's counterpart page, else its list of the same kind or its home
    with a 'not translated' note; none without other versions).
    Scripts: site.js (defer) is the only script in the HTML; it attaches motion.js after 'load' and map.js /
    course.js / search.js on pages with their hooks, and chat.js + chat.css on the first press of the site
    assistant's launcher (_chat.html.j2, included at the end of <body>; see the header of assets/site.js). -#}
{% set lang = lang|default('ko') %}
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
{% block head_first %}{% endblock %}
{% if site.gtm_id and mode == 'production' %}<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','{{ site.gtm_id }}');</script>
<!-- End Google Tag Manager -->
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{# set before the first paint: JS-only furniture is laid out from the start, so nothing appears or moves later #}
<script>document.documentElement.classList.add('js')</script>
<title>{{ page.title }}{% if site.site_name and site.site_name not in page.title %} | {{ site.site_name }}{% endif %}</title>
{% if page.description %}<meta name="description" content="{{ page.description }}">{% endif %}
<link rel="canonical" href="{{ page.canonical }}">
{% if lang == 'ko' and site.site_url %}<link rel="alternate" type="application/rss+xml" title="{{ site.site_name }} RSS" href="{{ site.site_url.rstrip('/') }}/rss.xml">{% endif %}
{% for a in page.alternates or [] %}<link rel="alternate" hreflang="{{ a.hreflang }}" href="{{ a.href }}">
{% endfor %}
{% if noindex %}
<meta name="robots" content="noindex, nofollow">
{% elif page.robots %}
<meta name="robots" content="{{ page.robots }}">
{% else %}
<meta name="robots" content="index, follow, max-image-preview:large">
{% endif %}
{% if mode == 'production' %}{% set sv = site.search_verification or {} %}
{% if sv.google %}<meta name="google-site-verification" content="{{ sv.google }}">{% endif %}
{% if sv.bing %}<meta name="msvalidate.01" content="{{ sv.bing }}">{% endif %}
{% if sv.naver %}<meta name="naver-site-verification" content="{{ sv.naver }}">{% endif %}
{% endif %}
<meta property="og:type" content="{{ page.og_type or 'website' }}">
<meta property="og:site_name" content="{{ site.site_name }}">
<meta property="og:title" content="{{ page.title }}">
{% if page.description %}<meta property="og:description" content="{{ page.description }}">{% endif %}
<meta property="og:url" content="{{ page.canonical }}">
<meta property="og:locale" content="{{ og_locale or ('en_US' if lang == 'en' else 'ko_KR') }}">
{% if page.image %}<meta property="og:image" content="{{ page.image }}">{% endif %}
{% if page.image_alt %}<meta property="og:image:width" content="{{ page.image_w }}">
<meta property="og:image:height" content="{{ page.image_h }}">
<meta property="og:image:alt" content="{{ page.image_alt }}">
<meta name="twitter:image:alt" content="{{ page.image_alt }}">
{% endif %}
<meta name="twitter:card" content="{{ 'summary_large_image' if page.image else 'summary' }}">
<meta name="theme-color" content="#ffffff">
{% if page.geo %}
<meta name="geo.position" content="{{ page.geo.lat }};{{ page.geo.lng }}">
<meta name="ICBM" content="{{ page.geo.lat }}, {{ page.geo.lng }}">
{% endif %}
{% if page.geo_placename %}<meta name="geo.placename" content="{{ page.geo_placename }}">{% endif %}
{% if page.preload %}<link rel="preload" as="image"{% if page.preload.type %} type="{{ page.preload.type }}"{% endif %}{% if page.preload.srcset %} imagesrcset="{{ page.preload.srcset }}" imagesizes="{{ page.preload.sizes or '100vw' }}"{% else %} href="{{ page.preload.href }}"{% endif %}{% if page.preload.media %} media="{{ page.preload.media }}"{% endif %} fetchpriority="high">{% endif %}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/assets/brand/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/assets/vendor/pretendard/pretendard.css">
<link rel="stylesheet" href="/assets/style.css">
<style>@view-transition{navigation:auto}@media (prefers-reduced-motion:reduce){@view-transition{navigation:none}}</style>
{# head block: a page whose first screen shows a KOGL-1 photo may preload it here with md.preload(ph)
   (_media.html.j2) instead of page.preload. The behaviour states are folded into the one built stylesheet
   (templates/assets/css/65-states.css), so there is no third stylesheet. #}
{% block head %}{% endblock %}
{% for block in page.jsonld %}
<script type="application/ld+json">{{ block|safe }}</script>
{% endfor %}
{# site.js (every page) is the only script in the HTML: bar state, menu, pause buttons, filters, carousels,
   YouTube facade, view-transition names. It attaches motion.js after page load (never with reduced motion;
   motion.js then loads GSAP/ScrollTrigger — SplitText only for a below-the-fold [data-split] heading — and
   Lenis only on desktop) and map.js / course.js / search.js when the page has their hooks (Leaflet itself loads
   only near a map box, after load). #}
<script src="/assets/site.js" defer></script>
{% if site.ga4_id and mode == 'production' %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4_id }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ site.ga4_id }}');</script>
{% endif %}
{% if (site.ga4_id or site.gtm_id) and mode == 'production' %}<script src="/assets/track.js" defer></script>{% endif %}
{% if mode == 'production' %}<!-- Vercel Web Analytics -->
<script>
  window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
</script>
<script defer src="/_vercel/insights/script.js"></script>
{% endif %}
</head>
{% set ln = self.lnav()|trim %}
{% set bc = self.bodyclass()|trim %}
<body data-page-kind="{{ page_kind }}"{% if bc or ln %} class="{{ bc }}{% if ln %}{{ ' ' if bc }}has-lnav{% endif %}"{% endif %}>
{% if site.gtm_id and mode == 'production' %}<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtm_id }}"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
{% endif %}
{#- the site's symbol beside its name (site.json brand_symbol, a file in assets/brand/; operator 2026-10-16: 군산각's
    lighthouse-bookmark) — decorative: the name next to it is the link text -#}
{% set wm_sym %}{% if site.brand_symbol %}<span class="wm-sym" aria-hidden="true">{% include "assets/brand/" ~ site.brand_symbol %}</span>{% endif %}{% endset %}
{% if lang != 'ko' %}{{ enc.header(nav, nav_current, page_kind, langs, wordmark, t, loc, wm_sym, side|default(none)) }}{% else %}
<a class="skip-link" href="#main-content">본문 바로가기</a>
{% macro nav_links(stagger=false) -%}
{#- the courses entry keeps course_click on every page (the round-2 header '코스 보기' carried it; a page with a
    local bar now offers its own pill instead of that button) -#}
{% for label, href in nav %}<li{% if stagger %} style="--i:{{ loop.index0 }}"{% endif %}><a href="{{ href }}"{% if nav_current == href %} aria-current="page"{% endif %}{% if href == '/courses/' %} data-track="course_click"{% endif %}>{{ label }}</a></li>{% endfor %}
{%- endmacro %}
{# The header (operator 2026-10-31 '적용하자': the approved layout after travel.webforai.kr; css/80-side.css,
   templates/_side.html.j2). Before it: the skip link. The wordmark is site.json site_name (present.common_vm), with the
   brand small beside it only when it differs (CLAUDE.md 9).
   From 1200px the header is the tab panel at the left, a white rounded board that stays while the page scrolls and
   scrolls inside itself when taller than the window: the wordmark (with its line 'Suwongak · 수원 여행 정보'), the
   language menu, the site search (form.hs, always shown, works without JS), the day card (날씨 · 해 뜨고 지는 시각 ·
   다음 행사), the two actions and the tab groups (nav.side-nav '주 메뉴': 찾기 · 여행 계획 · 행사 달력 · 읽을거리 · 해외에서
   본 수원 · 소개·출처 — every link of the old bar's nav is in one of them). The page's group is open and its link
   aria-current. The content sits to the panel's right.
   Below 1200px the bar stays (52px phones / 60px from 1024px, sticky, in the flow): wordmark · AI 코스 · context button
   · 언어 · 검색 · 메뉴 (1024–1199px: the search field itself instead of 검색). Owner 2026-10-14 ('페이지 상단에는 검색,
   중앙 부분에는 AI챗봇으로 확실히 구분'): the site search lives here on every Korean page — form.hs (GET /search/?q=, the
   static search, search.js), its field 'hs-q' and a round search button; the assistant has no button here (it is the
   home's centre card and the launcher on every page, _chat.html.j2). Phones: '검색' is a link to /search/ (without JS:
   that page and its own field); with JS it opens the same form OVER the bar (field + close, site.js [data-hs-open]),
   so the fixed area stays the 52px bar (6% of a 390x844 screen, CLAUDE.md 7 ≤ 15%) and the context button keeps its
   place. On /search/ itself the page's own field is the search: the bar keeps only its 검색 link (the current page).
   The menu (a <details>: works without JS) holds the two actions, the same tab groups as the panel (two columns), the
   day card and the other versions. A page with a local bar (block lnav) lets the bar scroll away; its context action
   is then the local bar's pill. #}
{% set wm = wordmark or ((site.region or '') ~ ' 여행') %}
{% set sd = side|default(none) %}
{% set SG = sd.groups|side_state(nav_current) if sd else [] %}
<header class="mast" data-mast data-lenis-prevent>
  <div class="wrap mast-in">
    <a class="wordmark" href="/"{% if page_kind == 'home' %} aria-current="page"{% endif %}>{{ wm_sym }}<span class="wm-a">{{ wm|wordmark }}</span>{% if site.brand and site.brand != wm %}<span class="wm-b">{{ site.brand }}</span>{% endif %}{% if sd and sd.tagline %}<span class="wm-tag">{% if sd.latin %}<span lang="en">{{ sd.latin }}</span> · {% endif %}{{ sd.tagline }}</span>{% endif %}</a>
    {% if has_plan %}<a class="mast-plan" href="/plan/"{% if nav_current == '/plan/' %} aria-current="page"{% endif %} data-track="plan_cta">{{ ui.icon('spark', 'icon') }}<span>AI 코스</span></a>{% endif %}
    {% if has_videos %}<a class="mast-v" href="/videos/"{% if nav_current == '/videos/' %} aria-current="page"{% endif %}>영상</a>{% endif %}
    {% if ctxbtn and not ln %}<a class="mast-ctx" href="{{ ctxbtn[1] }}"{% if ctxbtn[1] == '/courses/' %} data-track="course_click"{% endif %}{% if ctxbtn[1] == '#list-map' %} data-show-map{% endif %}>{{ ctxbtn[0] }}</a>{% endif %}
    {% if langs %}{{ lg.menu(langs, '언어') }}{% endif %}
    {% if has_search %}{% set on_search = nav_current == '/search/' %}
    <a class="mast-search" href="/search/"{% if on_search %} aria-current="page"{% else %} data-hs-open{% endif %}>{{ ui.icon('search', 'icon') }}<span>검색</span></a>
    {% if not on_search %}<form class="hs" id="hs" action="/search/" method="get" role="search" data-hs>
      <label for="hs-q" class="vh">사이트 검색</label>
      <span class="hs-f"><input id="hs-q" name="q" type="search" maxlength="100" placeholder="장소·음식·지역 검색" autocomplete="off" enterkeyhint="search" spellcheck="false"><button type="submit" class="hs-go">{{ ui.icon('search', 'icon') }}<span class="vh">검색</span></button></span>
      <button type="button" class="hs-x" data-hs-close>{{ ui.icon('close', 'icon') }}<span class="vh">검색 닫기</span></button>
    </form>{% endif %}{% endif %}
    <details class="menu" data-menu>
      <summary><span class="vh">메뉴</span><i class="bars" aria-hidden="true"></i></summary>
      <nav class="menu-panel" aria-label="전체 메뉴">
        {% if sd %}{{ sdm.acts(sd.acts, nav_current) }}
        {{ sdm.groups(SG, nav_current, 'menu') }}
        {{ sdm.day(sd, 'menu') }}{% endif %}
        <ul class="menu-sub">{% if has_search %}<li><a href="/search/"{% if nav_current == '/search/' %} aria-current="page"{% endif %}>검색</a></li>{% endif %}{% if not sd %}<li><a href="/about/"{% if nav_current == '/about/' %} aria-current="page"{% endif %}>소개·출처</a></li>{% endif %}{{ lg.others(langs) }}</ul>
      </nav>
    </details>
  </div>
  {% if sd %}<div class="side">
    {{ sdm.day(sd, 'side') }}
    {{ sdm.acts(sd.acts, nav_current) }}
    <nav class="side-nav" aria-label="주 메뉴">{{ sdm.groups(SG, nav_current, 'side') }}</nav>
  </div>{% endif %}
</header>
{% endif %}
{{ ln }}
<main id="main-content" tabindex="-1" class="{% block main_class %}wrap{% endblock %}">
{% block content %}{% endblock %}
</main>
{% if banner %}<div class="banner" role="note">{{ banner }}</div>{% endif %}
{# Breadcrumbs at the top of the grey footer, the way apple.com does (the first screen belongs to the answer); the
   JSON-LD BreadcrumbList repeats exactly these names. A page may move them with {% block crumbs %}. #}
{% block crumbs %}{% if page.crumbs %}<div class="crumbs-bar"><div class="wrap">{% if lang != 'ko' %}{{ enc.crumbs(page.crumbs, t) }}{% else %}{{ ui.crumbs(page.crumbs) }}{% endif %}</div></div>{% endif %}{% endblock %}
{% if lang != 'ko' %}{{ enc.footer(nav, site, langs, wordmark, tourapi_used, t, loc, wm_sym) }}{% else %}
<footer class="foot">
  <div class="wrap">
    <div class="foot-in">
      <nav class="foot-col foot-nav" aria-label="둘러보기">
        <h2>둘러보기</h2>
        <ul>{{ nav_links() }}{% if has_search %}<li><a href="/search/">검색</a></li>{% endif %}</ul>
      </nav>
      <div class="foot-col">
        <h2>출처</h2>
        <ul class="foot-src">
          {% if site.source.name %}<li>원문 출처: {% if site.source.url %}<a href="{{ site.source.url }}" rel="noopener" data-track="official_click">{{ site.source.name }}</a>{% else %}{{ site.source.name }}{% endif %}</li>{% endif %}
          {% if tourapi_used %}<li>관광 정보·사진: 한국관광공사 TourAPI</li>{% endif %}
          <li>지도: © OpenStreetMap contributors</li>
        </ul>
      </div>
      <nav class="foot-col" aria-label="안내">
        <h2>안내</h2>
        <ul>{% if has_transport %}<li><a href="/transport/">{{ site.region }} 교통 시간표</a></li>{% endif %}{% if has_sun %}<li><a href="/sun/">{{ site.region }} 일출·일몰 시간</a></li>{% endif %}{% if has_videos %}<li><a href="/videos/">영상으로 보는 {{ site.region }}</a></li>{% endif %}{% if has_abroad %}<li><a href="/abroad/">해외에서 본 {{ site.region }}</a></li>{% endif %}<li><a href="/about/">소개·출처</a></li><li><a href="/about/#how">이 사이트를 만드는 방법</a></li><li><a href="/about/#correction">정정 요청</a></li><li><a href="/llms.txt">AI용 안내(llms.txt)</a></li><li><a href="/sitemap.xml">사이트맵</a></li>{{ lg.others(langs) }}</ul>
      </nav>
    </div>
    <div class="foot-id">
      <p class="foot-mark">{{ wm_sym }}<span class="wm-a">{{ wm|wordmark }}</span>{% if site.brand and site.brand != wm %}<span class="wm-b">{{ site.brand }}</span>{% endif %}</p>
      {%- set op = site.operator %}
      <p class="foot-op">운영: {% if op.logo %}<span class="op-logo" aria-hidden="true">{% include "assets/brand/aio2o-wordmark.svg" %}</span> {% endif %}{{ op.legal_name or op.name }}{% if op.name_en %}({{ op.name_en }}){% endif %}{% if site.editor and site.editor.name %} · {{ site.editor.role or '편집 책임' }} {{ site.editor.name }}{% endif %}{% if op.contact %} · 정정 요청 <a href="mailto:{{ op.contact }}">{{ op.contact }}</a>{% endif %}</p>
      {#- the company's official record (operator 2026-10-17 on the first site, the CEO's mail: 회사 주소·대표자·사업자등록번호를
          공식적으로) — site.json operator, from the business registration and the company's site; the whole record is on /about/ -#}
      {%- if op.business_no %}
      {%- set tel = op.tel|replace('-', '') %}
      <p class="foot-biz">{% if op.ceo %}<span>대표이사 {{ op.ceo }}</span>{% endif %}<span>사업자등록번호 {{ op.business_no }}</span>{% if op.corporate_no %}<span>법인등록번호 {{ op.corporate_no }}</span>{% endif %}{% if op.founded %}{% set fd = op.founded.split('-') %}<span>설립 {{ fd[0] }}년 {{ fd[1]|int }}월 {{ fd[2]|int }}일</span>{% endif %}</p>
      <p class="foot-biz foot-addr">{% if op.head_office %}<span>본사 {% if op.head_office_postal %}({{ op.head_office_postal }}) {% endif %}{{ op.head_office }}</span>{% endif %}{% if op.lab %}<span>연구소 {% if op.lab_postal %}({{ op.lab_postal }}) {% endif %}{{ op.lab }}</span>{% endif %}</p>
      <p class="foot-biz">{% if op.tel %}<span>대표전화 <a href="tel:{{ tel }}">{{ op.tel }}</a></span>{% endif %}{% if op.email %}<span>이메일 <a href="mailto:{{ op.email }}">{{ op.email }}</a></span>{% endif %}{% if op.url %}<span>회사 누리집 <a href="{{ op.url }}" rel="noopener">{{ op.url|replace('https://', '')|replace('http://', '')|trim('/') }}</a></span>{% endif %}<span><a href="/about/#company">회사 정보 자세히</a></span></p>
      <p class="foot-copy">Copyright © {{ op.legal_name or op.name }}. 사진과 원문 자료의 권리는 각 출처에 있습니다.</p>
      {%- endif %}
    </div>
  </div>
</footer>
{% endif %}
{# the site assistant's launcher, the last thing in <body> on every page (_chat.html.j2; the chat loads on its press) #}
{% include "_chat.html.j2" %}
</body>
</html>
{% if false %}{% block lnav %}{% endblock %}{% block bodyclass %}{% endblock %}{% endif %}
