{% extends "base.html.j2" %}
{% import "_art.html.j2" as artm %}
{% import "_courses.html.j2" as cc %}
{#- /courses/: the courses by length (당일 · 1박 2일 · 2박 3일), then by theme, each as a card (operator
    2026-10-31, from the first site; templates/_courses.html.j2, css/79-courses.css): one stop's photo, the chip,
    the name, the route band, the areas, the figures and the source. CV = present.course_index_vm (group ids from
    present.course_groups_vm). The eyebrow and lede say '공식' only for an official source (course_src). -#}
{% block bodyclass %}pg-courses{% endblock %}
{% block main_class %}{% endblock %}
{% block content %}
<section class="pg-hero band-s" aria-labelledby="h-list">{{ artm.band((art_slots or {}).get('list.head.courses')) }}
  <div class="wrap">
    {% if course_src.label %}<p class="eyebrow">{{ course_src.label }}</p>{% endif %}
    <h1 id="h-list" class="h-list">{{ site.region }} 여행 코스 <span class="count tn">{{ n_courses }}개</span></h1>
    <p class="list-lede">경유지를 {{ '공식 ' if course_src.official }}코스 순서대로 적고 장소 페이지로 연결했습니다. 카드의 직선 합은 장소 좌표 사이 직선거리의 합이고(좌표 출처는 코스마다 표시), 경유지 좌표가 다 있을 때만 적었습니다.</p>
    {% if CV.groups|length > 1 %}{{ cc.nav(CV.groups, CV.w.nav) }}{% endif %}
  </div>
</section>
{% if has_plan %}{% import "_plan_cta.html.j2" as pc %}<div class="wrap">{{ pc.banner(site.region, 'courses') }}</div>{% endif %}
<div class="wrap cc-wrap">
  {% for g in CV.groups %}{{ cc.group(g) }}{% endfor %}
  {{ cc.notes(CV, '/map/', '권역을 나눈 기준 보기') }}
</div>
{% endblock %}
