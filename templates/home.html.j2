{% extends "base.html.j2" %}
{% block sheets %}<link rel="stylesheet" href="/assets/page-home.css">{% endblock %}
{% import "_p2.html.j2" as p2 %}
{% import "_p1.html.j2" as p1 %}
{% import "_media.html.j2" as md %}
{% import "_art.html.j2" as artm %}
{% import "_ask.html.j2" as askm %}
{% import "_pic.html.j2" as pk %}
{% import "_abroad.html.j2" as ab %}
{% import "_side.html.j2" as sdm %}
{% import "_mz.html.j2" as mz %}
{#- The home page (시안 A, the first site's 2026-11-02~05 home ported 2026-11-05 — operator '군산각에 맞춰서 업그레이드'):
    the first screen is one card over the opening photo (site.json home.media.cover, KOGL-1) — the H1, the lede, the big
    site search, the four core lists (관광지 · 음식점 · 숙소 · 코스) and 내 일정 만들기 —, then the pinned event's banner
    (events.json pin_home, present.home_fest; none without one), the first 권역 / 구·군's food row (present.home_food_row,
    '추천 순서가 아닙니다'), the AI assistant card with the 3D icon menu (_ask.html.j2, present.home_services), the news
    row (present.home_news, a scroll-snap carousel: site.js [data-hcar]) and 날씨각's card. Below: 목적별 가이드 (card-news
    tiles, present.home_tiles, and the guide groups' tabs) → 대표 장소 (feed cards, _mz.html.j2 feed) → 다가오는 행사 (D-day
    tickets) → SNS (post cards topped by the place they show, present.home_posts) → 여행 권역 / 구·군 (cityv.region_label)
    → 이야기 (site.json home.story) → 갤러리 (home.gallery) → 코스 ('공식' only when the courses' source is official:
    course_src) → 영상 → 공식 안내. No blog section (this city has none) and no 숙박 예약하기 (no booking page) —
    operator 2026-11-05. Every figure comes from present.home_vm (h) or the list counts; the city's words from cityv /
    site.json; a section whose data or configuration is missing is left out. Nothing on the first screen starts
    hidden; KOGL-3 photos are never cropped (CLAUDE.md 3.4). -#}
{#- the news card's picture: the big card from 768px; below it the compact card's 88px thumbnail (css/46-home-open.css)
    — so the first slide is preloaded only where it is big (SLIDE_MEDIA): on a phone it is a small eager image and the
    opening's cover photo keeps the bandwidth -#}
{% set SLIDE_SIZES = '(min-width: 1200px) calc(50vw - 160px), (min-width: 1024px) 640px, (min-width: 768px) calc(100vw - 32px), 88px' %}
{% set SLIDE_MEDIA = '(min-width: 768px)' %}
{% block bodyclass %}pg-home pg-ko-home pg-h4{% if ask_starters is defined and ask_starters is not none %} has-ask{% endif %}{% endblock %}
{% block main_class %}{% endblock %}
{#- 시안 A with the opening photo (the first site's 48f2a64c9; this city's photo: site.json home.media.cover): the card's
    KOGL-1 photo is the first screen's LCP candidate, a local AVIF derivative, preloaded -#}
{% block head %}{% if h.cover and h.cover.type == 1 and h.cover.avif %}{{ md.preload(h.cover, '(min-width: 1200px) calc(100vw - 360px), 100vw') }}{% endif %}{% endblock %}
{% block content %}
{% set T = namespace(i=0) %}
{% set N = h.news|length %}
{% set ASK = ask_starters is defined and ask_starters is not none %}
<div class="hk"{% if ASK %} data-chat-dock{% endif %}>
{#- 시안 A (the first site's c4020e9bd · 48f2a64c9 · 51a88a413, operator 2026-11-05; css/87-design-a.css): a card in
    the middle over the opening photo (h.cover: site.json home.media.cover, KOGL-1, cropped to the card, a navy scrim,
    the credit at the bottom right; without one a white card) — the H1 with '모든 것' in the sea blue, the lede, the site
    search (the header's on phones, the side panel's from 1024px, here big), the four core lists with their pictures
    (no counts) and 내 일정 만들기 (no 숙박 예약하기: this city has no booking page, operator 2026-11-05 '제휴링크는
    일단 제외하자'). Under it the pinned event as a wide banner (only while events.json pins one) and its guides; the
    food row, the assistant, the news row and the rest follow. Nothing starts hidden; the photo is the LCP candidate,
    a local AVIF derivative, preloaded. -#}
{% set TILES = [('/places/', '관광지', 'a'), ('/food/', '음식점', 'f'), ('/stays/', '숙소', 's'), ('/courses/', '코스', 'c')] %}
{% set cv = h.cover if h.cover and h.cover.type == 1 and h.cover.avif else none %}
<section class="ha" aria-labelledby="h-home">
  <div class="wrap"><div class="ha-card{{ ' ha-ph' if cv }}">
    {% if cv %}<div class="ha-bg" aria-hidden="true">{{ md.picture(cv, '(min-width: 1200px) calc(100vw - 360px), 100vw', true, 'ha-bg-img', false, true) }}</div>{% endif %}
    <h1 id="h-home" class="op-h1 ha-h1">{% if site.region %}{{ site.region }} 여행의 <span class="ha-em">모든 것</span>{% else %}{{ site.site_name }}{% endif %}</h1>
    <p class="ha-lede">관광지·음식점·숙소의 여는 시간과 요금, 가는 길을 한곳에 모았습니다.</p>
    <form class="ha-search" action="/search/" method="get" role="search">
      <label class="vh" for="ha-q">장소·음식·지역 검색</label>
      {{ ui.icon('search', 'icon ha-s-ic') }}
      <input id="ha-q" name="q" type="search" placeholder="{{ h.search_hint or '장소·음식·지역 이름으로 찾아보세요' }}" autocomplete="off" enterkeyhint="search">
      <button type="submit">검색</button>
    </form>
    {% set svc = {} %}{% for s in h.services %}{% set _ = svc.update({s.href: s}) %}{% endfor %}
    <ul class="ha-tiles">{% for href, lab, k in TILES %}{% set s = svc.get(href) %}{% if s %}<li><a class="ha-tile ha-{{ k }}" href="{{ href }}"{% if s.track %} data-track="{{ s.track }}"{% endif %}>{{ pk.pic(s.pic, s.icon, 52) }}<span class="ha-tl">{{ lab }}</span></a></li>{% elif href == '/courses/' and courses %}<li><a class="ha-tile ha-{{ k }}" href="{{ href }}" data-track="course_click">{{ pk.pic('icon-course', 'route', 52) }}<span class="ha-tl">{{ lab }}</span></a></li>{% endif %}{% endfor %}</ul>
    <p class="ha-cta">{% if has_plan %}<a class="ha-btn ha-plan" href="/plan/" data-track="plan_cta">{{ pk.pic('btn-plan', 'spark', 28) }}<span>내 일정 만들기</span></a>{% endif %}{% if courses %}<a class="ha-btn ha-co" href="/courses/" data-track="course_click"><span>{{ '공식 코스 보기' if course_src.official else (site.region or site.locality) ~ ' 추천 코스' }}</span></a>{% endif %}</p>
    {% if cv %}<p class="ha-cap">사진 {% if cv.path %}<a href="{{ cv.path }}">{{ cv.place or cv.name }}</a>{% else %}{{ cv.place or cv.name }}{% endif %} · {{ md.credit(cv) }}</p>{% endif %}
  </div></div>
</section>
{#- the pinned event (events.json pin_home, present.home_fest; the first site's cf4ebcd8a): a wide banner — the D-day
    recounted in the browser, the name, day · time · place, the programme lines the record names, the event page and
    the source; the guides the record names as cards. Only while an edition is pinned and not over; nothing else. -#}
{% if h.fest %}{% set F = h.fest %}
<section class="ha-fest" aria-labelledby="h-fw">
  <div class="wrap">
    <div class="haf">
      <div class="haf-t">
        <p class="haf-dd"><b class="tn" data-dday="{{ F.r.start }}" data-dday-end="{{ F.r.last }}">{% if F.r.days > 0 %}D-{{ F.r.days }}{% elif F.r.days == 0 %}D-DAY{% else %}진행 중{% endif %}</b></p>
        <h2 id="h-fw" class="haf-h">{{ F.h }}{% if F.sub %} <span class="haf-sub">{{ F.sub }}</span>{% endif %}</h2>
        <p class="haf-m"><time datetime="{{ F.start_dt }}">{{ F.when }}{% if F.time %} {{ F.time }}{% endif %}</time>{% if F.r.place %}<br>{{ F.r.place }}{% endif %}</p>
        {% if F.points %}<ul class="haf-pts">{% for x in F.points %}<li><b>{{ x.t }}</b>{% if x.d %}<span>{{ x.d }}</span>{% endif %}</li>{% endfor %}</ul>{% endif %}
        <p class="haf-cta">{% if F.r.path %}<a class="haf-btn haf-go" href="{{ F.r.path }}" data-track="fest_click">행사 정보 보기</a>{% elif F.r.source_url %}<a class="haf-btn haf-go" href="{{ F.r.source_url }}" rel="noopener" data-track="official_click">행사 정보 보기</a>{% endif %}</p>
        {% if F.src %}<p class="haf-cr">출처: {{ F.src }}</p>{% endif %}
      </div>
    </div>
    {% if F.series %}<ul class="ha-guides">{% for x in F.series %}<li><a href="{{ x.path }}" data-track="guide_click"><span class="hag-k">가이드</span><b class="hag-t">{{ x.label }}</b><span class="hag-q">{{ x.q }}</span></a></li>{% endfor %}</ul>{% endif %}
  </div>
</section>
{% endif %}
{#- the white card: the AI assistant (_ask.html.j2 box: its head, one question box with one button '물어보기', the '#'
    tags — the site search is the header's, owner 2026-10-14), then the 3D icon menu of the service links. The menu has
    no '물어보기' item any more: the card right above it IS the assistant and the launcher is on screen too, so a third
    door to the same chat would only bring back the doubt the owner pointed at. Without the assistant (no ask.json)
    the card keeps the menu only: the search is in the header. -#}
{% if h.food_row and h.food_row.recs %}{% set FR = h.food_row %}
<section class="ha-food" aria-labelledby="h-hfood">
  <div class="wrap"><div class="hfo">
    <div class="hfo-head"><h2 id="h-hfood" class="hfo-h">{{ FR.group }} 음식점</h2><a class="hfo-all" href="/food/" data-track="food_click">전체 <span class="tn">{{ FR.total }}</span>곳 보기</a></div>
    <ul class="hfo-row">{% for r in FR.recs %}<li><a href="{{ r.path }}" data-track="food_click" data-place="{{ r.e.id }}">
      <span class="hfo-ph{% if r.photo %} t{{ r.photo.type }}{% else %} hfo-ic{% endif %}">{% if r.photo %}<img class="t{{ r.photo.type }}" src="{{ r.photo.url }}"{% if r.photo.w and r.photo.h %} width="{{ r.photo.w }}" height="{{ r.photo.h }}"{% endif %} alt="" loading="lazy" decoding="async" data-kogl="{{ r.photo.type }}">{% else %}{{ ui.type_icon(r.e, 64) }}{% endif %}</span>
      <span class="hfo-nm"><b>{{ r.name }}</b>{{ p1.dzchip(r.dz) }}</span>
      <span class="hfo-l">{% if r.menu %}<b>{{ r.menu }}</b>{% endif %}{% if r.hours %}{% if r.menu %} · {% endif %}<span class="tn">{{ r.hours }}</span>{% endif %}{% if r.closed %} · <span class="{{ 'hfo-cl' if r.is_closed else '' }}">{{ r.closed }}</span>{% endif %}</span>
    </a></li>{% endfor %}</ul>
    <p class="hfo-note">사진이 있는 곳부터 · 추천 순서가 아닙니다{% if FR.lics %} · 사진: 한국관광공사 · 공공누리 제{{ FR.lics|join('·') }}유형{% endif %}</p>
  </div></div>
</section>
{% endif %}
{% if ASK or h.services %}
<section class="hq"{% if ASK %} aria-labelledby="h-ask"{% endif %}>
  <div class="wrap"><div class="hq-card{{ ' hq-menu-only' if not ASK }}">
    {% if ASK %}{{ askm.box(ask_starters, site.region) }}{% endif %}
    {% if h.services %}
    <nav class="hq-menu" aria-label="{{ site.region }} 여행 바로가기">
      <ul class="hq-row" style="--core:{{ h.services|selectattr('core')|list|length or 4 }}">
        {% for s in h.services %}<li class="{{ 'hq-core' if s.core else 'hq-more' }}"><a class="hq-i" href="{{ s.href }}"{% if s.track %} data-track="{{ s.track }}"{% endif %}>{{ pk.pic(s.pic, s.icon, 56) }}<span class="hq-l">{{ s.label }}</span>{% if s.n %}<span class="hq-n tn">{{ s.n }}{{ s.unit }}</span>{% endif %}</a></li>{% endfor %}
      </ul>
    </nav>
    {% endif %}
  </div></div>
</section>
{% endif %}
{% if ASK %}{{ askm.panel() }}{% endif %}
{% if N %}
<section class="hn" aria-labelledby="h-news">
  <div class="wrap">
    <h2 id="h-news" class="hn-h">지금 {{ site.region }} 소식</h2>
    <div class="hn-in" data-hcar aria-roledescription="carousel" aria-label="지금 {{ site.region }} 소식">
    {% if N %}
    <div class="ho-news">
      <div class="hv-view" data-hcar-view>
        <div class="hv-track" id="hv-track">
          {% for c in h.news %}
          <article class="nc nc-{{ c.kind }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ N }}" data-hcar-item>
            <div class="nc-frame{% if c.photo %} t{{ c.photo.type }}{% elif c.og %} nc-ogf{% elif c.art %} nc-artf{% else %} nc-icof{% endif %}">
              {%- if c.photo %}{{ ui.img(c.photo, SLIDE_SIZES, false, 'nc-img', false, false) }}
              {%- elif c.og %}<img class="nc-og" src="{{ c.og }}" alt="" width="600" height="315" loading="lazy" decoding="async" referrerpolicy="no-referrer">
              {%- elif c.art %}{{ artm.figure(c.art, 'ko', SLIDE_SIZES, false, 'nc-art', false, false) }}
              {%- else %}{{ pk.pic({'event': 'icon-events', 'festival': 'icon-events', 'video': 'icon-video', 'abroad': 'icon-abroad', 'guide': 'guide'}.get(c.kind, 'icon-events'), c.icon, 120) }}{% endif %}</div>
            <div class="nc-body">
              <p class="nc-chips"><span class="nc-chip">{{ c.chip }}</span>{% if c.status %}<span class="nc-st">{{ c.status }}</span>{% endif %}</p>
              <h3 class="nc-t"><a href="{{ c.href }}"{% if c.ext %} rel="noopener"{% endif %}{% if c.lang %} lang="{{ c.lang }}"{% endif %}{% if c.track %} data-track="{{ c.track }}"{% endif %}>{{ c.title }}{% if c.ext %}<span class="nc-x" aria-hidden="true">↗</span>{% endif %}</a></h3>
              {% if c.when or c.sub %}<p class="nc-meta">{% if c.when %}<time datetime="{{ c.when_iso }}" class="tn">{{ c.when }}</time>{% endif %}{% if c.when and c.sub %}<span aria-hidden="true"> · </span>{% endif %}{% if c.sub %}<span>{{ c.sub }}</span>{% endif %}</p>{% endif %}
              {% if c.photo %}<p class="nc-cr">사진 {{ c.photo.place }} · {{ md.credit(c.photo) }}</p>{% elif c.og %}<p class="nc-cr">사진: {{ c.outlet }} 미리보기 이미지</p>{% elif c.art %}<p class="nc-cr">{{ ART_CARD_NOTE.ko }}</p>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
      {% if N > 1 %}<div class="ho-ctl">
        <div class="hv-ctl">
          <button type="button" class="hv-c hv-pause" data-hcar-pause aria-label="소식 자동 넘김 멈추기" data-label-play="소식 자동 넘김 시작" data-label-pause="소식 자동 넘김 멈추기">{{ ui.icon('pause', 'icon i-pause') }}{{ ui.icon('resume', 'icon i-play') }}</button>
          <button type="button" class="hv-c" data-hcar-dir="-1" aria-controls="hv-track" aria-label="이전 소식">{{ ui.icon('prev') }}</button>
          <p class="hv-count tn" data-hcar-count aria-live="off"><span class="vh">소식 </span><span data-hcar-cur>1</span> / {{ N }}</p>
          <button type="button" class="hv-c" data-hcar-dir="1" aria-controls="hv-track" aria-label="다음 소식">{{ ui.icon('next') }}</button>
          <span class="hv-prog" aria-hidden="true"><i data-hcar-prog></i></span>
        </div>
        {% if has_events %}<a class="ho-all" href="/events/">소식 전체<span class="arr" aria-hidden="true">→</span></a>{% endif %}
      </div>{% endif %}
    </div>
  </div>
</section>
{% endif %}
</div>
{#- 날씨각's weather module (operator 2026-10-31), under the first screen: the same small module as the panel's
    (templates/_side.html.j2 weather; its values come in the browser after load — none in this HTML) -#}
{% if side and side.wx %}<div class="wrap hwx">{{ sdm.weather(side.wx, 'home') }}</div>{% endif %}

{# 목적별 가이드 (operator 2026-11-02, _mz.html.j2 tile): card-news tiles — the answers (figures checked against each
   guide's own text) on a place's KOGL-1 photo or a colour — and every guide in its group behind one tab per group #}
{% if h.answers %}
{% set T.i = T.i + 1 %}
<section class="sec sec-ans sec-mz{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-ans">
  <div class="wrap">{{ ui.sec_head('목적별 가이드', '취향대로 고르는 ' ~ site.region ~ ' 총정리', 'h-ans', '/guides/' if h.guides else '', '가이드 ' ~ h.guides|length ~ '편 모두' if h.guides else '') }}</div>
  <div class="car car-mzt" data-gallery>
    <div class="car-view" data-gal-view><ol class="mzts car-track">{% for a in h.answers %}{{ mz.tile(a) }}{% endfor %}</ol></div>
    <div class="wrap car-foot">{{ ui.carnav('가이드') }}</div>
  </div>
  {#- every guide, in groups read off the guides (present.guide_groups): one tab per group (its name and count), its
      guides as #chips; without JS every group shows with its heading (site.js [data-tabs]) -#}
  {% if h.guide_groups %}<div class="wrap"><div class="gtab" data-tabs>
    <p class="gtab-l">주제로 찾기</p>
    <div class="gtab-bar" role="tablist" aria-label="가이드 묶음">{% for grp in h.guide_groups %}<button type="button" role="tab" id="gtab-{{ loop.index }}" aria-controls="gtab-p{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ grp.name }}<span class="tn">{{ grp.guides|length }}편</span></button>{% endfor %}</div>
    {% for grp in h.guide_groups %}<div class="gtab-p" role="tabpanel" id="gtab-p{{ loop.index }}" aria-labelledby="gtab-{{ loop.index }}"{% if not loop.first %} data-tab-off{% endif %}><h3 class="gtab-h">{{ grp.name }} <span class="tn">{{ grp.guides|length }}편</span></h3><ul class="gtab-list">{% for g in grp.guides %}<li><a href="{{ g._path }}" data-track="guide_click"><span aria-hidden="true">#</span>{{ g.label or g.title }}</a></li>{% endfor %}</ul></div>{% endfor %}
  </div></div>{% endif %}
</section>
{% endif %}

{# 대표 장소: a stated rule (the attractions on most official courses); without such places, the first attractions with
   photos and visit information; without any place, the honest empty state #}
{% set T.i = T.i + 1 %}
{% if h.featured %}
<section class="sec sec-feat sec-mz{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap">{{ ui.sec_head(('공식 ' if course_src.official else '') ~ ('코스에 가장 많이 든 곳' if h.featured_min > 1 else '코스가 지나는 곳'), ('공식 ' if course_src.official else '') ~ '코스 단골 ' ~ h.featured|length ~ '곳', 'h-feat', '', '', (course_src.label or '코스') ~ ' ' ~ n_courses ~ '개 가운데 ' ~ h.featured_min ~ '개 이상에 들어 있는 관광지' ~ (' · 여러 코스에 든 곳부터' if h.featured_min == 1 and h.featured|length > 1 and h.featured[0].n_courses > 1 else '')) }}</div>
  <div class="car car-fp" data-gallery>
    <div class="car-view" data-gal-view><ol class="fps car-track">{% for c in h.featured %}<li>{{ mz.feed(c) }}</li>{% endfor %}</ol></div>
    <div class="wrap car-foot">{{ ui.carnav('장소') }}</div>
  </div>
</section>
{% elif featured %}
<section class="sec sec-feat{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap">{{ ui.sec_head('관광지', '사진이 있는 관광지', 'h-feat', '/places/', '관광지 ' ~ counts.attraction ~ '곳 모두') }}</div>{# not '대표': no rule picks them (featured: photographed first, list order) #}
  <div class="car car-feat" data-gallery>
    <div class="car-view" data-gal-view><ol class="cards cards-4 car-track">{% for e in featured[:4] %}<li>{{ ui.card(card_vm(e)) }}</li>{% endfor %}</ol></div>
    <div class="wrap car-foot">{{ ui.carnav('장소') }}</div>
  </div>
</section>
{% else %}
<section class="sec sec-feat p2-empty{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap">
    {{ ui.sec_head('먼저 볼 곳', '여행지 안내를 준비하고 있습니다', 'h-feat') }}
    {% set src = site.source if site.source and site.source.url and site.source.name else (site.official_links[0] if site.official_links else none) %}
    <p class="p2-empty-t">방문 정보를 확인한 장소부터 안내합니다.{% if src %} 지금은 {{ '출처 사이트' if src is sameas site.source else '공식 안내' }}에서 확인하세요.{% endif %}</p>
    {% if src %}<p><a class="btn btn-ol" href="{{ src.url }}" rel="noopener" data-track="official_click">{{ src.name }}에서 확인</a></p>{% endif %}
  </div>
</section>
{% endif %}

{# 다가오는 행사: dated tiles ranked today → tomorrow → this week → running (present.ranked_events) #}
{% if has_events %}
{% set T.i = T.i + 1 %}
<section class="sec evband sec-mz{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-ev">
  <div class="wrap">
    {{ ui.sec_head('행사·축제', '캘린더에 찜해 둘 행사', 'h-ev', '/events/', ('진행·예정 ' ~ h.n_upcoming ~ '건 · 전체 일정') if h.n_upcoming else '행사 일정 모두') }}
    {% if h.events_ranked %}<ol class="tkts">{% for r in h.events_ranked %}{{ mz.ticket(r, loop.index0) }}{% endfor %}</ol>
    {% else %}<p class="p2-none">진행 중이거나 일정이 발표된 행사가 없습니다. <a href="/events/">해마다 열리는 행사와 지난 회차</a></p>{% endif %}
  </div>
</section>
{% endif %}

{# SNS에서 본 <region> (owner 2026-10-14: 'SNS 게시물이 좀 더 잘 보이면 좋겠는데 지금은 너무 구석에'): the newest posts as our
   own cards — the service's mark, the service · account, our one-line note, the date — each to its card on /abroad/
   (the official embed is there); nothing loads from the services on the home. A row that scrolls sideways on phones,
   2 columns from 700px, 4 from 1024px (css/48-abroad.css .hsns). #}
{% if home_posts %}
{% set T.i = T.i + 1 %}
<section class="sec sec-sns sec-mz{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-sns">
  <div class="wrap">
    {{ ui.sec_head('해외에서 본 ' ~ site.region, '해외 피드에 뜬 ' ~ site.region, 'h-sns', '/abroad/#ab-sns', 'SNS 게시물 ' ~ n_posts ~ '개 모두') }}
    <ul class="hsns">{% for a in home_posts %}{{ mz.sns(a, loop.index0) }}{% endfor %}</ul>
    <p class="note hsns-note">원문 문장과 게시물 사진은 옮기지 않습니다. 카드 위 사진은 게시물에 나온 장소의 사진(한국관광공사)이고, 나온 장소의 사진이 없으면 장소 이름이나 게시물의 언어를 적습니다. 게시물은 각 서비스의 공식 임베드로 엽니다.</p>
  </div>
</section>
{% endif %}

{# 여행 권역 / 구·군: counts by group (cityv.region_label), the rule that drew them; in anchors mode the anchors on a
   small map — district mode has no map (a 구·군 office's coordinates would be a new fact, design 3.4) #}
{% if h.regions2 %}
{% set T.i = T.i + 1 %}
{% set anchored = h.regions2|selectattr('anchor')|list %}
<section class="sec sec-reg{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-reg">
  <div class="wrap">
    {{ ui.sec_head('어디에 묵고 어디를 볼까', cityv.region_label ~ '별로 보는 ' ~ site.region, 'h-reg', '/map/', cityv.region_label ~ '·' ~ cityv.area_label ~ ' 지도') }}
    <div class="reg-grid{% if not h.region_map %} reg-one{% endif %}">
      <div class="reg-main">
        <ol class="regs">
          {% for r in h.regions2 %}
          <li><a href="/map/#{{ r.id }}"><span class="rg-name">{{ r.name }}</span><span class="rg-n"><b class="num tn">{{ r.n }}</b><small>곳</small></span><span class="rg-k tn">관광지 {{ r.k.attraction or 0 }} · 숙소 {{ r.k.stay or 0 }} · 음식점 {{ r.k.food or 0 }}</span>{% if r.dongs %}<span class="rg-d">{{ r.dongs|join('·') }}</span>{% endif %}<span class="arr" aria-hidden="true">›</span></a></li>
          {% endfor %}
        </ol>
        {% if cityv.region_mode == 'anchors' and anchored %}<p class="rule-note">{{ cityv.region_label|josa('은/는') }} 기준점 {{ anchored|length }}곳({% for r in anchored %}{{ r.anchor.place }}{% if not loop.last %}·{% endif %}{% endfor %}) 가운데 직선거리로 가장 가까운 곳으로 묶었습니다.</p>
        {% else %}<p class="rule-note">주소에 적힌 {{ cityv.region_label|josa('으로/로') }} 묶었습니다. 주소에 {{ cityv.region_label|josa('이/가') }} 없으면 ‘{{ cityv.none_label }}’에 둡니다.</p>{% endif %}
      </div>
      {% if h.region_map %}{{ ui.mapfig(h.region_map, site.region ~ ' 여행 ' ~ cityv.region_label ~ ' 기준점 지도', 'reg-map', cityv.region_label ~ ' 기준점 ' ~ anchored|length ~ '곳') }}{% endif %}
    </div>
  </div>
</section>
{% endif %}

{# 이야기 (site.json home.story) — the page's one black section, also the accent black band (owner 2026-10-09): the
   oversized word over a hairline and the eyebrow as a lime pill. Desktop with motion: a CSS sticky stage (motion.js
   story); phones, reduced motion and no JS: dark tiles in DOM order. Every sentence is a place summary sentence
   (present.home_story). #}
{% if h.chapters %}
{% set y0 = h.chapters[0].big %}
<section class="story" data-story aria-labelledby="h-story">
  <div class="st-stage" data-stage>
    <div class="st-grid">
      <header class="st-head wrap">
        <p class="eyebrow pill-l"><span>{{ site.region }} 이야기</span></p>
        <h2 id="h-story" class="h2" data-split>{% if y0 is string and y0.isdigit() %}{{ y0 }}년부터 오늘까지{% else %}오늘의 {{ site.region }}{% endif %}</h2>
      </header>
      <p class="st-big" aria-hidden="true"><span class="num" data-roll>{{ y0 }}</span></p>
      <ol class="st-chs" data-n="{{ h.chapters|length }}">
        {% for c in h.chapters %}
        <li class="st-ch{% if loop.first %} is-on{% endif %}" id="{{ c.id }}" data-ch>
          {% if c.photo %}
          <figure class="st-ph t{{ c.photo.type }}" data-reveal-ph>
            <div class="st-frame">{{ ui.img(c.photo, '(min-width: 1024px) 940px, 300px', false, 'st-img') }}</div>
            <figcaption class="st-cap">{{ c.photo.place or c.photo.name }} · {{ md.credit(c.photo) }}</figcaption>
          </figure>
          {% endif %}
          <div class="st-text">
            <p class="st-year"><span class="num tn">{{ c.big }}</span>{% if c.kicker != c.big %}<span class="st-k">{{ c.kicker }}</span>{% endif %}</p>
            <h3 class="st-title">{{ c.title }}</h3>
            {% for t in c.text %}<p class="st-p">{{ t }}</p>{% endfor %}
            {% if c.steps %}<ol class="st-steps">{% for it in c.steps %}<li><span class="num tn">{{ it.y }}</span><div><a href="{{ it.path }}">{{ it.name }}</a><p>{{ it.text }}</p></div></li>{% endfor %}</ol>{% endif %}
            {% if c.figs %}<dl class="st-figs">{% for f in c.figs %}<div><dt>{{ f.label }}</dt><dd><span class="num tn" data-roll-fig>{{ f.n }}</span><small>{{ f.unit }}</small></dd></div>{% endfor %}</dl>{% endif %}
            {% if c.src %}<p class="ch-cite">근거: {% for name, path in c.src %}<a href="{{ path }}">{{ name }}</a>{% if not loop.last %} · {% endif %}{% endfor %} 장소 정보{% if c.figs %} · {% if c.geo_src %}{{ c.geo_src }} {% endif %}좌표 사이 직선{% endif %}</p>{% elif c.figs %}<p class="ch-cite">근거: {% if c.geo_src %}{{ c.geo_src }} {% endif %}좌표 사이 직선</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
      <ol class="st-rail" aria-label="이야기 순서" data-rail>{% for c in h.chapters %}<li><button type="button" data-go="{{ loop.index0 }}"{% if loop.first %} aria-current="step"{% endif %}><span class="num tn">{{ c.big }}</span>{% if c.kicker != c.big %} {{ c.kicker }}{% endif %}</button></li>{% endfor %}</ol>
    </div>
  </div>
</section>
{% endif %}

{# 갤러리 (site.json home.gallery {eyebrow, title, region} + home.media.gallery): an Apple carousel of place cards —
   KOGL-1 covers drift inside their frames, KOGL-3 stays whole. The distance is computed (home.center → home.far). #}
{% if h.gallery and h.gallery_cfg %}
{% set T.i = T.i + 1 %}
{% set gf = h.gallery_fact %}
<section class="gallery{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-isl" data-gallery>
  <div class="wrap gal-head">
    {{ ui.sec_head(h.gallery_cfg.eyebrow or '', (h.gallery_cfg.title or '').rstrip('.'), 'h-isl', '', '', '', true) }}
    {% if gf.km or (gf.region and gf.n) %}<p class="gal-fact">{% if gf.km %}{{ gf.from }}에서 {{ gf.to }}까지 직선 <b class="tn">{{ gf.km }}km</b>{% if gf.region and gf.n %} · {% endif %}{% endif %}{% if gf.region and gf.n %}{{ gf.region }}{% if cityv.region_mode != 'district' %} {{ cityv.region_label }}{% endif %} 관광지 <b class="tn">{{ gf.n }}곳</b>{% endif %}</p>{% endif %}
  </div>
  <div class="car-view" data-gal-view>
    <ol class="gal-track car-track">
      {% for c in h.gallery %}<li>{{ ui.card(c, '', '(min-width: 1024px) 360px, 300px') }}</li>{% endfor %}
      {% if gf.region and gf.n %}<li class="gal-all"><a href="/places/?region={{ gf.region|urlencode }}">{{ gf.region }}{% if cityv.region_mode != 'district' %} {{ cityv.region_label }}{% endif %} 관광지 <span class="tn">{{ gf.n }}</span>곳 모두<span class="arr" aria-hidden="true">›</span></a></li>{% endif %}
    </ol>
  </div>
  <div class="wrap car-foot">{{ ui.carnav('장소') }}</div>
</section>
{% endif %}

{# 코스: the first three 당일 lines (or the first three lines) by their stops, and one of them on the map (present.course_map;
   map.js fetches Leaflet near the screen, after load). '공식' only when the courses' source is an official
   site (course_src). #}
{% if courses %}
{% set T.i = T.i + 1 %}
{% set lines = (h.day_lines or h.lines)[:3] %}
<section class="sec sec-co{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-co">
  <div class="wrap">
    {{ p2.sec_head((course_src.name ~ (' 공식' if course_src.official else '')) if course_src.name else '여행 코스', ('순서대로 따라가는 당일 코스' if h.day_lines else ('순서대로 따라가는 ' ~ ('공식 ' if course_src.official else '') ~ '코스')), 'h-co', '/courses/', '코스 ' ~ n_courses ~ '개 모두', '', false, 'course_click') }}
    {% set tm = h.teaser.map if h.teaser else none %}
    <div class="co-grid2{% if not tm %} p2-co-one{% endif %}">
      <ol class="lines lines-home">
        {% for c in lines %}
        <li class="line-row">
          <span class="line-dur">{{ c.code or c.duration or c.group }}</span>
          <a class="line-name" href="{{ c.path }}" data-track="course_click"><span class="ln-t">{{ c.title or c.display }}</span></a>
          {{ ui.stoprow(c.stops, (c.title or c.display) ~ ' 경유지 순서') }}
          {{ ui.linemeta(c) }}
        </li>
        {% endfor %}
      </ol>
      {% if tm %}{% set cv = h.teaser.cv %}
      <div class="co-teaser">
        <p class="cm-title"><span class="cm-k">지도</span><a href="{{ cv.path }}" data-track="course_click">{{ cv.display }}</a></p>
        {{ ui.coursemap(tm, cv.display ~ ' 경유지 지도') }}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{# 영상으로 보는 <region>: one featured video (thumbnail facade — nothing loads from YouTube before the press), the top
   video of the configured topics (home.video_rows), every topic with its count and its own page #}
{% if h.vfeat %}
{% set T.i = T.i + 1 %}
<section class="sec sec-vid{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-vid">
  <div class="wrap">
    {{ ui.sec_head('YouTube', '영상으로 보는 ' ~ site.region, 'h-vid', '/videos/', '영상 ' ~ h.n_videos ~ '편 모두') }}
    <div class="vgrid">
      <div class="v-feat">{{ ui.video(h.vfeat) }}</div>
      {% if h.vrows %}<ol class="v-rows">{% for r in h.vrows %}{{ p2.vtopic(r) }}{% endfor %}</ol>{% endif %}
    </div>
    <nav class="v-chips" aria-label="영상 주제">{% for c in h.vchips %}<a href="{{ c.path or ('/videos/#' ~ c.id) }}">{{ '그 밖의 영상' if c.title == '기타' else c.title }} <span class="tn">{{ c.n }}</span></a>{% endfor %}</nav>
  </div>
</section>
{% endif %}

{# 공식 안내: the official sites this one is built from (links only) #}
{% if site.official_links %}
{% set T.i = T.i + 1 %}
<section class="sec p2-official{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-official">
  <div class="wrap">
    {{ ui.sec_head('공식 안내', site.region ~ ' 공식 관광 안내', 'h-official') }}
    <ul class="p2-links">{% for l in site.official_links %}<li><a href="{{ l.url }}" rel="noopener" data-track="official_click"><span class="p2-l-n">{{ l.name }}</span>{% if l.note %}<span class="p2-l-v">{{ l.note }}</span>{% endif %}{{ ui.icon('external', 'icon-sm') }}</a></li>{% endfor %}</ul>
  </div>
</section>
{% endif %}
{% endblock %}
