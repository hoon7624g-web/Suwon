{% extends "base.html.j2" %}
{% import "_art.html.j2" as artm %}
{#- /map/: every place by 권역 or 구·군 → 동 (present.map_vm: regions [{name, id, anchor, members, k, dongs, art?}],
    anchors, label_pts, far_m, far_label, none_label, mode, n_regions, n_geo, n_all, n_dong; the words of the mode come
    from cityv) beside a sticky map tile (desktop) or behind the 목록 | 지도 switch (phones). The grouping rule of the
    mode is written on the page (CLAUDE.md 7). Tabs, kind toggles and row ↔ marker highlighting are site.js
    ([data-region-tabs], [data-kinds], [data-segmap], [data-pt]); without JS the directory is the whole answer (the
    map tile, tabs and toggles are JS-only furniture). Ids are the view model's (ASCII). Each group's section opens
    with its AI art band when one exists (area.<r.art>, present.REGION_ART; lazy; nothing without art). -#}
{% import "_p1.html.j2" as p1 %}
{% import "_filters.html.j2" as fb %}
{% set kl = {'attraction': '관광지', 'stay': '숙소', 'food': '음식점'} %}
{% set mk = {'attraction': 'a', 'stay': 's', 'food': 'f'} %}
{% block main_class %}{% endblock %}
{% block bodyclass %}pg-map{% endblock %}
{% block content %}
<section class="pg-hero band-s list-head" aria-labelledby="h-list">{{ artm.band((art_slots or {}).get('list.head.map')) }}
  <div class="wrap">
    <h1 id="h-list" class="h-list">{{ site.region }} 지도 <span class="count tn">{{ n_all }}곳</span></h1>
    <p class="list-lede">{% if n_regions %}{{ '여행 ' if mode == 'anchors' }}{{ cityv.region_label }} <span class="tn">{{ n_regions }}</span>곳 · {% endif %}{{ cityv.area_label }} <span class="tn">{{ n_dong }}</span>곳 · 지도: 좌표가 있는 <span class="tn">{{ n_geo }}</span>곳</p>
    {% if mode == 'anchors' and anchors %}
    <details class="rule">
      <summary>{{ cityv.region_label|josa('을/를') }} 나눈 기준</summary>
      <p>좌표가 있는 곳은 기준점 {{ anchors|length }}곳 — {% for a in anchors %}<a href="{{ a.path }}">{{ a.place }}</a>({{ a.name }}){% if not loop.last %}, {% endif %}{% endfor %} — 가운데 직선거리로 가장 가까운 기준점의 {{ cityv.region_label }}에 넣었습니다.{% if far_label and far_m %} 가장 가까운 기준점까지 {{ (far_m / 1000)|round(1)|replace('.0', '') }}km를 넘는 곳은 ‘{{ far_label }}’{{ (far_label|josa('으로/로'))[far_label|length:] }} 따로 뒀습니다.{% endif %} 좌표가 없는 곳은 주소의 {{ cityv.area_label|josa('이/가') }} 같은 장소들이 가장 많이 속한 {{ cityv.region_label|josa('을/를') }} 따랐고, {{ cityv.area_label }}도 없으면 ‘{{ none_label }}’입니다.</p>
    </details>
    {% elif mode == 'district' %}
    <details class="rule">
      <summary>{{ cityv.region_label|josa('으로/로') }} 묶은 기준</summary>
      <p>주소에 적힌 {{ cityv.region_label|josa('으로/로') }} 묶었습니다. 주소에 {{ cityv.region_label|josa('이/가') }} 없으면 ‘{{ none_label }}’에 둡니다.</p>
    </details>
    {% endif %}
  </div>
</section>
<div class="wrap map-grid">
  <div class="map-dir">
    <div class="f-row region-tabs" role="group" aria-label="{{ cityv.region_label }}" data-region-tabs>
      <a href="#map-top" data-region="" aria-current="true">전체 <span class="tn">{{ n_all }}</span></a>
      {% for r in regions %}<a href="#{{ r.id }}" data-region="{{ r.name }}">{{ r.name }} <span class="tn">{{ r.members|length }}</span></a>{% endfor %}
    </div>
    <div class="f-row f-kinds" role="group" aria-label="종류" data-kinds>
      {% for k in ('attraction', 'stay', 'food') %}<button type="button" data-kind="{{ k }}" aria-pressed="true"><i class="mk mk-{{ mk[k] }}" aria-hidden="true"></i>{{ kl[k] }} <span class="tn">{{ k_all[k] or 0 }}</span></button>{% endfor %}
    </div>
    {#- the count line (site.js data-tpl, data-of while filtered): the places shown for the chosen group and kinds — a
        status region, so every change of the count, 0 among them, is announced (the first site's outside evaluation
        2026-10-18, fc51ca0ec · 857d1beec); the 목록 | 지도 switch beside it on phones -#}
    <div class="f-tools map-tools js-only">
      <p class="f-result" role="status"><span data-map-result data-tpl="장소 {n}곳" data-of=" (전체 {m}곳 중)">장소 {{ n_all }}곳</span></p>
      {% if n_geo %}<div class="seg seg-map" role="group" aria-label="보기" data-segmap><button type="button" data-view="list" aria-pressed="true">목록</button><button type="button" data-view="map" aria-pressed="false">지도 <span class="tn">{{ n_geo }}</span></button></div>{% endif %}
    </div>
    {#- nothing left for the chosen group and kinds (site.js): the sentence and the buttons that bring places back — the
        group ('<그룹> 조건 해제'), a hidden kind ('<종류> 숨김 해제', data-kind-one), each only when it alone brings
        some back, then the reset of both; outside the sections, so the phone's 지도 view shows it too -#}
    <p class="empty" data-map-empty hidden>고른 {{ cityv.region_label }}·종류에 맞는 곳이 없습니다.</p>
    <div class="f-undo" data-map-undo data-one="{{ list_words.clear_one }}" data-kind-one="{v} 숨김 해제" hidden><button type="button" data-map-reset>{{ list_words.clear_all }}</button></div>
    <div id="map-top"></div>
    {% for r in regions %}
    <section class="region{% if not loop.first %} cv{% endif %}" id="{{ r.id }}" data-region-sec="{{ r.name }}" aria-labelledby="{{ r.id }}-h">{{ artm.strip((art_slots or {}).get('area.' ~ r.art) if r.art else none) }}
      <div class="region-head">
        <h2 id="{{ r.id }}-h">{{ r.name }} <span class="count tn" data-group-n>{{ r.members|length }}곳</span></h2>
        <p class="region-k tn">관광지 {{ r.k.attraction or 0 }} · 숙소 {{ r.k.stay or 0 }} · 음식점 {{ r.k.food or 0 }}{% if r.anchor %} · 기준점 <a href="{{ r.anchor.path }}">{{ r.anchor.place }}</a>{% endif %}</p>
      </div>
      <div class="dongs">
        {% for d in r.dongs %}
        <section class="dong" aria-labelledby="{{ d.id }}">
          <h3 id="{{ d.id }}">{{ d.name }} <span class="tn" data-group-n>{{ d.members|length }}</span></h3>
          <ul>{% for e in d.members %}<li data-kind-row="{{ e.kind }}"{% if e._geo %} data-pt="{{ e.slug }}"{% endif %}><i class="mk mk-{{ mk[e.kind] }}" aria-hidden="true"></i><a href="{{ e._path }}">{{ e.name }}</a><span class="vh"> ({{ kl[e.kind] }})</span></li>{% endfor %}</ul>
        </section>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </div>
  {% if n_geo %}
  <aside class="map-side" aria-label="{{ site.region }} {{ cityv.region_label }} 지도">
    {{ p1.placemap({'all': points, 'anchor_pts': label_pts, 'far_label': far_label, 'none_label': none_label}, site.region ~ ' ' ~ cityv.region_label ~ ' 지도', 'all-mapfig', '좌표가 있는 ' ~ n_geo ~ '곳', fb.off_map(n_all - n_geo, list_words)) }}
  </aside>
  {% endif %}
</div>
{% endblock %}
