+def cut_breaks(ranges: list, breaks: list) -> list[list[int]]:
+    """The opening ranges with the breaks (준비시간) taken out: the bar's segments."""
+    segs = [list(r) for r in ranges]
+    for a, b in breaks:
+        nxt = []
+        for x, y in segs:
+            if b <= x or a >= y:
+                nxt.append([x, y])
+                continue
+            if a > x:
+                nxt.append([x, a])
+            if b < y:
+                nxt.append([b, y])
+        segs = nxt
+    return segs
