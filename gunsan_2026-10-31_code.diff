index 0000000000..f3f4aa7237
--- /dev/null
+++ b/tools/visitors_gunsan.py
@@ -0,0 +1,89 @@
+"""관광지점 월별 관광객수 — 공공데이터포털 '전북특별자치도 군산시_관광지점 월별 관광객수'(군산시가 집계한 관광지점별
+월별 관광객)를 장소에 place['visitors']로 넣는다(운영자 결정 2026-10-31 '1번부터 모두 반영' — 군산각 추가 출처).
+
+    python tools/visitors_gunsan.py --data data/gunsan            # 미리보기
+    python tools/visitors_gunsan.py --data data/gunsan --apply    # places.json에 반영
+
+규칙
+- 파일은 data/raw/gunsan/visitors/에 값 그대로 둔다. 관광지 이름과 장소는 PLACES 대응표로만 잇는다(이름으로 추측하지
+  않는다; 사이트에 없는 관광지점 — 새만금컨벤션센터·청암산 오토캠핑장 — 은 넣지 않는다).
+- 열두 달이 모두 적힌 가장 최근 해를 막대로(months), 그 뒤 해의 적힌 달까지 합계를 recent로 둔다(빈 달은 0으로 세지 않고
+  뺀다). 값은 파일의 숫자 그대로다.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import sys
+from pathlib import Path
+
+FILE = "gunsan_visitors_monthly_20260119.csv"
+SOURCE = {"provider": "전북특별자치도 군산시", "dataset": "전북특별자치도 군산시_관광지점 월별 관광객수_20260119",
+          "url": "https://www.data.go.kr/data/15103608/fileData.do", "base_date": "2026-01-19"}
+# 파일의 관광지 이름 → 장소 id (2026-10-31 확인)
+PLACES = {
+    "경암동철길마을": "gunsan-433883",
+    "군산근대역사박물관": "gunsan-305395",
+    "군산컨트리클럽": "gunsan-305411",
+    "금강미래체험관(구 금강철새조망대)": "gunsan-305363",
+    "선유도(고군산군도)": "gunsan-static-m2201",
+    "은파호수공원": "gunsan-305372",
+    "청암산": "gunsan-305401",
+    "초원사진관": "gunsan-433869",
+    "테디베어박물관": "gunsan-305394",
+}
+
+
+def _n(v) -> int | None:
+    v = str(v or "").replace(",", "").strip()
+    return int(v) if v.isdigit() else None
+
+
+def visitors(rows: list[dict], name: str) -> dict | None:
+    """{year, months [12 ints], total, recent {year, through, total} | None, source} for one 관광지 of the file."""
+    by_year = {}
+    for r in rows:
+        if r.get("관광지") == name:
+            by_year[int(str(r.get("년도"))[:4])] = [_n(r.get(f"{m}월")) for m in range(1, 13)]
+    full = [y for y, ms in by_year.items() if all(x is not None for x in ms)]
+    if not full:
+        return None
+    year = max(full)
+    later = [y for y in by_year if y > year]
+    recent = None
+    if later:
+        ry = max(later)
+        got = [x for x in by_year[ry] if x is not None]
+        through = max(i + 1 for i, x in enumerate(by_year[ry]) if x is not None) if got else 0
+        recent = {"year": ry, "through": through, "total": sum(got)} if got else None
+    return {"year": year, "months": by_year[year], "total": sum(by_year[year]), "recent": recent, "source": SOURCE}
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--data", type=Path, required=True)
+    ap.add_argument("--apply", action="store_true")
+    a = ap.parse_args(argv)
+    raw = a.data.parent / "raw" / a.data.name / "visitors" / FILE
+    rows = list(csv.DictReader(open(raw, encoding="utf-8-sig")))
+    places = json.loads((a.data / "places.json").read_text("utf-8"))
+    by = {p["id"]: p for p in places}
+    n = 0
+    for name, pid in PLACES.items():
+        v = visitors(rows, name)
+        if not v or pid not in by:
+            print(f"건너뜀: {name} → {pid}")
+            continue
+        by[pid]["visitors"] = v
+        n += 1
+        print(f"{by[pid]['name']}: {v['year']}년 {v['total']:,}명" + (f", {v['recent']['year']}년 1~{v['recent']['through']}월 "
+                                                                    f"{v['recent']['total']:,}명" if v["recent"] else ""))
+    if a.apply:
+        (a.data / "places.json").write_text(json.dumps(places, ensure_ascii=False, indent=2) + "\n", "utf-8")
+        print(f"반영: 장소 {n}곳")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
