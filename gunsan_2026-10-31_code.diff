+from pipeline.textutil import slugify, squash_ws  # noqa: E402
+
+PET_BASE = "https://apis.data.go.kr/B551011/KorPetTourService2"
+PROVIDER = "한국관광공사 반려동물 동반여행(TourAPI)"
+CAMP_BASE = "https://apis.data.go.kr/B551011/GoCamping"
+CAMP_PROVIDER = "한국관광공사 고캠핑(TourAPI)"
+REGION = {"lDongRegnCd": "52", "lDongSignguCd": "130"}   # 전북특별자치도 군산시
+FIELDS = (("acmpyTypeCd", "동반 구분"), ("acmpyPsblCpam", "동반 가능 동물"), ("acmpyNeedMtr", "동반 시 필요 사항"),
+          ("etcAcmpyInfo", "기타 동반 정보"))
