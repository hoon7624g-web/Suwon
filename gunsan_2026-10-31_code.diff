+    background: #fff; border: 1px solid var(--hair); border-radius: var(--r-l); box-shadow: var(--shadow-1); }
+  .mast::before { display: none; }
+  .mast-in { display: flex; flex-direction: column; align-items: stretch; gap: 12px; height: auto; max-width: none; margin: 0; padding: 0; }
+  /* the wordmark: the symbol at the left of the name, the brand (when it differs) and the line under the name */
+  .wordmark { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 10px; row-gap: 3px; align-self: stretch; min-height: 44px; margin: 0 0 4px; padding: 0 2px; }
+  .wordmark > * { grid-column: 2; }
+  .wordmark:not(:has(> .wm-sym)) { grid-template-columns: minmax(0, 1fr); }
+  .wordmark:not(:has(> .wm-sym)) > * { grid-column: 1; }
+  .wordmark .wm-sym { grid-column: 1; grid-row: 1 / span 3; margin: 0; }
+  .wordmark .wm-sym svg { height: 40px; }
+  .wordmark .wm-a { font-size: 25px; line-height: 1.1; white-space: normal; overflow: visible; padding: 0; margin: 0; }
+  .wordmark .wm-b { display: block; white-space: normal; overflow: visible; padding: 0; margin: 0; }
+  .wm-tag { display: block; font: 400 12px/1.35 var(--font); color: var(--ink-3); letter-spacing: 0; }
+  .mast-plan, .mast-v, .mast-ctx, .mast-search, .menu { display: none !important; }
+  /* the language menu: a full-width button; its list drops over the board */
+  .mast .lang-menu { margin: 0; }
+  .mast .lang-btn { justify-content: flex-start; width: 100%; height: 44px; padding: 0 14px; border: 1px solid var(--hair); border-radius: 12px; color: var(--ink); font-size: 14.5px; }
+  .mast .lang-btn::after { content: ""; width: 8px; height: 8px; margin: -4px 4px 0 auto; border: solid var(--ink-3); border-width: 0 2px 2px 0; transform: rotate(45deg); }
+  .mast .lang-menu[open] .lang-btn { border-color: var(--sea); }
+  .mast .lang-cur { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
+  .mast .lang-list { left: 0; right: 0; min-width: 0; }
+  /* the site search, always there */
+  .mast .hs { display: flex; flex: none; min-width: 0; margin: 0; }
+  .mast .hs-f { height: 48px; border-radius: 14px; }
+  .side { display: flex; flex-direction: column; gap: 14px; }
+  .side-nav { margin-top: 2px; }
+  .sg:last-child { border-bottom: 0; }
+  /* the page: its local bar sticks at the column's top; the home's opening is a rounded board in the column */
+  .pg-h4 .ho { margin: var(--side-in) var(--side-in) 0 0; border-radius: var(--r-xl); }
+  /* its H1 sized on the column, not the window (it was 4.2vw of a full-width page): the same share of the opening */
+  .pg-h4 .hk-h1 { font-size: clamp(40px, calc(var(--cw) * .044), 58px); }
+  /* the pages' big type, too: a share of the column as it was of the full-width page (4–4.6vw) */
+  .d1, .h-list { font-size: clamp(34px, calc(var(--cw) * .046), 64px); }
+  .band-s .h-list { font-size: clamp(32px, calc(var(--cw) * .036), 52px); }
+  .d1-q { font-size: clamp(30px, calc(var(--cw) * .036), 52px); }
+  .h2 { font-size: clamp(32px, calc(var(--cw) * .04), 56px); }
+}
+/* 1200–1439px: the column (880–1120px, less the quick menu's gutter) is narrower than the desktop home was drawn for —
+   the assistant card takes the stacked head of 700–1023px and its icon menu two rows of six */
+@media (min-width: 1200px) and (max-width: 1439px) {
+  .hk-ask { display: flex; flex-direction: column; align-items: stretch; }
+  .hk-head { grid-template-columns: 56px minmax(0, 1fr); align-items: center; align-self: stretch; margin: 0 0 14px; }
+  .hk-mascot img { align-self: center; width: 56px; height: 56px; }
+  .hk-note { margin-top: 0; }
+  .hq-row { grid-auto-flow: row; grid-template-columns: repeat(6, minmax(0, 1fr)); row-gap: 4px; }
+  /* the lists' head and filters (their ledger beside the map has 500–680px): the 권역 tiles step back as below 1024px
+     (each 권역 is a heading of the list), the chips take the whole row with the count and 필터 under them — the first
+     results stay on the first screen */
+  .list-head .band-data { display: none; }
+  .f-top { flex-wrap: wrap; }
+  .f-top .f-row { flex: 1 1 100%; }
+}
+/* the planner (/plan/, assets/plan.css): its plan and its map side by side need the 1100px content it had from 1280px
+   before the panel; until the column gives it (1600px), one under the other — a stop's buttons stay one line */
+@media (min-width: 1200px) and (max-width: 1599px) {
+  .trp .trp-grid { grid-template-columns: minmax(0, 1fr); }   /* .trp: past plan.css, which comes after this sheet */
+  .trp .trp-side { position: static; }
+}
+@media (min-width: 1200px) and (max-height: 760px) {
+  .mast, .has-lnav .mast { gap: 12px; padding-top: 16px; }
+  .sg-s { min-height: 46px; }
+}
+@media print {
+  body { padding-left: 0 !important; }
+  .side, .menu { display: none !important; }
+  .mast, .has-lnav .mast { position: static !important; width: auto !important; border: 0 !important; box-shadow: none !important; }
+}
