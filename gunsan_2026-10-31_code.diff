+def norm_name(s: str) -> str:
+    """A shop name for matching: brackets and their contents, '주식회사', spaces and punctuation removed, lower case;
+    '방앗간' and its common spelling '방아간' read alike (온누리 '시장떡방앗간', 인허가 '시장떡방아간')."""
+    s = re.sub(r"\(.*?\)|\[.*?\]", "", s or "").replace("주식회사", "").replace("방앗간", "방아간")
+    return re.sub(r"[\s\W_]+", "", s).lower()
+
+
+def short_address(r: dict) -> str:
+    """A 상가정보 row's road address without the city and 구 ('부흥로316번길 38-3'), then its 동·층·호 as written."""
+    road = re.sub(CITY_RX, "", squash(r.get("도로명주소")))
+    dong, floor, ho = squash(r.get("동정보")), squash(r.get("층정보")), squash(r.get("호정보"))
+    if floor:
+        floor = ("지하 " + floor[1:] if floor[:1] in "Bb" and floor[1:].isdigit() else floor) + ("층" if floor[-1:].isdigit() else "")
+    bits = [road] + [b for b in (dong + ("동" if dong.isdigit() else ""), floor, ho + ("호" if ho.isdigit() else "")) if b]
+    return " ".join(b for b in bits if b)
+
+
+def squash(s) -> str:
+    return " ".join(str(s or "").split())
+
+
+def road_key(addr: str) -> tuple[str, str] | None:
+    """('부흥로316번길', '38-3') of a road address (city and 구, a trailing '(동)' and anything after a comma dropped)."""
+    a = re.sub(CITY_RX, "", squash(addr)).split(",")[0].replace(".", "")   # 상가정보 '구암31로' = 인허가 '구암3.1로'
+    a = re.sub(r"\s*\(.*?\)\s*$", "", a)
+    m = re.match(r"(\S+?(?:로|길)(?:\s*\d+번길)?)\s*(\d+(?:-\d+)?)\b", a)
+    return (m.group(1).replace(" ", ""), m.group(2)) if m else None
+
+
+def licence_address(raw: str) -> str:
+    """A licence row's road address without the city and 구; its trailing '(…)' keeps only what is not the 동 (a building
+    or 호): '부흥로304번길 35-7 (부평동 (제일상가 1층 30호))' → '부흥로304번길 35-7 제일상가 1층 30호'."""
+    a = re.sub(CITY_RX, "", squash(raw))
+    m = re.search(r"\s*\((.*)\)\s*$", a)
+    if not m:
+        return a
+    inner = squash(re.sub(r"[()]", " ", m.group(1)))
+    inner = squash(re.sub(r"^\S+동(?=[\s,]|$)[\s,]*", "", inner)).strip(", ")
+    return squash(a[:m.start()] + (" " + inner if inner else ""))
+
+
+def nearest_market(ll: tuple[float, float], points: dict[str, tuple[float, float]]) -> str:
+    """The id of the market place nearest to a point (a store or licence row joins that one market only)."""
+    return min(points, key=lambda pid: metres(ll, points[pid])) if points else ""
+
+
+def home_market(name: str, ll: tuple[float, float], points: dict[str, tuple[float, float]],
+                owners: dict[str, set[str]] | None = None) -> str:
+    """The market a store or licence row joins: the one the 온누리 list names for a shop of that name, when that market
+    is within MATCH_M and the only one (대화방앗간: 온누리 '부평종합시장', 55 m from it and 53 m from 진흥), else the
+    nearest."""
+    cands = {pid for pid in (owners or {}).get(norm_name(name), ()) if pid in points and metres(ll, points[pid]) <= MATCH_M}
+    return next(iter(cands)) if len(cands) == 1 else nearest_market(ll, points)
+
+
+def license_rows(lic_root: Path, stores: list[dict], point: tuple[float, float] | None,
+                 points: dict[str, tuple[float, float]] | None = None, pid: str = "",
+                 owners: dict[str, set[str]] | None = None) -> list[dict]:
+    """The LICENSES rows whose road address (road + building number) is a 상가정보 store's within MATCH_M of the
+    market: [{group, rows [{name, kind, addr}], source}] (names and addresses as written, the address without the city
+    and 구 and its trailing '(동)'). A file not there, or no point, gives nothing."""
+    if not point:
+        return []
+    locate = road_locator(stores)
+    out = []
+    for src in LICENSES:
+        f = lic_root / src["file"]
+        if not f.is_file():
+            continue
+        c_name, c_kind, c_addr, *c_tel = src.get("cols") or ("사업장명", "판매업구분", "소재지주소")
+        got, seen = [], set()
+        for r in read(f):
+            ll = locate(r.get(c_addr))
+            name = squash(r.get(c_name))
+            k = road_key(r.get(c_addr))
+            if not name or not ll or metres(ll, point) > MATCH_M or (name, k) in seen:
+                continue
+            if src.get("open") and squash(r.get(src["open"][0])) != src["open"][1]:
+                continue   # closed, suspended or struck off: only shops in business become cards
+            if src.get("kinds") and squash(r.get(c_kind)) not in src["kinds"]:
+                continue
+            if points and pid and not src.get("support") and home_market(name, ll, points, owners) != pid:
+                continue   # a row near two markets joins one (home_market)
+            if src.get("name_has") and not any(w in name for w in src["name_has"]):
+                continue
+            if src.get("name_not") and any(w in name for w in src["name_not"]):
+                continue
+            seen.add((name, k))
+            row = {"name": name, "kind": squash(r.get(c_kind)), "addr": licence_address(r.get(c_addr)),
+                   "geo": [round(ll[0], 6), round(ll[1], 6)]}
+            tel = squash(r.get(c_tel[0])) if c_tel else ""
+            if tel:
+                row["tel"] = tel
+            got.append(row)
+        if got:
+            base = src.get("base_date") or max((squash(r.get("DAT_UPDT_PNT"))[:10] for r in read(f)), default="")
+            out.append({"group": src["group"], "rows": sorted(got, key=lambda x: x["name"]),
+                        "mode": "support" if src.get("support") else "add",
+                        "source": {"provider": src["provider"], "dataset": src["dataset"], "url": src["url"],
+                                   "base_date": base}})
+    return out
+
+
+def road_locator(stores: list[dict]):
+    """address -> (lat, lng) of a 상가정보 store at the same road and building number, else at the same road and main
+    building number ('35-4' beside '35-7'); None when the road has neither."""
+    pos: dict[tuple[str, str], tuple[float, float]] = {}
+    main: dict[tuple[str, str], tuple[float, float]] = {}
+    for r in stores:
+        k = road_key(r.get("도로명주소"))
+        try:
+            ll = (float(r["위도"]), float(r["경도"]))
+        except (KeyError, ValueError):
+            continue
+        if k:
+            pos.setdefault(k, ll)
+            main.setdefault((k[0], k[1].split("-")[0]), ll)
+
+    def locate(addr: str) -> tuple[float, float] | None:
+        k = road_key(addr)
+        if not k:
+            return None
+        return pos.get(k) or main.get((k[0], k[1].split("-")[0]))
+    return locate
+
+
+def store_kind_rows(stores: list[dict], point: tuple[float, float] | None,
+                    points: dict[str, tuple[float, float]] | None = None, pid: str = "",
+                    owners: dict[str, set[str]] | None = None) -> list[dict]:
+    """The 상가정보 stores of STORE_KINDS within MATCH_M of the market as cards of their group: [{group, rows [{name,
+    kind (the badge), addr, geo}], mode 'store', source}] — names and addresses as the 상가정보 writes them."""
+    if not point:
+        return []
+    by: dict[str, list[dict]] = collections.defaultdict(list)
+    seen = set()
+    for r in stores:
+        kind = STORE_KINDS.get(squash(r.get("상권업종소분류명")))
+        try:
+            ll = (float(r["위도"]), float(r["경도"]))
+        except (KeyError, ValueError):
+            continue
+        name = squash(r.get("상호명"))
+        if not kind or not name or metres(ll, point) > MATCH_M or (name, squash(r.get("도로명주소"))) in seen:
+            continue
+        if points and pid and home_market(name, ll, points, owners) != pid:
+            continue   # a store near two markets joins one (home_market)
+        seen.add((name, squash(r.get("도로명주소"))))
+        by[kind[0]].append({"name": name, "kind": kind[1], "addr": short_address(r),
+                            "geo": [round(ll[0], 6), round(ll[1], 6)]})
+    return [{"group": g, "rows": sorted(rows, key=lambda x: x["name"]), "mode": "store",
+             "source": {"provider": PROVIDER, "dataset": SANGGA["dataset"], "url": SANGGA["url"],
+                        "base_date": SANGGA["base_date"]}} for g, rows in by.items()]
+
+
+def store_matcher(stores: list[dict], point: tuple[float, float] | None):
+    """name -> the 상가정보 row of a 온누리 shop near this market (MATCH_M), or None: one candidate, or several that share
+    one road address (the first); no point, no candidate, or candidates at different addresses -> None."""
+    near: dict[str, list[dict]] = collections.defaultdict(list)
+    if point:
+        for r in stores:
+            try:
+                ll = (float(r["위도"]), float(r["경도"]))
+            except (KeyError, ValueError):
+                continue
+            if metres(ll, point) <= MATCH_M:
+                near[norm_name(r.get("상호명"))].append(r)
+
+    def find(name: str) -> dict | None:
+        c = near.get(norm_name(name)) or []
+        if not c or len({squash(r.get("도로명주소")) for r in c}) > 1:
+            return None
+        return c[0]
+    return find
+
+
+def shop_groups(rows: list[dict], find=None) -> tuple[list[dict], int]:
+    """The 온누리 rows of one market as item groups in SHOP_GROUPS order (then 그 밖의 가게): [{key, label, shops:
+    [{name, items}]}] — a shop once per group, its items (원문, '·' between) in row order, shops in 가나다 order —
+    and the number of stall rows (name with '노점'), which carry no name of their own."""
+    order = [k for k, _, _ in SHOP_GROUPS] + [OTHER[0]]
+    labels = {k: lab for k, lab, _ in SHOP_GROUPS} | {OTHER[0]: OTHER[1]}
+    by: dict[str, dict[str, list[str]]] = {k: {} for k in order}
+    stalls = 0
+    for r in rows:
+        name = " ".join((r.get("가맹점명") or "").split())
+        if not name:
+            continue
+        if STALL in name:
+            stalls += 1
+            continue
+        items = " ".join((r.get("취급품목") or "").split())
+        key, _ = shop_group(items, name)
+        got = by[key].setdefault(name, [])
+        if items and not any(items in x for x in got):   # '떡' beside '방앗간, 떡' adds nothing
+            got[:] = [x for x in got if x not in items] + [items]
+    def shop(n: str, items: list[str]) -> dict:
+        s = {"name": n, "items": "·".join(items)}
+        r = find(n) if find else None
+        if r:
+            s.update({"addr": short_address(r), "store_id": squash(r.get("상가업소번호")),
+                      "geo": [round(float(r["위도"]), 6), round(float(r["경도"]), 6)]})
+        return s
+    groups = [{"key": k, "label": labels[k], "shops": [shop(n, by[k][n]) for n in sorted(by[k])]}
+              for k in order if by[k]]
+    return groups, stalls
+
+
+def read(path: Path) -> list[dict]:
+    with open(path, encoding="utf-8-sig", newline="") as f:
+        return list(csv.DictReader(f))
+
+
+def write(path: Path, rows: list[dict]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        w = csv.DictWriter(f, fieldnames=list(rows[0]))
+        w.writeheader()
+        w.writerows(rows)
+
+
+def metres(a: tuple[float, float], b: tuple[float, float]) -> float:
+    """Straight-line distance in metres between two (lat, lng) points (equirectangular, fine within a city)."""
+    k = math.pi / 180
+    x = (b[1] - a[1]) * k * math.cos((a[0] + b[0]) / 2 * k)
+    return 6371000 * math.hypot(x, (b[0] - a[0]) * k)
+
+
+def market_points(data: Path) -> dict[str, tuple[float, float]]:
+    """{place id: (lat, lng)} of the MARKETS places that have a point."""
+    places = {p["id"]: p for p in json.loads((data / "places.json").read_text("utf-8"))}
+    out = {}
+    for pid in MARKETS:
+        g = (places.get(pid) or {}).get("geo") or {}
+        if g.get("lat") and g.get("lng"):
+            out[pid] = (float(g["lat"]), float(g["lng"]))
+    return out
+
+
+def extract_sangga(root: Path, data: Path, sangga_csv: Path) -> int:
+    """The 상가정보 rows near a market place (EXTRACT_M), values as published, into data/raw/<도시>/markets/."""
+    pts = list(market_points(data).values())
+    keep = []
+    for r in read(sangga_csv):
+        try:
+            ll = (float(r["위도"]), float(r["경도"]))
+        except (KeyError, ValueError):
+            continue
+        if any(metres(ll, p) <= EXTRACT_M for p in pts):
+            keep.append(r)
+    if not keep:
+        raise SystemExit("옮길 상가정보 행이 없습니다 — 파일(시·도 CSV)과 열 이름을 확인")
+    write(root / SANGGA["file"], keep)
+    return len(keep)
+
+
+def fetch_mois(root: Path, data: Path, key: str, cache: Path, max_calls: int = 200) -> dict:
+    """행정안전부 인허가 조회서비스(MOIS) of 군산시 (MOIS_GROUP), every page (100 rows a page), cached per page (data/cache); the rows
+    whose road address is near a market place (EXTRACT_M, any status) go to data/raw/<도시>/licenses/ with MOIS_KEEP
+    columns as returned. The key is masked in every message; the provider's message is shown as it is."""
+    import time
+    import urllib.error
+    import urllib.parse
+    import urllib.request
+    stores = read(root / SANGGA["file"])
+    locate, pts = road_locator(stores), list(market_points(data).values())
+    calls, done = 0, {}
+    cache.mkdir(parents=True, exist_ok=True)
+    for m in MOIS:
+        rows, page, total = [], 1, None
+        while total is None or (page - 1) * 100 < total:
+            f = cache / f"{m['svc']}-{MOIS_GROUP}-{page}.json"
+            if f.is_file():
+                body = json.loads(f.read_text("utf-8"))
+            else:
+                if calls >= max_calls:
+                    raise SystemExit(f"호출 상한 {max_calls}회 — 캐시로 이어서 다시 실행")
+                q = urllib.parse.urlencode({"serviceKey": key, "pageNo": page, "numOfRows": 100, "returnType": "json",
+                                            "cond[OPN_ATMY_GRP_CD::EQ]": MOIS_GROUP})
+                for i in range(4):
+                    raw = ""
+                    try:
+                        calls += 1
+                        with urllib.request.urlopen(f"https://apis.data.go.kr/1741000/{m['svc']}/info?{q}", timeout=60) as r:
+                            raw = r.read().decode("utf-8")
+                        body = json.loads(raw)["response"]["body"]
+                        break
+                    except Exception as e:   # noqa: BLE001 — the provider's own message, the key masked
+                        if isinstance(e, urllib.error.HTTPError):
+                            raw = e.read().decode("utf-8", "replace")
+                        err = f"{e} {raw[:300]}"
+                        for k in (key, urllib.parse.quote(key, safe="")):
+                            err = err.replace(k, "«KEY»")
+                        if i < 3:
+                            time.sleep(2 + 2 * i)
+                else:
+                    raise SystemExit(f"{m['svc']} {page}쪽: {err}")
+                f.write_text(json.dumps(body, ensure_ascii=False), "utf-8")
+            total = int(body.get("totalCount") or 0)
+            rows += (body.get("items") or {}).get("item") or []
+            page += 1
+        keep = []
+        for r in rows:
+            ll = locate(r.get("ROAD_NM_ADDR"))
+            if ll and any(metres(ll, p) <= EXTRACT_M for p in pts):
+                keep.append({c: "" if r.get(c) is None else str(r.get(c)) for c in MOIS_KEEP})
+        if keep:
+            write(root.parent / "licenses" / m["file"], sorted(keep, key=lambda r: r["MNG_NO"]))
+        done[m["svc"]] = {"rows": len(rows), "near": len(keep)}
+    done["calls"] = calls
+    return done
+
+
+def extract(root: Path, std_csv: Path | None, onnuri_csv: Path) -> dict:
+    """The rows this site uses, values as published: 군산시 markets of the standard data (when given), 전북 merchants of
+    MARKETS."""
+    std = [r for r in read(std_csv) if re.search(CITY_RX[1:], (r.get("소재지도로명주소") or "") + (r.get("소재지지번주소") or ""))
+           ] if std_csv else []
+    names = {n for m in MARKETS.values() for n in m.get("onnuri") or []}
+    onn = [r for r in read(onnuri_csv) if (r.get("소재지") or "").startswith("전북") and r.get("소속 시장명(또는 상점가)") in names]
+    if not onn or (std_csv and not std):
+        raise SystemExit(f"옮길 행이 없습니다(표준 {len(std)}, 온누리 {len(onn)}) — 파일의 열 이름을 확인")
+    if std:
+        write(root / STD["file"], std)
+    write(root / ONNURI["file"], onn)
+    return {"std": len(std), "onnuri": len(onn)}
+
+
+def row(src: dict, value: str, base_date: str, checked: str) -> dict:
+    return {"value": value, "provider": PROVIDER, "dataset": src["dataset"], "url": src["url"], "checked_at": checked,
+            "base_date": base_date}
+
+
+def group_photos(place: dict | None, pid: str) -> dict[str, dict]:
+    """{group: photo} for SHOP_PHOTOS of a market place: the place's own image record (url, credit, license, source)
+    whose url ends with the chosen file, with our alt; a choice not among its images is left out."""
+    out = {}
+    for key, (tail, alt) in (SHOP_PHOTOS.get(pid) or {}).items():
+        im = next((x for x in (place or {}).get("images") or [] if str(x.get("url") or "").endswith("/" + tail)), None)
+        if im and im.get("license") in ("KOGL-1", "KOGL-3"):
+            out[key] = {"url": im["url"], "alt": alt, "credit": im.get("credit") or "", "license": im["license"],
+                        "source_url": im.get("source_url") or ""}
+    return out
+
+
+def market_rows(root: Path, checked: str, points: dict[str, tuple[float, float]] | None = None,
+                places: dict[str, dict] | None = None) -> dict[str, dict[str, list[dict]]]:
+    """{place id: {key: [row]}} from the files (the 상가정보 rows, when there, give the shops their addresses)."""
+    stores = read(root / SANGGA["file"]) if (root / SANGGA["file"]).is_file() else []
+    points = points or {}
+    std = {r["시장명"]: r for r in read(root / STD["file"])} if (root / STD["file"]).is_file() else {}
+    onn = collections.defaultdict(list)
+    for r in read(root / ONNURI["file"]):
+        onn[r["소속 시장명(또는 상점가)"]].append(r)
+    owners: dict[str, set[str]] = collections.defaultdict(set)   # 온누리 shop name -> the markets the list names
+    for pid, m in MARKETS.items():
+        for n in m.get("onnuri") or []:
+            for r in onn.get(n) or []:
+                owners[norm_name(r.get("가맹점명"))].add(pid)
+    out = {}
+    for pid, m in MARKETS.items():
+        got: dict[str, list[dict]] = {}
+        s = std.get(m.get("std") or "")
+        if m.get("std") and not s:
+            raise SystemExit(f"표준데이터에 '{m['std']}'이 없습니다 — 파일이 바뀌었는지 확인")
+        if s:
+            base = s.get("데이터기준일자") or ""
+            for key, v in (("opened", s.get("개설연도")),
+                           ("stores", f"{s['점포수']}개" if (s.get("점포수") or "").isdigit() else "")):
+                if v:
+                    got[key] = [row(STD, v, base, checked)]
+        groups = [(n, onn.get(n) or []) for n in m.get("onnuri") or []]
+        total = sum(len(rs) for _, rs in groups)
+        if total:
+            if len(groups) > 1:
+                detail = "·".join(f"{n.replace(' 골목형 상점가', '')} {len(rs)}곳" for n, rs in groups if rs)
+            else:
+                c = collections.Counter(x for x in (r.get("취급품목", "").strip() for r in groups[0][1]) if x and x != "기타")
+                detail = "취급품목 " + "·".join(f"{k} {v}곳" for k, v in c.most_common(TOP_ITEMS)) if c else ""
+            got["onnuri"] = [row(ONNURI, f"{total}곳" + (f"({detail})" if detail else ""), ONNURI["base_date"], checked)]
+            find = store_matcher(stores, points.get(pid)) if stores else None
+            lic = license_rows(root.parent / "licenses", stores, points.get(pid), points, pid, owners) if stores else []
+            shops, stalls = shop_groups([r for _, rs in groups for r in rs], find)
+            # a licence list joins only a group the market's own 온누리 shops have (a fashion street or an underground
+            # mall gets no '정육점 nearby' line); 상가정보 stores of a kind (떡/한과) join the same way; an old (support)
+            # list keeps only the rows whose name is a shop the group already has (2026 온누리 or those stores)
+            lic = [lc for lc in lic + (store_kind_rows(stores, points.get(pid), points, pid, owners) if stores else [])
