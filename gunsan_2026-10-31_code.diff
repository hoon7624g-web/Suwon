+.sg-s { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 52px; padding: 0 8px; border-radius: 10px; color: var(--ink); font: 700 18px/1.25 var(--font); letter-spacing: -.025em; text-decoration: none; cursor: pointer; list-style: none; transition: background-color .2s var(--fb); }
