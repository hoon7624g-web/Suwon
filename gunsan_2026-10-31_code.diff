+    load = lambda n: B._load(tmp_path / f"{n}.json", {}) or {}   # noqa: E731
+    return types.SimpleNamespace(today=today, almanac=load("almanac"), crowd=load("crowd"),
+                                 beaches=load("beaches"), ferry={})
