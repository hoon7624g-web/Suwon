+
+def pet_value(detail: dict) -> str:
+    """'동반 구분 일부구역 동반가능 · 동반 가능 동물 소형견 · …' — the service's own words, each under its label."""
+    return " · ".join(f"{label} {squash_ws(detail.get(k))}" for k, label in FIELDS if squash_ws(detail.get(k)))
+
+
+def apply_pet(place: dict, value: str, contentid: str, checked: str, provider: str = PROVIDER) -> str:
+    """Puts one pet value on a place: 'set' (none before), 'alt' (another source's different value kept beside it),
+    'same' (the value is there already)."""
+    facts = place.setdefault("facts", {})
+    src = {"provider": provider, "checked_at": checked, "contentid": contentid}
+    have = squash_ws(facts.get("pet"))
+    if not have:
+        facts["pet"] = value
+        place.setdefault("fact_sources", {})["pet"] = src
+        return "set"
+    alts = place.setdefault("fact_alternatives", {}).setdefault("pet", [])
+    if have == value or any(squash_ws(a.get("value")) == value for a in alts):
+        if not alts:
+            place["fact_alternatives"].pop("pet")
+        return "same"
+    alts.append({"value": value, **src})
+    return "alt"
+
+
+def camp_page(cid: str) -> str:
+    return f"https://www.gocamping.or.kr/bsite/camp/info/read.do?c_no={cid}"
+
+
+def _words(v) -> str:
+    """'전기,장작판매,온수' -> '전기, 장작판매, 온수' (the service's words, its own order)."""
+    return ", ".join(x.strip() for x in str(v or "").split(",") if x.strip())
+
+
+def new_camp(c: dict, checked: str, taken: set) -> dict:
+    """A draft place for a 고캠핑 campsite the site does not have. Facts are the service's values under their labels;
+    the site counts and the service's own type words stay in `gocamping` (for the summary a person writes)."""
+    cid = str(c.get("contentId") or "")
+    name = squash_ws(c.get("facltNm"))
+    slug, n = slugify(name), 2
+    while slug in taken:
+        slug, n = f"{slugify(name)}-{n}", n + 1
+    taken.add(slug)
+    period = " · ".join(x for x in (_words(c.get("operPdCl")).replace(", ", "·"), squash_ws(c.get("operDeCl"))) if x)
+    sub = _words(c.get("sbrsCl")) + (f" (기타: {squash_ws(c.get('sbrsEtc'))})" if squash_ws(c.get("sbrsEtc")) else "")
+    facts = {k: v for k, v in (
+        ("address", squash_ws(f"{c.get('addr1') or ''} {c.get('addr2') or ''}")), ("infocenter", squash_ws(c.get("tel"))),
+        ("homepage", squash_ws(c.get("homepage"))), ("openperiod", period), ("subfacility", sub),
+        ("reservation", _words(c.get("resveCl"))), ("pet", squash_ws(c.get("animalCmgCl")))) if v}
+    src = {"provider": CAMP_PROVIDER, "checked_at": checked, "contentid": cid, "url": camp_page(cid)}
+    place = {
+        "id": f"gocamping-{cid}", "name": name, "slug": slug, "kind": "attraction", "category": "레포츠",
+        "themes": [], "tier": "basic", "status": "draft",
+        "official": {"homepage": facts["homepage"]} if facts.get("homepage") else {},
+        "original": {}, "map_ids": {"naver_place_id": "", "google_place_id": ""}, "images": [],
+        "facts": facts, "facts_source": dict(src), "fact_sources": {k: dict(src) for k in facts},
+        "summary": "",
+        "gocamping": {"contentid": cid, "name": name, "induty": _words(c.get("induty")),
+                      "sites": {k: int(c.get(f) or 0) for k, f in (("general", "gnrlSiteCo"), ("auto", "autoSiteCo"),
+                                                                   ("glamping", "glampSiteCo"), ("caravan", "caravSiteCo"))
+                                if int(c.get(f) or 0)},
+                      "glamping_inside": _words(c.get("glampInnerFclty")), "manage": squash_ws(c.get("manageSttus")),
+                      "modifiedtime": squash_ws(c.get("modifiedtime")), "url": camp_page(cid)},
+    }
+    try:
+        place["geo"] = {"lat": float(c["mapY"]), "lng": float(c["mapX"]), "source": CAMP_PROVIDER,
+                        "url": camp_page(cid), "checked_at": checked}
+    except (KeyError, TypeError, ValueError):
+        pass
+    return place
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--data", type=Path, required=True)
+    ap.add_argument("--apply", action="store_true")
+    ap.add_argument("--add-camps", action="store_true", help="이 사이트에 없는 고캠핑 캠핑장을 draft 장소로 추가")
+    ap.add_argument("--max-calls", type=int, default=120)
+    a = ap.parse_args(argv)
+    key = os.environ.get("TOURAPI_KEY", "").strip()
+    if not key:
+        raise SystemExit("TOURAPI_KEY가 없습니다 (환경 변수)")
+    api = TourAPI(key, base_url=PET_BASE, cache_dir=Path("data/cache/tourapi/pet"), max_calls=a.max_calls)
+    items = api.call("areaBasedList", numOfRows=100, pageNo=1, arrange="A", **REGION)
+    places = json.loads((a.data / "places.json").read_text("utf-8"))
+    by_cid = {str((p.get("tourapi") or {}).get("contentid") or p["id"].removeprefix("tourapi-")): p for p in places}
+    checked = dt.date.today().isoformat()
+    out = {"listed": len(items), "matched": 0, "set": 0, "alt": 0, "same": 0}
+    for it in items:
+        cid = str(it.get("contentid") or "")
+        p = by_cid.get(cid)
+        if not p:
+            continue
+        detail = (api.call("detailPetTour", contentId=cid) or [{}])[0]
+        value = pet_value(detail)
+        if not value:
+            continue
+        out["matched"] += 1
+        how = apply_pet(p, value, cid, checked)
+        out[how] += 1
+        print(f"{how:4} {p['name']} [{p.get('status')}]: {value[:90]}")
+    # 캠핑장: 고캠핑의 군산시 캠핑장, 이름이 같은 장소에만
+    camp = TourAPI(key, base_url=CAMP_BASE, op_suffix="", cache_dir=Path("data/cache/tourapi/gocamping"), max_calls=a.max_calls)
+    by_name = {squash_ws(p["name"]).replace(" ", ""): p for p in places}
+    taken = {p["slug"] for p in places}
+    out["added"] = 0
+    page = 1
+    while True:
+        rows = camp.call("basedList", numOfRows=500, pageNo=page)
+        for c in rows:
+            if "군산" not in (c.get("sigunguNm") or "") + (c.get("addr1") or ""):
+                continue
+            p = by_name.get(squash_ws(c.get("facltNm")).replace(" ", ""))
+            value = squash_ws(c.get("animalCmgCl"))
+            if not p:
+                print(f"사이트에 없는 캠핑장: {c.get('facltNm')} ({c.get('addr1')})")
+                if a.add_camps and (c.get("manageSttus") or "운영") == "운영":
+                    new = new_camp(c, checked, taken)
+                    places.append(new)
+                    by_name[squash_ws(new["name"]).replace(" ", "")] = new
+                    out["added"] += 1
+                    print(f"  → 새 장소(draft) {new['id']} /places/{new['slug']}/")
+                continue
+            if value:
+                how = apply_pet(p, value, str(c.get("contentId") or ""), checked, CAMP_PROVIDER)
+                out[how] += 1
+                print(f"{how:4} {p['name']} [{p.get('status')}]: 반려동물 동반 {value} (고캠핑)")
+        if len(rows) < 500:
+            break
+        page += 1
+    out["calls"] = api.live_calls + camp.live_calls
+    if a.apply:
+        (a.data / "places.json").write_text(json.dumps(places, ensure_ascii=False, indent=2) + "\n", "utf-8")
+    print(json.dumps(out, ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
