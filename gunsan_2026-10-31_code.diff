+.sd-k { font: 700 12.5px/1.35 var(--font); color: var(--sea-deep); letter-spacing: -.01em; }
+.sd-sun .sd-k { flex-basis: 100%; }
+.sd-sv { font: 400 13.5px/1.3 var(--font); color: var(--ink-2); white-space: nowrap; }
