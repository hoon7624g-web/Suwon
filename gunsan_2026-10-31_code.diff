+                            "url": "https://www.data.go.kr/data/15060883/openapi.do"}},
+    "places": {
+        "f1": {"status": "영업", "kind": "일반음식점", "kind_detail": "한식", "name": "가게 군산점", "licensed_at": "2022-05-24",
+               "tel": "070-0000-0000", "source": "general_restaurants",
