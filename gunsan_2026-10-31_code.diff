+.sd-act.is-pri:hover { border-color: #000; background: #000; color: #fff; }
+.sd-act:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
+
+/* the groups: a summary row per group (a single tab is a link row with an arrow), the links under it */
