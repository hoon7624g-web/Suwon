diff --git a/templates/assets/css/79-courses.css b/templates/assets/css/79-courses.css
new file mode 100644
index 0000000000..62ab655d8b
--- /dev/null
+++ b/templates/assets/css/79-courses.css
@@ -0,0 +1,94 @@
+/* 코스 목록 (operator 2026-10-31: '이런 곳들 UI도 좀 더 고도화할 방안 없나?'; templates/_courses.html.j2, every version's
+   courses page). The group pills under the heading (one sideways row on a phone, 44px), then per group an eyebrow, the
+   heading with its count and the stop range, and the cards: phones one column — the photo (112px, 4:3) beside the chip
+   and the name, the route band and the foot under them; from 720px two columns (three from 1100px) with the photo on
+   top (3:2, the ratio of most TourAPI photos); a group of one course lies on its side (photo left). A KOGL-3 photo is
+   kept whole on a tint (the img.t3 guard of 30-info.css); only a KOGL-1 photo zooms on hover. The card's one link is
+   its name (::after covers the card). The route band's line and dots draw with --p (motion.js [data-draw], 0 → 1;
+   unset = 1: the final state without JS or under reduced motion); the card is a [data-reveal] tile. */
+.cc-nav { margin-top: 18px; }
+.cc-nav ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
+.cc-nav a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 16px; border-radius: 999px; background: #fff; box-shadow: inset 0 0 0 1px var(--hair); color: var(--ink); font-size: 15px; font-weight: 700; white-space: nowrap; text-decoration: none; transition: background-color .2s, box-shadow .2s; }
+.cc-nav a .tn { color: var(--sea-deep); }
+.cc-nav a:hover { background: var(--tint); box-shadow: inset 0 0 0 1px var(--tint2); text-decoration: none; }
+@media (max-width: 719px) {
+  .cc-nav ul { flex-wrap: nowrap; overflow-x: auto; margin: 0 calc(var(--m) * -1); padding: 2px var(--m) 4px; scroll-padding-inline: var(--m); scrollbar-width: none; }
+  .cc-nav ul::-webkit-scrollbar { display: none; }
+  .cc-nav a { padding: 0 14px; font-size: 14px; }
+}
+.cc-wrap { padding-bottom: var(--sec); }
+.cc-sec { margin-top: var(--s-bl); scroll-margin-top: calc(var(--mh-s, 52px) + 16px); }
+.cc-sh { margin-bottom: 18px; }
