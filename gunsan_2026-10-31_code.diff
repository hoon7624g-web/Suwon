+    print(f"호출 {budget.used}회 · 해수욕장정보 {SIDO} {len(info)}행(군산 {data['sources']['info']['rows_gunsan']}) · "
+          f"수질 " + ", ".join(f"{y} {len(water_by_year[y])}행(군산 "
+                                f"{sum(r.get('gugun_nm') == GUGUN for r in water_by_year[y])})" for y in water_by_year))
