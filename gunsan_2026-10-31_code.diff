+            continue
+        sta_place[r.get("sta_nm")] = pid
+        out[pid] = {"name": by_name[pid].get("name"), "sta_nm": r.get("sta_nm"),
+                    "info": {k: unescape(v) for k, v in r.items() if k not in DROP}, "match": how}
