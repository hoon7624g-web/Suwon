+.wx.is-ready .wx-go { font-weight: 400; color: var(--ink-3); }
+/* the kept room (with JS): the filled module's height; built or failed, the link sits in it */
+html.js .wx-side { height: 132px; }
+html.js .wx-side.wx-intl { height: 110px; }   /* no headline in the other versions */
