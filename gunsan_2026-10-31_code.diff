+def apply_rows(places: list[dict], rows: dict[str, dict[str, list[dict]]]) -> int:
+    """Replaces this provider's rows of KEYS in each place's market, keeps every other source's. Returns places changed."""
+    by = {p["id"]: p for p in places}
