+                else:
+                    cur = " ".join(x for x in (group, "" if label.replace(" ", "") in BASE_WORDS else label) if x)
+                    rows.append({"cond": cur, "a": a, "b": b, "sec": "", "label": label})
+                pos = m.end()
+            tail = part[pos:]
+            for par in re.findall(r"\(([^()]*)\)", tail):
