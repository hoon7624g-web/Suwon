+    "방축도": ["tourapi-126296"],                                # 방축도(옥도면 방축도길)
+    "명도": ["tourapi-3590209"],                                 # 명도(옥도면 명도길)
+    "말도": ["tourapi-3592202"],                                 # 말도(옥도면 말도리)
