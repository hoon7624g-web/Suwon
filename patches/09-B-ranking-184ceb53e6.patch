From 184ceb53e605a5f9f2cbc67103d145d48906a9b9 Mon Sep 17 00:00:00 2001
From: hoon7624g-web <272256230+hoon7624g-web@users.noreply.github.com>
Date: Tue, 10 Nov 2026 10:33:49 +0900
Subject: [PATCH] Fix YouTube/Instagram buttons in right curation board to
 switch tabs in place

---
 templates/assets/css/48-abroad.css | 10 ++++++++--
 templates/assets/motion.js         |  2 +-
 templates/assets/site.js           |  1 +
 templates/home.html.j2             | 31 +++++++++++++++++++++++-------
 4 files changed, 34 insertions(+), 10 deletions(-)

diff --git a/templates/assets/css/48-abroad.css b/templates/assets/css/48-abroad.css
index 4373c75c48..b5bd4243b2 100644
--- a/templates/assets/css/48-abroad.css
+++ b/templates/assets/css/48-abroad.css
@@ -260,11 +260,17 @@ html.embed-manual .ab-ph-msg { display: none; }
 .hrs-kicker { margin: 0; font: 700 12px/1.3 var(--font); color: var(--sea-deep); letter-spacing: -.01em; }
 .hrs-title { margin: 0; font: 800 20px/1.25 var(--font); color: var(--ink); letter-spacing: -.03em; }
 .hrs-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 4px; }
-.hrs-tab { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 36px; padding: 0 10px;
-  border-radius: 10px; background: var(--bg-2); color: var(--ink); font: 700 13px/1 var(--font); text-decoration: none; }
+.hrs-tab { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 38px; padding: 0 10px;
+  border: 1.5px solid transparent; border-radius: 10px; background: var(--bg-2); color: var(--ink-2); font: 800 13.5px/1 var(--font); text-decoration: none; cursor: pointer; transition: background .15s, border-color .15s, color .15s; }
 .hrs-tab:hover { background: var(--tint); color: var(--sea-deep); text-decoration: none; }
+.hrs-tab.is-yt[aria-selected="true"] { background: #FFF1F0; border-color: #E62117; color: #B42318; box-shadow: 0 1px 3px rgba(230, 33, 23, .12); }
+.hrs-tab.is-ig[aria-selected="true"] { background: #FDF2F8; border-color: #DB2777; color: #9D174D; box-shadow: 0 1px 3px rgba(219, 39, 119, .12); }
+.hrs-tab:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
 .hrs-tab .ab-svc { width: 20px; height: 20px; }
 .hrs-tab .ab-svc svg { width: 12px; height: 12px; }
+.hrs-panel { display: flex; flex-direction: column; gap: 16px; }
+html.js .hrs-panel[data-tab-off] { display: none; }
+.hrs-ig-note { font: 500 12.5px/1.4 var(--font); color: var(--ink-2); word-break: keep-all; }
 .hrs-sec { display: flex; flex-direction: column; gap: 10px; }
 .hrs-sec + .hrs-sec { padding-top: 14px; border-top: 1px solid var(--bg-3); }
 .hrs-sh { display: flex; align-items: baseline; justify-content: space-between; gap: 6px; }
diff --git a/templates/assets/motion.js b/templates/assets/motion.js
index 6b9e3c7c88..4526c338db 100644
--- a/templates/assets/motion.js
+++ b/templates/assets/motion.js
@@ -413,7 +413,7 @@
       var a = e.target.closest && e.target.closest('a[href^="#"]');
       if (!a || e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
       var id = decodeURIComponent(a.getAttribute("href").slice(1)), t = id && doc.getElementById(id);
-      if (!t) return;
+      if (!t || (t.closest && t.closest("[data-lenis-prevent]"))) return;
       e.preventDefault();
       lenis.scrollTo(t, { offset: -(mastH() + 16), duration: 0.9, onComplete: function () {
         if (!t.hasAttribute("tabindex") && !/^(A|BUTTON|INPUT|SELECT|TEXTAREA|SUMMARY)$/.test(t.tagName)) t.setAttribute("tabindex", "-1");
diff --git a/templates/assets/site.js b/templates/assets/site.js
index e5fc6af3df..cf4f23daca 100644
--- a/templates/assets/site.js
+++ b/templates/assets/site.js
@@ -1554,6 +1554,7 @@
           x.tabIndex = on ? 0 : -1;
           if (p) { if (on) p.removeAttribute("data-tab-off"); else p.setAttribute("data-tab-off", ""); }
         });
+        if (box.scrollTop > 0) box.scrollTop = 0;
         if (focus) t.focus();
       };
       tabs.forEach(function (t, i) {
diff --git a/templates/home.html.j2 b/templates/home.html.j2
index 50eeb3780d..6d27192e76 100644
--- a/templates/home.html.j2
+++ b/templates/home.html.j2
@@ -55,16 +55,17 @@
 {% set N = h.news|length %}
 {% set ASK = ask_starters is defined and ask_starters is not none %}
 {% if popular_videos or yt_channels or insta_channels %}
-<aside class="h-rside" aria-label="{{ site.region }} 인기 유튜브·인스타그램 큐레이션" data-lenis-prevent>
+<aside class="h-rside" aria-label="{{ site.region }} 인기 유튜브·인스타그램 큐레이션" data-lenis-prevent data-tabs>
   <div class="hrs-head">
     <p class="hrs-kicker">SNS · 크리에이터 큐레이션</p>
     <h2 class="hrs-title">인기 유튜브 · 인스타</h2>
-    <div class="hrs-tabs">
-      <a class="hrs-tab is-yt" href="#hrs-yt">{{ ab.svc('youtube') }}<span>YouTube</span></a>
-      <a class="hrs-tab is-ig" href="#hrs-ig">{{ ab.svc('instagram') }}<span>Instagram</span></a>
+    <div class="hrs-tabs" role="tablist" aria-label="유튜브·인스타그램 전환">
+      <button type="button" class="hrs-tab is-yt" role="tab" id="hrs-tab-yt" aria-controls="hrs-panel-yt" aria-selected="true">{{ ab.svc('youtube') }}<span>YouTube</span></button>
+      <button type="button" class="hrs-tab is-ig" role="tab" id="hrs-tab-ig" aria-controls="hrs-panel-ig" aria-selected="false" tabindex="-1">{{ ab.svc('instagram') }}<span>Instagram</span></button>
     </div>
   </div>
   {% if popular_videos %}
+  <div class="hrs-panel" role="tabpanel" id="hrs-panel-yt" aria-labelledby="hrs-tab-yt">
   <div class="hrs-sec" id="hrs-yt">
     <div class="hrs-sh"><h3>화제의 {{ site.region }} 유튜브</h3><a href="/videos/#yt-popular">전체 보기<span class="arr" aria-hidden="true">→</span></a></div>
     <ul class="hrs-vlist">
@@ -89,7 +90,7 @@
   <div class="hrs-sec">
     <div class="hrs-sh"><h3>인기 유튜브 채널 <span class="tn">{{ yt_channels|length }}</span></h3><a href="/videos/#yt-channels">모두 보기<span class="arr" aria-hidden="true">→</span></a></div>
     <ul class="hrs-clist">
-      {% for ch in yt_channels[:8] %}
+      {% for ch in yt_channels %}
       <li class="hrs-c">
         <a class="hrs-ctop" href="{{ ch.url }}" target="_blank" rel="noopener" data-track="video_click">{{ ab.svc('youtube') }}<span class="hrs-cn"><strong class="hrs-cname">{{ ch.name }}<span class="hrs-ext" aria-hidden="true">↗</span></strong><span class="hrs-cmeta">{% if ch.badge %}<em class="hrs-badge">{{ ch.badge }}</em>{% endif %}<span>{{ ch.handle }}</span></span></span></a>
         {% if ch.links %}<p class="hrs-clinks">{% for l in ch.links[:3] %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}</p>{% endif %}
@@ -99,10 +100,12 @@
   </div>
   {% endif %}
   {% if insta_channels %}
+  </div>
+  <div class="hrs-panel" role="tabpanel" id="hrs-panel-ig" aria-labelledby="hrs-tab-ig" data-tab-off>
   <div class="hrs-sec" id="hrs-ig">
-    <div class="hrs-sh"><h3>인기 인스타 채널 · 대형카페</h3><a href="/guides/군산-카페/#h-insta">카페 가이드<span class="arr" aria-hidden="true">→</span></a></div>
+    <div class="hrs-sh"><h3>인기 인스타 채널 <span class="tn">{{ insta_channels|length }}</span></h3><a href="/guides/군산-카페/#h-insta">카페 가이드<span class="arr" aria-hidden="true">→</span></a></div>
     <ul class="hrs-clist">
-      {% for ch in insta_channels[:7] %}
+      {% for ch in insta_channels %}
       <li class="hrs-c">
         <a class="hrs-ctop" href="{{ ch.url }}" target="_blank" rel="noopener" data-track="abroad_click">{{ ab.svc('instagram') }}<span class="hrs-cn"><strong class="hrs-cname">{{ ch.name }}<span class="hrs-ext" aria-hidden="true">↗</span></strong><span class="hrs-cmeta">{% if ch.badge %}<em class="hrs-badge">{{ ch.badge }}</em>{% endif %}<span>{{ ch.handle }}</span></span></span></a>
         {% if ch.links %}<p class="hrs-clinks">{% for l in ch.links[:3] %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}</p>{% endif %}
@@ -111,6 +114,20 @@
     </ul>
   </div>
   {% endif %}
+  {% if home_insta %}
+  <div class="hrs-sec">
+    <div class="hrs-sh"><h3>화제의 인스타 대형·감성 카페</h3><a href="/guides/군산-카페/#h-insta">전체 {{ n_insta }}편<span class="arr" aria-hidden="true">→</span></a></div>
+    <ul class="hrs-clist">
+      {% for a in home_insta[:5] %}
+      <li class="hrs-c">
+        <a class="hrs-ctop" href="/guides/군산-카페/#{{ a.id }}" data-track="abroad_click">{{ ab.svc('instagram') }}<span class="hrs-cn"><strong class="hrs-cname">{{ a.author or 'Instagram' }}<span class="hrs-ext" aria-hidden="true">›</span></strong><span class="hrs-ig-note">{{ a.note }}</span></span></a>
+        {% if a.place_slugs %}<p class="hrs-clinks">{% for s in a.place_slugs[:3] %}{% if s in places %}<a href="{{ places[s]._path }}">{{ places[s].name }}</a>{% endif %}{% endfor %}</p>{% endif %}
+      </li>
+      {% endfor %}
+    </ul>
+  </div>
+  {% endif %}
+  </div>
 </aside>
 {% endif %}
 <div class="hk"{% if ASK %} data-chat-dock{% endif %}>
