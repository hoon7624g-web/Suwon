-.hrs-vth img { display: block; width: 100%; height: 100%; object-fit: cover; }
-.hrs-play { position: absolute; right: 5px; bottom: 5px; width: 22px; height: 22px; border-radius: 50%;
-  background: rgba(230, 33, 23, .92); color: #fff; display: grid; place-items: center; }
