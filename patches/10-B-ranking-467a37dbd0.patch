+.hrs-head { display: flex; flex-direction: column; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid var(--bg-3); }
+.hrs-title { margin: 0; font: 700 18.5px/1.25 var(--font); color: var(--ink); letter-spacing: -.035em; }
