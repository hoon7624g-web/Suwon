+.hrs-play { position: absolute; right: 6px; bottom: 5px; width: 22px; height: 22px; border-radius: 50%;
+  background: rgba(15, 23, 42, .74); backdrop-filter: blur(4px); color: #fff; display: grid; place-items: center; }
