-  border-radius: 999px; background: var(--bg-2); color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--hair);
-  font: 600 11.5px/1.2 var(--font); text-decoration: none; }
-.hrs-vp a { background: #fff; }
+  border-radius: 7px; background: var(--bg-2); color: var(--ink-2);
+  font: 600 11.5px/1.2 var(--font); letter-spacing: -.01em; text-decoration: none; transition: background .15s, color .15s; }
 .hrs-vp a:hover, .hrs-clinks a:hover { background: var(--tint); color: var(--sea-deep); text-decoration: none; }
-.hrs-c { display: flex; flex-direction: column; gap: 8px; padding: 11px 12px; border-radius: 14px; background: #fff; border: 1px solid var(--hair); box-shadow: 0 1px 2px rgba(15, 23, 42, .04); }
-.hrs-ctop { display: flex; align-items: flex-start; gap: 9px; min-width: 0; color: var(--ink); text-decoration: none; }
+.hrs-c { display: flex; flex-direction: column; gap: 6px; padding: 10px 4px; border-bottom: 1px solid var(--bg-3); }
+.hrs-c:first-child { padding-top: 4px; }
+.hrs-c:last-child { border-bottom: 0; padding-bottom: 2px; }
+.hrs-ctop { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 6px; align-items: baseline; min-width: 0; color: var(--ink); text-decoration: none; }
 .hrs-ctop:hover { text-decoration: none; }
-.hrs-ctop:hover .hrs-cname { color: var(--sea-deep); text-decoration: underline; }
-.hrs-ctop .ab-svc { width: 28px; height: 28px; flex: none; margin-top: 1px; }
-.hrs-ctop .ab-svc svg { width: 15px; height: 15px; }
-.hrs-cn { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
-.hrs-cname { display: inline-flex; align-items: center; gap: 4px; font: 800 16px/1.28 var(--font); color: var(--ink); letter-spacing: -.02em; word-break: keep-all; }
-.hrs-ext { font-size: 12px; font-weight: 700; color: var(--ink-3); }
-.hrs-cmeta { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; font: 600 12px/1.35 var(--font); color: var(--ink-2); }
-.hrs-badge { flex: none; font-style: normal; padding: 2px 7px; border-radius: 999px; background: var(--tint); color: var(--sea-deep); font: 700 11px/1.25 var(--font); }
+.hrs-ctop:hover .hrs-cname { color: var(--sea-deep); text-decoration: underline; text-underline-offset: 2px; }
+.hrs-num { font: 700 12.5px/1.3 var(--font); color: var(--sea); letter-spacing: -.02em; }
+.hrs-cn { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.hrs-crow { display: flex; align-items: baseline; justify-content: space-between; gap: 6px; min-width: 0; }
+.hrs-cname { display: inline-flex; align-items: baseline; gap: 3px; font: 700 15.5px/1.3 var(--font); color: var(--ink); letter-spacing: -.025em; word-break: keep-all; }
+.hrs-ext { font-size: 11.5px; font-weight: 400; color: var(--ink-3); }
+.hrs-csub { font: 400 12px/1.35 var(--font); color: var(--ink-3); }
+.hrs-ig-note { font: 400 12.5px/1.42 var(--font); color: var(--ink-2); word-break: keep-all; }
+.hrs-badge { flex: none; font-style: normal; font: 600 11px/1.2 var(--font); color: var(--sea-deep); letter-spacing: -.01em; }
 
