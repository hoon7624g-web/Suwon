+++ b/templates/_share.html.j2
@@ -0,0 +1,54 @@
+{#- _share.html.j2 — 보내기 (pipeline/share.py; operator 2026-11-11 '공유하기 버튼을 크게 … 여기저기 공유하기 쉽게', the
+    recommended placement approved the same day). css/88-share.css lays it out, site.js [data-shr] works it.
+
+    box(S, title, hid, sub, cls): one address (S = share.view(url, title, id)) as tiles with a picture and a word each.
+      Phones (below 1024px): 카카오톡 · 링크 복사 · 문자 · 더보기 (the phone's own share sheet — shown by site.js only
+      when the browser has one); from 1024px: 카카오톡 · 링크 복사 · 페이스북 · X · 밴드 and the QR code that opens the
+      page on a phone. 카카오톡, 링크 복사 and 더보기 need JavaScript (data-js-only); 문자 · 페이스북 · X · 밴드 are plain
+      links, each already carrying utm_source=share&utm_medium=<method>. The title is a paragraph, not a heading: the
+      page's outline stays its information. The pictures are the services' own marks (decorative: the word says it).
+    dialog(S, words): the site's box in a <dialog> (the panel's and the phone menu's '군산각 공유하기', opener()).
+    opener(cls): that row — a link to the home's box (#share) without JavaScript, the dialog with it. -#}
+
+{% macro icon(name) -%}
+{%- if name == 'kakao' -%}<svg class="shr-ic" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" fill="#FEE500"/><path fill="#191919" d="M16 8.4c-4.8 0-8.7 3.06-8.7 6.84 0 2.44 1.62 4.58 4.07 5.79l-.83 3.04c-.07.27.23.48.46.33l3.62-2.4c.45.05.92.08 1.38.08 4.8 0 8.7-3.06 8.7-6.84S20.8 8.4 16 8.4z"/></svg>
+{%- elif name == 'copy' -%}<svg class="shr-ic" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" fill="#EAF2FC"/><path fill="none" stroke="#1D4F96" stroke-width="2" stroke-linecap="round" d="M14.2 17.8l3.6-3.6M13.6 12.3l1.5-1.5a3.7 3.7 0 0 1 5.2 5.2l-1.5 1.5M18.4 19.7l-1.5 1.5a3.7 3.7 0 0 1-5.2-5.2l1.5-1.5"/></svg>
+{%- elif name == 'sms' -%}<svg class="shr-ic" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" fill="#2FB24C"/><path fill="#fff" d="M16 8.6c-4.75 0-8.6 3-8.6 6.7 0 2.1 1.24 3.97 3.18 5.2-.2 1.1-.78 2.2-1.6 3.03 1.7-.08 3.3-.66 4.48-1.62.82.17 1.67.26 2.54.26 4.75 0 8.6-3 8.6-6.87S20.75 8.6 16 8.6z"/></svg>
+{%- elif name == 'more' -%}<svg class="shr-ic" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" fill="#EAF2FC"/><path fill="none" stroke="#1D4F96" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M16 7.5v11M12.3 11.2 16 7.5l3.7 3.7M11.5 14.5h-.8a1.2 1.2 0 0 0-1.2 1.2v6.6a1.2 1.2 0 0 0 1.2 1.2h10.6a1.2 1.2 0 0 0 1.2-1.2v-6.6a1.2 1.2 0 0 0-1.2-1.2h-.8"/></svg>
+{%- elif name == 'facebook' -%}<svg class="shr-ic" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" fill="#1877F2"/><path fill="#fff" d="M17.6 26v-8.2h2.75l.42-3.2H17.6v-2.04c0-.93.26-1.56 1.59-1.56h1.7V8.14A22.6 22.6 0 0 0 18.42 8c-2.45 0-4.12 1.5-4.12 4.23v2.37h-2.76v3.2h2.76V26z"/></svg>
+{%- elif name == 'x' -%}<svg class="shr-ic" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" fill="#111"/><path fill="#fff" d="M20.4 8.5h2.6l-5.68 6.49L24 23.5h-5.24l-4.1-5.36-4.69 5.36H7.37l6.07-6.94L7 8.5h5.37l3.7 4.9zm-.91 13.5h1.44L11.6 9.92h-1.54z"/></svg>
+{%- elif name == 'band' -%}<svg class="shr-ic" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" fill="#21C24E"/><path fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" d="M12.4 8.6v14.6M12.4 18.1a4.6 4.6 0 1 0 9.2 0 4.6 4.6 0 1 0-9.2 0"/></svg>
+{%- endif -%}
+{%- endmacro %}
+
+{% macro box(S, title, hid, sub='', cls='') -%}
+<div class="shr{{ ' ' ~ cls if cls }}" role="group" aria-labelledby="{{ hid }}" data-shr data-shr-url="{{ S.url }}" data-shr-title="{{ S.title }}" data-shr-id="{{ S.id }}"{% if kakao_key %} data-shr-key="{{ kakao_key }}" data-shr-sdk="{{ kakao_share_sdk }}" data-shr-sri="{{ kakao_share_sri }}"{% endif %} data-copied="링크를 복사했습니다" data-failed="링크를 복사하지 못했습니다" data-kakao-failed="카카오톡을 열지 못해 링크를 복사했습니다"><div class="shr-in">
+  <div class="shr-main">
+    <p class="shr-h" id="{{ hid }}">{{ ui_share_icon() }}<span>{{ title }}</span></p>
+    {% if sub %}<p class="shr-s">{{ sub }}</p>{% endif %}
+    <ul class="shr-l">
+      {% if kakao_key %}<li data-js-only><button type="button" class="shr-b" data-shr-do="kakao">{{ icon('kakao') }}<span class="shr-t">카카오톡</span></button></li>{% endif %}
+      <li data-js-only><button type="button" class="shr-b" data-shr-do="copy_link">{{ icon('copy') }}<span class="shr-t">링크 복사</span></button></li>
+      <li class="shr-ph"><a class="shr-b" href="{{ S.sms }}" data-shr-do="sms">{{ icon('sms') }}<span class="shr-t">문자</span></a></li>
+      <li class="shr-ph" data-js-only data-shr-native hidden><button type="button" class="shr-b" data-shr-do="web_share">{{ icon('more') }}<span class="shr-t">더보기</span></button></li>
+      <li class="shr-pc"><a class="shr-b" href="{{ S.facebook }}" target="_blank" rel="noopener" data-shr-do="facebook">{{ icon('facebook') }}<span class="shr-t">페이스북</span><span class="vh"> (새 창)</span></a></li>
+      <li class="shr-pc"><a class="shr-b" href="{{ S.x }}" target="_blank" rel="noopener" data-shr-do="x">{{ icon('x') }}<span class="shr-t">X</span><span class="vh"> (새 창)</span></a></li>
+      <li class="shr-pc"><a class="shr-b" href="{{ S.band }}" target="_blank" rel="noopener" data-shr-do="band">{{ icon('band') }}<span class="shr-t">밴드</span><span class="vh"> (새 창)</span></a></li>
+    </ul>
+  </div>
+  <figure class="shr-qr shr-pc">{{ S.qr|safe }}<figcaption>휴대폰 카메라로 찍으면<br>이 페이지가 열립니다</figcaption></figure>
+</div></div>
+{%- endmacro %}
+
+{% macro ui_share_icon() -%}<svg class="shr-h-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v12M7.5 7.5 12 3l4.5 4.5M6 11H5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1h-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endmacro %}
+
+{% macro dialog(S, title, sub) -%}
+<dialog class="shr-dlg" id="shr-site" aria-labelledby="shr-site-h" data-shr-dlg>
+  <form method="dialog" class="shr-dlg-f"><button type="submit" class="shr-dlg-x"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span class="vh">닫기</span></button></form>
+  {{ box(S, title, 'shr-site-h', sub, 'shr-in-dlg') }}
+</dialog>
+{%- endmacro %}
+
+{% macro opener(name) -%}
+<p class="sd-shr"><a class="sd-shr-a" href="/#share" data-shr-open="shr-site">{{ ui_share_icon() }}<span>{{ name }} 공유하기</span></a></p>
+{%- endmacro %}
