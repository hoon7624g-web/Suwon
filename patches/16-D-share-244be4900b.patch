diff --git a/templates/assets/css/88-share.css b/templates/assets/css/88-share.css
new file mode 100644
index 0000000000..1683439e37
--- /dev/null
+++ b/templates/assets/css/88-share.css
@@ -0,0 +1,84 @@
+/* 88-share — 보내기 (templates/_share.html.j2, pipeline/share.py, site.js [data-shr]; operator 2026-11-11 '공유하기
+   버튼을 크게 만드는 것도 좋을 것 같습니다. 여기저기 공유하기 쉽게', the recommended placement approved the same day).
+   A white card with a hairline (the facts' tiles stay the page's loudest thing; no accent fill: sea blue is the route,
+   yellow the booking button — 90-refine rule 1): its title with the share glyph, then tiles of the same size, each a
+   service's own mark (32px) over its name. Phones (below 1024px): 카카오톡 · 링크 복사 · 문자 · 더보기 in one row; from
+   1024px: 카카오톡 · 링크 복사 · 페이스북 · X · 밴드 and the QR code — beside the tiles when the card is wide enough
+   (container query: the place page's left column is narrower than a guide's), under them otherwise.
+   Every tile is at least 44px both ways; the QR code is drawn black on white with its quiet zone (scanners need it). */
+
+.shr { container-type: inline-size; margin: 22px 0 0; padding: 16px 16px 14px; border: 1px solid var(--hair); border-radius: 20px; background: var(--bg); }
+.shr-h { display: flex; align-items: center; gap: 8px; margin: 0; font: 700 16.5px/1.35 var(--font); letter-spacing: -.01em; color: var(--ink); }
+.shr-h-i { flex: none; width: 20px; height: 20px; color: var(--sea-deep); }
+.shr-s { margin: 4px 0 0; font-size: 14px; line-height: 1.5; color: var(--ink-3); }
+.shr-l { display: grid; grid-template-columns: repeat(auto-fit, minmax(64px, 1fr)); gap: 8px; margin: 12px 0 0; padding: 0; list-style: none; }
+.shr-l li { min-width: 0; }
+.shr-l li[hidden] { display: none; }
+.shr-b { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px; width: 100%; min-height: 78px; padding: 10px 4px 9px;
+  border: 0; border-radius: 16px; background: var(--bg-2); color: var(--ink); font: 400 13.5px/1.2 var(--font); text-align: center; text-decoration: none;
+  cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background-color .2s var(--fb), transform .2s var(--fb); }
+.shr-b:hover { background: var(--tint); color: var(--ink); text-decoration: none; }
+.shr-b:active { transform: scale(.97); }
+.shr-ic { flex: none; width: 32px; height: 32px; }
+.shr-t { display: block; max-width: 100%; word-break: keep-all; }
+.shr-pc, .shr-qr { display: none; }
+.shr-qr { margin: 0; }
+.shr-qr-i { display: block; flex: none; width: 104px; height: 104px; border-radius: 8px; background: #fff; }
+.shr-qr figcaption { font-size: 13px; line-height: 1.45; color: var(--ink-3); }
+@media (min-width: 1024px) {
+  .shr { padding: 18px 20px 18px; }
+  .shr .shr-ph { display: none; }
+  .shr .shr-pc { display: block; }
+  .shr-l { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+  /* a narrow card (the place page's column): the QR code under the tiles, its words beside it */
+  .shr .shr-qr { display: flex; align-items: center; gap: 14px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--hair); }
+  @container (min-width: 600px) {
+    .shr-in { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 24px; }
+    .shr .shr-qr { flex-direction: column; gap: 8px; margin: 0; padding: 0 0 0 24px; border-top: 0; border-left: 1px solid var(--hair); text-align: center; }
+  }
+}
+@media (prefers-reduced-motion: reduce) { .shr-b { transition: none; } .shr-b:active { transform: none; } }
+
+/* where it stands: a place page under its route row (and its booking rows), the readings and an event in their
+   column, the home before 제휴·관련 사이트 */
+.pl-head .shr { margin-top: 18px; }
+.shr-sec { padding-top: 8px; }
+.shr-sec .shr { margin-top: 0; }
+.shr-sec .shr, .home-shr .shr { max-width: 880px; }
+.home-shr { padding: 8px 0 40px; }
+.home-shr .shr { margin: 0; }
+
+/* the phones' bottom bars (tab bar, a place page's bar: z-index 80) would hide the note of a copied link */
+@media (max-width: 767px) {
+  body:has(.tabbar) .share-note, body:has(.pl-bar) .share-note { z-index: 85; bottom: calc(clamp(44px, calc(15svh - 52px), 68px) + 14px + env(safe-area-inset-bottom, 0px)); }
+}
+
+/* 숙박 예약하기 · 코스 목록 · 영상 · 블로그: the 공유 pill beside the title (ui.sharebtn cls 'ttl-share' in a .ttl-row) */
+.ttl-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
+.ttl-row > h1 { flex: 1 1 auto; min-width: 0; }
+.ttl-row > .ttl-share { margin: 4px 0 0; }
+@media (min-width: 1024px) { .ttl-row > .ttl-share { margin-top: 8px; } }
+
+/* '군산각 공유하기': the panel's row above 문의/제휴 (in its sticky foot from 1200px) and the phone menu's — a quiet row
+   (the partner card under it is the loud one) that opens the site's box in a dialog */
+.sd-shr { margin: 12px 0 0; }
+.sd-shr-a { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px; border-radius: 14px; background: var(--tint); color: var(--sea-deep); font: 700 14.5px/1.2 var(--font); text-decoration: none; }
+.sd-shr-a:hover { background: var(--tint2); color: var(--sea-deep); text-decoration: none; }
+.sd-shr-a .shr-h-i { width: 19px; height: 19px; }
+.menu-panel .sd-shr { margin: 10px 0 0; }
+.menu-panel .sd-shr + .sd-pt { margin-top: 8px; }
+@media (min-width: 1200px) {
+  .side .sd-foot { position: sticky; bottom: -18px; z-index: 3; margin: 4px -18px -18px; padding: 14px 18px 18px; background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0, #fff 16px); }
+  .side .sd-foot .sd-shr { margin: 0 0 8px; }
+  .side .sd-foot .sd-pt { position: static; margin: 0; padding: 0; background: none; }
+}
+
+/* the dialog: the site's box over a dimmed page; closes with its × button, Escape or a press outside (site.js) */
+.shr-dlg { width: min(560px, calc(100vw - 32px)); max-height: calc(100svh - 48px); margin: auto; padding: 0; border: 0; border-radius: 24px; background: var(--bg); color: var(--ink); box-shadow: var(--shadow-3); overflow: auto; }
+.shr-dlg::backdrop { background: rgba(23, 32, 51, .45); }
+.shr-dlg-f { position: absolute; top: 8px; right: 8px; z-index: 1; margin: 0; }
+.shr-dlg-x { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--ink-2); cursor: pointer; }
+.shr-dlg-x:hover { background: var(--bg-2); }
+.shr-dlg-x svg { width: 22px; height: 22px; }
+.shr-dlg .shr { margin: 0; padding: 22px 20px 20px; border: 0; }
+.shr-dlg .shr-h { padding-right: 44px; font-size: 18px; }
