 {% if cta %}<a class="lnav-cta" href="{{ cta.url }}"{% if cta.ext %} rel="noopener"{% endif %}{% if cta.track %} data-track="{{ cta.track }}"{% endif %}{% if cta.provider %} data-provider="{{ cta.provider }}"{% endif %}{% if cta.place %} data-place="{{ cta.place }}"{% endif %}>{{ cta.label }}</a>{% endif %}
