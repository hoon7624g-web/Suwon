-/* '군산각 공유하기': the panel's row above 문의/제휴 (in its sticky foot from 1200px) and the phone menu's — a quiet row
-   (the partner card under it is the loud one) that opens the site's box in a dialog */
+/* '군산각 공유하기': the panel's card above 문의/제휴 (in its sticky foot from 1200px) and the phone menu's — it opens the
+   site's box in a dialog. The same build as the partner card under it (tile · name over one line · chevron), in the
+   site's light sea instead of its dark gold (operator 2026-11-12 '좀 세련되면'): a white card with a sea hairline and a
+   soft sea glow at its corner, the 3D picture on a sea tile. The partner card stays the loud one. */
 .sd-shr { margin: 12px 0 0; }
-.sd-shr-a { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px; border-radius: 14px; background: var(--tint); color: var(--sea-deep); font: 700 14.5px/1.2 var(--font); text-decoration: none; }
-.sd-shr-a:hover { background: var(--tint2); color: var(--sea-deep); text-decoration: none; }
-.sd-shr-a .shr-h-i { width: 19px; height: 19px; }
+.sd-shr-a { position: relative; display: flex; align-items: center; gap: 12px; min-height: 54px; padding: 8px 14px 8px 8px; overflow: hidden;
+  border-radius: 16px; background: linear-gradient(135deg, #FFFFFF 0, #F2F7FD 100%); color: var(--ink); text-decoration: none;
+  box-shadow: inset 0 0 0 1px var(--tint2), 0 10px 22px -18px rgba(29, 79, 150, .55); transition: box-shadow .2s var(--fb), transform .2s var(--fb); }
+.sd-shr-a::before { content: ""; position: absolute; inset: 0; pointer-events: none;
+  background: radial-gradient(160px 60px at 92% 0, rgba(47, 111, 201, .12), rgba(47, 111, 201, 0) 70%); }
+.sd-shr-a:hover { color: var(--ink); text-decoration: none; transform: translateY(-1px);
+  box-shadow: inset 0 0 0 1.5px var(--sea), 0 14px 26px -18px rgba(29, 79, 150, .7); }
+.sd-shr-ic { position: relative; flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px;
+  background: linear-gradient(135deg, #5C9BE8 0, var(--sea) 55%, var(--sea-deep) 100%); box-shadow: 0 6px 14px -8px rgba(29, 79, 150, .9); }
+.sd-shr-ic .pic { --pic: 30px; width: 30px; height: 30px; background: none; box-shadow: none; }
+.sd-shr-ic .pic img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 2px 3px rgba(10, 30, 70, .3)); }
+.sd-shr-ic .pic-tmp { color: #fff; background: none; box-shadow: none; }   /* until the 3D picture is made: the share glyph, white on the tile */
+.sd-shr-ic .pic-tmp::before { content: none; }
+.sd-shr-ic .pic-tmp .pic-g { width: 20px; height: 20px; stroke-width: 2; }
+.sd-shr-t { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
+.sd-shr-k { font-size: 15px; font-weight: 700; line-height: 1.25; letter-spacing: -.01em; color: var(--sea-deep); }
+.sd-shr-s { font-size: 12.5px; line-height: 1.3; color: var(--ink-3); }
+.sd-shr-a .sg-i { position: relative; }
+@media (prefers-reduced-motion: reduce) { .sd-shr-a { transition: none; } .sd-shr-a:hover { transform: none; } }
 .menu-panel .sd-shr { margin: 10px 0 0; }
 .menu-panel .sd-shr + .sd-pt { margin-top: 8px; }
 @media (min-width: 1200px) {
