diff --git a/templates/assets/css/48-abroad.css b/templates/assets/css/48-abroad.css
index e86591b3e1..a9d77f780e 100644
--- a/templates/assets/css/48-abroad.css
+++ b/templates/assets/css/48-abroad.css
@@ -231,4 +231,68 @@ html.embed-manual .ab-ph-msg { display: none; }
 .home-yt-sub .tn { color: var(--ink-3); font-weight: 400; margin-left: 4px; }
 .home-yt-sub a { font-size: 14px; font-weight: 600; color: var(--sea-deep); text-decoration: none; }
 .home-yt-sub a:hover { text-decoration: underline; }
+/* ---------------------------------------------------------------- 홈 우측 인기 유튜브·인스타 고정 큐레이션 보드 (.h-rside) */
+.h-rside { display: none; }
+@media (min-width: 1360px) {
+  :root { --rside-w: 304px; --rside-x: calc(var(--rside-w) + 2 * var(--side-in)); }
+  body.pg-ko-home { --cw: calc(100vw - var(--side-x) - var(--rside-x)); padding-right: var(--rside-x); }
+  html[lang="ko"] body.pg-ko-home main .wrap,
+  html[lang="ko"] body.pg-ko-home .foot .wrap,
+  html[lang="ko"] body.pg-ko-home .crumbs-bar .wrap { padding-right: var(--m); }
+  html[lang="ko"] body.pg-ko-home main .car-view { margin-right: 0; }
+  html[lang="ko"] body.pg-ko-home main .car-ans .car-view,
+  html[lang="ko"] body.pg-ko-home main .car-feat .car-view { padding-right: var(--ml); }
+  body.pg-ko-home .hn-in { max-width: none; }
+  body.pg-ko-home .qm { right: calc(var(--rside-x) + 12px); }
+  body.pg-ko-home .chat-fab { right: calc(var(--rside-x) + 8px); }
+  .h-rside {
+    position: fixed; z-index: 48; top: var(--side-in); bottom: var(--side-in); right: var(--side-in); width: var(--rside-w);
+    display: flex; flex-direction: column; gap: 16px; padding: 18px 16px 20px;
+    overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--hair) transparent;
+    background: #fff; border: 1px solid var(--hair); border-radius: var(--r-l); box-shadow: var(--shadow-1);
+  }
+}
+.hrs-head { display: flex; flex-direction: column; gap: 6px; padding-bottom: 12px; border-bottom: 1px solid var(--bg-3); }
+.hrs-kicker { margin: 0; font: 700 12px/1.3 var(--font); color: var(--sea-deep); letter-spacing: -.01em; }
+.hrs-title { margin: 0; font: 700 20px/1.25 var(--font); color: var(--ink); letter-spacing: -.03em; }
+.hrs-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 4px; }
+.hrs-tab { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 36px; padding: 0 10px;
+  border-radius: 10px; background: var(--bg-2); color: var(--ink); font: 700 13px/1 var(--font); text-decoration: none; }
+.hrs-tab:hover { background: var(--tint); color: var(--sea-deep); text-decoration: none; }
+.hrs-tab .ab-svc { width: 20px; height: 20px; }
+.hrs-tab .ab-svc svg { width: 12px; height: 12px; }
+.hrs-sec { display: flex; flex-direction: column; gap: 10px; }
+.hrs-sec + .hrs-sec { padding-top: 14px; border-top: 1px solid var(--bg-3); }
+.hrs-sh { display: flex; align-items: baseline; justify-content: space-between; gap: 6px; }
+.hrs-sh h3 { margin: 0; font: 700 15px/1.3 var(--font); color: var(--ink); letter-spacing: -.02em; }
+.hrs-sh .tn { color: var(--ink-3); font-weight: 400; }
+.hrs-sh a { font: 700 12.5px/1.3 var(--font); color: var(--sea-deep); text-decoration: none; white-space: nowrap; }
+.hrs-sh a:hover { text-decoration: underline; }
+.hrs-vlist, .hrs-clist { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
+.hrs-v { display: flex; flex-direction: column; gap: 6px; padding: 10px; border-radius: 14px; background: var(--g0); border: 1px solid var(--hair); }
+.hrs-va { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 10px; align-items: center; color: var(--ink); text-decoration: none; }
+.hrs-va:hover { text-decoration: none; }
+.hrs-va:hover .hrs-vt { color: var(--sea-deep); text-decoration: underline; }
+.hrs-vth { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 9px; overflow: hidden; background: var(--bg-3); }
+.hrs-vth img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.hrs-play { position: absolute; right: 5px; bottom: 5px; width: 22px; height: 22px; border-radius: 50%;
+  background: rgba(230, 33, 23, .92); color: #fff; display: grid; place-items: center; }
+.hrs-vtxt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
+.hrs-vt { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
+  font: 700 13px/1.35 var(--font); color: var(--ink); letter-spacing: -.015em; }
+.hrs-vm { font: 400 11.5px/1.3 var(--font); color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.hrs-vp, .hrs-clinks { display: flex; flex-wrap: wrap; gap: 4px; margin: 0; }
+.hrs-vp a, .hrs-clinks a { display: inline-flex; align-items: center; min-height: 24px; padding: 2px 8px;
+  border-radius: 999px; background: #fff; color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--hair);
+  font: 600 11.5px/1.2 var(--font); text-decoration: none; }
+.hrs-vp a:hover, .hrs-clinks a:hover { background: var(--tint); color: var(--sea-deep); text-decoration: none; }
+.hrs-c { display: flex; flex-direction: column; gap: 6px; padding: 9px 10px; border-radius: 13px; background: var(--bg-2); }
+.hrs-ctop { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.hrs-ctop .ab-svc { width: 24px; height: 24px; flex: none; }
+.hrs-ctop .ab-svc svg { width: 13px; height: 13px; }
+.hrs-cn { flex: 1; min-width: 0; display: flex; flex-direction: column; color: var(--ink); text-decoration: none; }
+.hrs-cn:hover b { color: var(--sea-deep); text-decoration: underline; }
+.hrs-cn b { font: 700 13.5px/1.25 var(--font); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.hrs-cn span { font: 400 11.5px/1.25 var(--font); color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.hrs-badge { flex: none; padding: 2px 7px; border-radius: 999px; background: var(--tint); color: var(--sea-deep); font: 700 11px/1.25 var(--font); }
 
