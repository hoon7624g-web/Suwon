diff --git a/templates/assets/css/47-rank.css b/templates/assets/css/47-rank.css
index c136130587..2a42481e4a 100644
--- a/templates/assets/css/47-rank.css
+++ b/templates/assets/css/47-rank.css
@@ -67,6 +67,15 @@
   .hrk-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 3vw, 44px); }
   .hrk-cols.hrk-one { grid-template-columns: minmax(0, 640px); }
 }
+/* the two lists side by side (below the board's 1680px): a row of one is as tall as the same row of the other — a
+   long channel name puts its count on a second line, and the rows after it and the buttons under the lists stood
+   18px apart (the independent check of the live site, 2026-11-10). The columns take their rows from the card: the
+   head, five rows, the buttons. */
+@media (min-width: 720px) and (max-width: 1679.98px) {
+  .hrk-cols:not(.hrk-one) { grid-template-rows: auto repeat(5, auto) auto; row-gap: 0; }
+  .hrk-cols:not(.hrk-one) > .hrk-col { display: grid; grid-template-rows: subgrid; grid-row: 1 / span 7; }
+  .hrk-cols:not(.hrk-one) .hrk-list { display: grid; grid-template-rows: subgrid; grid-row: 2 / span 5; }
+}
 @media (min-width: 1024px) {
   .hrk-a { grid-template-columns: 24px 112px minmax(0, 1fr); gap: 12px; }
   .hrk-n { font-size: 22px; }
