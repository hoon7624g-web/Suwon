 }
 
+/* ---- a phone's fixed areas stay within 15% of the screen together (CLAUDE.md 7): with the 52px bar at the top the
+   tab bar (64px) and a place page's bar (68px) made 15.7% and 16.2% of a 360×740 screen (the independent check of
+   the live site, 2026-11-10). The bottom bar takes what the top bar leaves of 15% — its full height from 780px of
+   screen, 59px at 740, 48px at 667 (a place page's buttons stay 44px, the tab bar 44px at the least). */
+@media (max-width: 767px) {
+  .tabbar { height: clamp(44px, calc(15svh - 52px), 64px); }
+  .pl-bar { --pl-t: clamp(48px, calc(15svh - 52px), 68px); --pl-p: clamp(2px, calc((var(--pl-t) - 52px) / 2), 8px); padding: var(--pl-p) 8px; }
+  .pl-bar a, .pl-bar .pl-bar-chat { height: calc(var(--pl-t) - 2 * var(--pl-p)); }
+}
+
 /* ---- a phone's /plan/: the form's own bar ('AI로 코스 만들기', sticky at the screen's foot — plan.css, z-index 5) lay
    behind the tab bar (80): the button could be pressed only at the form's end (there since 시안 A, 2026-11-05; found
    by the independent check of the live site, 2026-11-10). As on a place page, the page's own bar stands instead of
@@ -163,6 +180,20 @@
   html:not([lang="ko"]) .hk-h { display: flex; align-items: center; min-height: 38px; line-height: 1.22; white-space: normal; overflow: visible; text-wrap: balance; }
 }
 
+/* ---- 다가오는 행사 where three tickets across would be under 300px each — by the row's own room (.evband's .wrap,
+   a container): 1024–1099px, 1200–1439px (the column is the window less the panel) and 1680–1771px (less the board
