@@ -0,0 +1,282 @@
+/* 90-refine — the calm pass (operator 2026-11-10: '사이트가 전체적으로 더 고급지고 정돈된 느낌 … 정보가 직관적으로 잘
+   들어오고, 정보들 간의 연결성도 좋게', after the review of the same day). The last partial: it does not add a look, it
+   takes weight off the ones before it. The rules are this pass's own, drawn from that review — where they change an
+   earlier operator decision (the launcher's size from 1200px, the panel's day card on a short window, the quick menu
+   from 1200px, the home's order) the handover log says so, for the operator to confirm. The rules it keeps:
+
+   1. One accent per screen. Sea blue is the accent; chick yellow is the one booking button; red is a closed day.
+      A value is the loudest thing in its tile — its picture and its label step back.
+   2. Bold is for names, headings and the value a visitor decides with. Running text, labels, captions and chips are 400.
+   3. The 3D pictures are doors (the home's four lists, a row or page without a photo), not ornaments of a fact.
+   4. Nothing floats over content: the launcher and 'top' live in the page's margin (from 1200px the margins are equal),
+      on a phone place page the assistant is a button of the bottom bar.
+   5. A section's heading says the section; the place's name in it is the quiet part.
+   6. Chrome gives way to navigation: on a short window the panel's day card folds so the menu's first group shows.
+
+   Contrast kept (00-tokens head): ink-2 on white 9.36, ink-3 on white 5.62 / bg-2 5.2, sea-deep on tint 7.13.
+   Targets: 44px (the panel's rows too: tests/test_sidebar_layout.py). */
+
+/* ================================================================ 1. the chrome */
+
+/* ---- from 1200px: equal margins, the launcher and 'top' inside the right one, no quick menu (the panel has the
+   search and every list). 1200–1771px: until the column is wider than the content's 1200px the page kept a 124px
+   gutter at the right only (46-quick) — the content sat off-centre and the home's own rules took the gutter back,
+   so the menu lay over its cards. */
+@media (min-width: 1200px) {
+  /* the launcher's size: every version (the other versions keep their own margins; a 68px button covers less of
+     them). 49-chat (operator 2026-10-31 '더 잘 보이게 키워') set 100px from 1024px — it stays 100px up to 1199px, where
+     the page keeps a 124px gutter for it (46-quick); from 1200px it is the size that fits the page's 88px margin. It
+     keeps its sea ring, its 'AI 챗봇' tag and the halo after load. */
+  .chat-fab { right: 10px; bottom: 28px; width: 68px; height: 68px; box-shadow: 0 8px 22px rgba(18, 32, 56, .18), 0 2px 5px rgba(18, 32, 56, .1), inset 0 0 0 2px var(--sea); }
+  .chat-fab-face { width: 68px; height: 68px; }
+  .chat-fab-face img { width: 54px; height: 54px; }
+  .chat-fab-l { bottom: -10px; padding: 4px 9px; font-size: 12.5px; }
+  html.js .foot { padding-bottom: calc(112px + env(safe-area-inset-bottom, 0px)); }
+  html[lang="ko"] .qm { right: 22px; bottom: 118px; padding: 0; border-radius: 50%; box-shadow: var(--shadow-1); }
+  html[lang="ko"] .qm li:not(:last-child) { display: none; }
+  html[lang="ko"] .qm-i { width: 44px; height: 44px; }
+}
+@media (min-width: 1200px) and (max-width: 1771px) {
+  html[lang="ko"] { --m: 88px; }
+  html[lang="ko"] main .wrap, html[lang="ko"] .foot .wrap, html[lang="ko"] .crumbs-bar .wrap { padding-right: var(--m); }
+  html[lang="ko"] main .car-view { margin-right: var(--m); }
+  /* the home's rows (81-home-mz kept the 124px gutter on them): the guide tiles' grid ends at the margin as its
+     heading does; the place cards' sideways row ends there too, clear of the launcher */
+  html[lang="ko"] main .car-mzt .car-view { margin-right: 0; padding-right: var(--ml); }
+  html[lang="ko"] main .car-fp .car-view { margin-right: var(--m); padding-right: 0; }
+  html[lang="ko"] main .gd-toc { padding-right: var(--m); }   /* the contents row ends clear of the launcher */
+  html[lang="ko"] .story.is-staged .st-grid { grid-template-columns: var(--ml) minmax(0, calc((min(var(--cw), var(--maxw) + 2 * var(--m)) - 2 * var(--m)) * .4)) clamp(32px, 4vw, 72px) minmax(0, 1fr) var(--ml); }
+}
+@media (min-width: 1200px) and (max-width: 1279px) {
+  /* /sun/: with the wider margin the arc's box met the sunset figure (the column is 880–959px here) */
+  html[lang="ko"] .sun-arc { display: none; }
+}
+@media (min-width: 1680px) and (max-width: 1771px) {
+  html[lang="ko"] body.pg-ko-home main .car-mzt .car-view { padding-right: var(--ml); }
+}
+/* the home with its right board (from 1680px, 48-abroad): the board ends above the launcher, which docks under it —
+   nothing lies over the column, so the column keeps its own margins */
+@media (min-width: 1680px) {
+  html[lang="ko"] body.pg-ko-home { --m: clamp(24px, calc(var(--cw) * .046), 64px); --ml: max(var(--m), calc((var(--cw) - var(--maxw)) / 2)); }
+  .h-rside { bottom: 112px; }
+  html[lang="ko"] body.pg-ko-home .chat-fab { right: calc(var(--side-in) + 6px); bottom: 26px; }
+  html[lang="ko"] body.pg-ko-home .qm { right: calc(var(--side-in) + 88px); bottom: 38px; }
+}
+
+/* ---- the panel (from 1200px): on a short window the day card folds so that the menu's first group is on screen
+   above the '문의/제휴' row (measured 2026-11-10: the menu began 757px down — on a 768–900px window no link of it
+   showed; with the card whole at 900px one link did). Under 1020px of height the weather card is its sky and bubble
+   without the four cells (170px) and the sunrise · sunset row one line under its date; under 880px (a laptop's
+   window) the card is one row — the sun or moon with its score, the bubble beside it — and the next event steps out
+   (it is on the home and in 행사 달력). From 1020px the card is 날씨각's drawn size (246 · 220px). The card keeps the
+   room of its size from the first paint at every height (tests/test_sidebar_layout.py); every row stays 44px or more. */
+@media (min-width: 1200px) {
+  .side .sg-s { min-height: 46px; font-size: 16.5px; }
+  .side .sg-a { font-size: 15px; }
+  .side .sg-l { padding-bottom: 8px; }
+}
+@media (min-width: 1200px) and (max-height: 1019px) {
+  html.js .wx-side, html.js .wx-side.wx-intl { height: 170px; }
+  .wx-side .wx-strip { display: none; }
+  html.js .wx-side:not(.is-ready):not(.is-failed) .wx-b:empty::after { display: none; }
+  .side .sd-sun { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; padding: 9px 34px 10px 14px; }
+  .side .sd-sun .sd-k { flex-basis: 100%; }
+  .side .sd-sun .sd-sv { flex-direction: row; align-items: baseline; gap: 5px; padding: 0; border-radius: 0; background: none; box-shadow: none; font-size: 12.5px; }
+  .side .sd-sun .sd-sv b { font-size: 15px; line-height: 1.3; }
+  .side .sd-sun .sd-go { top: 50%; margin-top: -4px; }
+}
+@media (min-width: 1200px) and (max-height: 879px) {
+  html.js .wx-side, html.js .wx-side.wx-intl { height: 98px; }
+  html.js .wx-side .wx-b { flex-direction: row; align-items: center; justify-content: flex-start; gap: 10px; }
+  .wx-side .wx-sky { flex: none; width: 48px; max-width: 48px; height: 48px; margin: 0; font-size: 6px; }
+  .wx-side .wx-ob { top: 0; }
+  .wx-side .wx-cl, .wx-side .wx-sc small { display: none; }
+  .wx-side .wx-say { flex: 1 1 auto; width: auto; max-width: none; margin: 0; text-align: left; }
+  html.js .wx-side:not(.is-ready):not(.is-failed) .wx-b:empty::before { top: 40px; left: 12px; width: 48px; height: 48px; margin-left: 0; }
+  /* no answer: the link under the card's name, not over it (the room is 98px) */
+  html.js .wx-side.is-failed .wx-go { top: 64%; }
+  .side .sd-ev { display: none; }
+}
+
+/* ---- a phone's place page: the assistant is a button of the bottom bar (the launcher covered the phone tile and
+   the photo credit), and the route link the bar holds is not repeated above it */
+.pl-bar-chat { display: none; }
+@media (max-width: 767px) {
+  .pl-bar-chat { flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; width: 58px; height: 52px; padding: 0; border: 0; border-radius: 18px; background: var(--bg-2); color: var(--ink); font: 700 11px/1 var(--font); cursor: pointer; }
+  .pl-bar-chat .icon { width: 20px; height: 20px; }
+  html:not(.js) .pl-bar-chat { display: none; }
+  .pl-bar .pl-bar-tel { width: 92px; }
+  body:has(.pl-bar) .chat-fab { display: none; }
+  body:has(.pl-bar-go) .lnav .lnav-cta { display: none; }
+  body:has(.pl-bar-go) .pl-hero .route-row .btn-go { display: none; }
+  body:has(.pl-bar-go) .pl-hero .route-row { grid-template-columns: 1fr 1fr; padding-right: 0; }
+}
+
+/* ================================================================ 2. the home */
+
+/* ---- the icon menu under the assistant: the four lists the opening already offers as tiles step out (the same doors
+   twice on one screen); the others are quiet chips in one wrapping row at every width */
+.pg-ko-home .hq-row > li:has(> .hq-i[href="/places/"]), .pg-ko-home .hq-row > li:has(> .hq-i[href="/food/"]),
+.pg-ko-home .hq-row > li:has(> .hq-i[href="/stays/"]), .pg-ko-home .hq-row > li:has(> .hq-i[href="/courses/"]) { display: none; }
+.pg-ko-home .hq-row.hq-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; padding-right: 0; }
+.pg-ko-home .hq-row.hq-row > li { flex: 0 0 auto; display: flex; }
+.pg-ko-home .hq-row .hq-i { flex-direction: row; align-items: center; justify-content: center; width: auto; min-height: 44px; gap: 7px; padding: 0 16px 0 10px; border-radius: 999px; background: var(--bg-2); }
+.pg-ko-home .hq-row .hq-i:hover { background: var(--tint); }
+.pg-ko-home .hq-row .pic { width: 26px; height: 26px; }
+.pg-ko-home .hq-row .hq-i:hover .pic { transform: none; }
+.pg-ko-home .hq-row .hq-l { font: 400 14px/1.2 var(--font); letter-spacing: -.01em; }
+.pg-ko-home .hq-row .hq-n { display: none; }
