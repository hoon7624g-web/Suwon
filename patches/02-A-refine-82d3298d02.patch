+html:is([lang="ja"], [lang="zh-Hans"], [lang="zh-Hant"]) :is(.guide .d1-q, .guide .gd-ans-l, .guide .gd-ans-r, .gd-sec .h-sec, .gd-pts li, .gd-sec .gd-p) { word-break: normal; }
