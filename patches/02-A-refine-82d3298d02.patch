+  .gd-grid.has-toc:not(.has-map) .gd-body { grid-column: 1 / span 9; }
+}
+@media (max-width: 1279px) {
+  .pg-guide .gd-toc-l li { width: auto; max-width: min(280px, 72vw); }
+}
+
+/* ---- a guide's section (templates/guide.html.j2, present.section_reading): a short heading, the answer sentence as
+   the lead, two sentences, the rest behind '자세히'. Type steps down once at each level — heading 700, lead ink 400,
+   sentences ink-2 400; the only bold in a sentence is a value a visitor decides with (a time, a price, a day). */
+.gd-sec .gd-h { max-width: 24em; font-size: clamp(21px, 1.9vw, 26px); line-height: 1.32; letter-spacing: -.028em; }
+.gd-h2l .gd-h-sub { display: block; max-width: 34em; margin-top: 10px; font: 400 17.5px/1.62 var(--font); color: var(--ink); letter-spacing: -.012em; word-break: keep-all; text-wrap: pretty; }
+.gd-lead { max-width: 34em; margin-top: 10px; font: 400 17.5px/1.62 var(--font); color: var(--ink); letter-spacing: -.012em; word-break: keep-all; text-wrap: pretty; }
+.gd-lead + .gd-pts, .gd-lead + .gd-p, .gd-h + .gd-pts, .gd-h + .gd-p { margin-top: 16px; }
+.pg-guide .gd-pts { gap: 9px; }
+.pg-guide .gd-pts li, .pg-guide .gd-sec .gd-p { max-width: 36em; font-size: 16px; line-height: 1.68; }
+.pg-guide .gd-pts li::before { top: .74em; width: 5px; height: 5px; background: var(--field); }
+.pg-guide .gd-sec .gk[data-k] { font-weight: 400; color: inherit; }
+/* a place named in a sentence: ink like the sentence, under a sea line (4.96:1 on white — the line is the link's cue) */
+.pg-guide .gd-sec .gl { color: var(--ink); text-decoration-color: var(--sea); }
+.pg-guide .gd-sec .gl:hover { color: var(--link); text-decoration-color: currentColor; }
+.gd-more, .fold { margin-top: 14px; }
+.gd-more > summary, .fold > summary { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px 0 16px; border: 1px solid var(--hair); border-radius: 999px; background: #fff; color: var(--ink-3); font: 400 14px/1 var(--font); letter-spacing: -.01em; cursor: pointer; list-style: none; transition: background-color .2s var(--fb); }
+.gd-more > summary::-webkit-details-marker, .fold > summary::-webkit-details-marker { display: none; }
+.gd-more > summary::marker, .fold > summary::marker { content: ""; }
+.gd-more > summary:hover, .fold > summary:hover { background: var(--bg-2); }
+.gd-more > summary:focus-visible, .fold > summary:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
+.gd-more-t { font-weight: 700; color: var(--ink); }
+.gd-more-i { width: 7px; height: 7px; margin: -4px 2px 0 2px; border: solid var(--ink-3); border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); transition: transform .2s var(--fb); }
+.gd-more[open] > summary, .fold[open] > summary { margin-bottom: 16px; }
+.gd-more[open] .gd-more-i { margin-top: 3px; transform: rotate(-135deg); }
+@media (prefers-reduced-motion: reduce) { .gd-more > summary, .fold > summary, .gd-more-i { transition: none; } }
+@media (max-width: 767px) {
+  .gd-lead, .gd-h2l .gd-h-sub { font-size: 17px; line-height: 1.6; }
+  .pg-guide .gd-pts li, .pg-guide .gd-sec .gd-p { font-size: 15.5px; }
+}
+@media print {
+  .gd-more::details-content, .fold::details-content { content-visibility: visible; }
+}
+
+/* the generic fold ('더 보기': a place's further SNS cards): the same pill, its chevron drawn on the summary */
+.fold > summary { color: var(--ink); font-weight: 700; }
+.fold > summary .tn { font-weight: 400; color: var(--ink-3); }
+.fold > summary::after { content: ""; width: 7px; height: 7px; margin: -4px 2px 0 4px; border: solid var(--ink-3); border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); }
+.fold[open] > summary::after { margin-top: 3px; transform: rotate(-135deg); }
+
+/* ================================================================ 4. the place page */
+
+/* a section's heading says the section; the place's name in it is the quiet part (it was the dark part: twelve
+   headings on a page read '초원사진관 … 초원사진관 …'). A Korean chapter's label carries the name as a small line over
+   it (in the other versions a separator or a particle follows the name: the label stays one line there). */
+.rail-label:has(.nm), .h-sec:has(.nm), .h-side:has(.nm) { color: var(--ink); }
+.rail-label .nm, .h-sec .nm, .h-side .nm { color: var(--ink-3); font-weight: 400; }
+html[lang="ko"] .rail-label .nm { display: block; margin-bottom: 6px; font-size: 14px; line-height: 1.3; letter-spacing: -.01em; }
+html[lang="ko"] .pl-src .rail-label .nm { display: inline; margin: 0; font-size: inherit; font-weight: 700; }
+.pv-map .pv-map-h .nm { color: var(--ink-3); font-weight: 400; }
+.pv-map .pv-map-h { color: var(--ink); }
+
+/* the key facts: the value is the tile — its 3D picture steps out (the pictures stay where they are a door: the
+   home's lists, a row or a page without a photo) */
+.kf-hero dt .pic { display: none; }
+.kf-hero dt { font-size: 13px; letter-spacing: -.005em; }
+
+/* ================================================================ 5. 이어서 보기 (ui.seealso, present.see_also)
+   the pages that share places with this one — an index, set as one: a hairline list under a rule, no cards */
+.see-h { margin-bottom: 6px; }
+.see-rule { max-width: 40em; margin: 0 0 22px; font-size: 14px; line-height: 1.55; color: var(--ink-3); }
+.see-g { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 24px 32px; align-items: start; }
+.see-k { margin: 0; padding-bottom: 9px; border-bottom: 1px solid var(--ink); font: 700 13px/1.3 var(--font); letter-spacing: .02em; color: var(--ink); }
+.see-l { margin: 0; padding: 0; list-style: none; }
+.see-l li { border-bottom: 1px solid var(--bg-3); }
+.see-a { display: flex; flex-direction: column; gap: 3px; min-height: 44px; padding: 13px 2px 14px; color: var(--ink); text-decoration: none; }
+.see-a:hover { text-decoration: none; }
+.see-a:hover .see-t { color: var(--sea-deep); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
+.see-a:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 6px; }
+.see-lab { font: 400 12.5px/1.3 var(--font); color: var(--sea-deep); }
+.see-t { font: 700 16px/1.42 var(--font); letter-spacing: -.02em; word-break: keep-all; text-wrap: pretty; }
+.see-m { font: 400 13px/1.45 var(--font); color: var(--ink-3); word-break: keep-all; }
+
+/* ================================================================ 6. the lists */
+
+/* a row's missing values once, in one line, where the cells are chips (phones): three chips said '확인 필요' one
+   after another (templates/_p1.html.j2 rec; CLAUDE.md 3.1). Only where the row carries that line (the Korean lists)
+   and only a cell that holds nothing else (a cell with a second value — '확인 필요 · 좌석 30석' — stays). Wider, the
+   columns keep their cells. The line's words are its data-need, drawn here: in the HTML the notice stays in the
+   cells only, not once more. */
+.rec-need { display: none; }
+@media (max-width: 767px) {
+  .ledger .rec:has(> .rec-need) .rec-cells > div:has(> dd > .kf-na:only-child) { display: none !important; }
+  .rec-need { display: block; margin: 9px 0 0; font: 400 12.5px/1.45 var(--font); color: var(--ink-3); letter-spacing: -.005em; }
+  .rec-need::before { content: attr(data-need); }
+}
+.yt-ch-note { margin-top: 14px; }
+/* the home's link beside a sub-heading ('인기 채널 n곳 보기'): a 44px target where fingers are */
+@media (max-width: 1023px) {
+  .home-yt-sub a { display: inline-flex; align-items: center; min-height: 44px; }
+}
+
+/* ================================================================ 7. runs that were wider than a phone (found by a
+   390px sweep of every page, 2026-11-10): an event's '시간' value kept on one line in its tile; a past edition's
+   source line kept on one line */
+@media (max-width: 767px) {
+  .kf-hero .kf-main > .nw { white-space: normal; }
+}
+.usual .u-s { white-space: normal; overflow-wrap: anywhere; }
+
+/* ================================================================ 8. words on a KOGL-1 photo (81-home-mz)
+   the outline that keeps them readable without darkening the photo stays, thinner: the big letters 2px (2.5), the
+   small ones 1px (1.5); a photo's credit is small print at the text's own weight, not a second headline */
+.mzt-photo .mzt-n, .fp-cap, .blz-ph .bl-t a {
+  text-shadow: -1px -1px 0 var(--ink), 1px -1px 0 var(--ink), -1px 1px 0 var(--ink), 1px 1px 0 var(--ink),
+    0 -1px 0 var(--ink), 0 1px 0 var(--ink), -1px 0 0 var(--ink), 1px 0 0 var(--ink), 0 2px 8px rgba(23, 32, 51, .4);
+}
+.mzt-photo .mzt-n b, .fp-cap .fp-t, .blz-ph .bl-t a {
+  text-shadow: -2px -2px 0 var(--ink), 2px -2px 0 var(--ink), -2px 2px 0 var(--ink), 2px 2px 0 var(--ink),
+    0 -2px 0 var(--ink), 0 2px 0 var(--ink), -2px 0 0 var(--ink), 2px 0 0 var(--ink), 0 3px 10px rgba(23, 32, 51, .35);
+}
+.mzt-photo .mzt-cr, .fp-cr, .hsns-v.t1 .hsns-cr {
+  font-weight: 400; letter-spacing: 0;
+  text-shadow: -1px -1px 0 var(--ink), 1px -1px 0 var(--ink), -1px 1px 0 var(--ink), 1px 1px 0 var(--ink),
+    0 -1px 0 var(--ink), 0 1px 0 var(--ink), -1px 0 0 var(--ink), 1px 0 0 var(--ink);
+}
+
+/* ================================================================ 9. Japanese and Chinese guides on a phone
+   85-guide-calm (2026-11-04) set keep-all on a guide's title, answer, headings and sentences for every version. In
+   Japanese and Chinese — no spaces — a sentence then never wrapped: its row was wider than the phone and the page
